---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";

const stats = [
  { icon: "fas fa-users", num: "50,000+", label: "Patients Served" },
  { icon: "fas fa-scissors", num: "12,000+", label: "Corrective Surgeries" },
  {
    icon: "fas fa-wheelchair",
    num: "8,500+",
    label: "Assistive Devices Given",
  },
  {
    icon: "fas fa-map-location-dot",
    num: "300+",
    label: "Community Outreaches",
  },
  {
    icon: "fas fa-graduation-cap",
    num: "5,000+",
    label: "Vocational Graduates",
  },
  { icon: "fas fa-calendar-check", num: "60+", label: "Years of Service" },
];

const heroSlides = [
  {
    src: "/images/hero/hero-nyabondo-staff-1.webp",
    alt: "Nyabondo staff members with visitors from CBM.",
  },
  {
    src: "/images/hero/hero-nyabondo-staff.webp",
    alt: "Nyabondo staff after a morning prayer assembly.",
  },
  {
    src: "/images/hero/hero-post-op.webp",
    alt: "A child taking some time out after surgery.",
  },
  {
    src: "/images/hero/hero-surgery-child.webp",
    alt: "A child receiving post-surgery treatment at Nyabondo Centre",
  },
  {
    src: "/images/hero/hero-administrator.webp",
    alt: "Nyabondo Centre administrator receiving visitors.",
  },
  {
    src: "/images/hero/hero-rehabilitation-therapy.webp",
    alt: "A therapist guiding a patient through rehabilitation at Nyabondo Centre",
  },
  {
    src: "/images/hero/hero-assistive-device.webp",
    alt: "A senior orthopaedic technologist helping a patient to fit assistive device at Nyabondo Rehab Centre.",
  },
  {
    src: "/images/hero/hero-corrective-surgery.webp",
    alt: "Surgeons performing a corrective orthopaedic procedure at Nyabondo",
  },
  {
    src: "/images/hero/hero-community-outreach.webp",
    alt: "Staff engaging community members during a community outreach",
  },
];

const services = [
  {
    icon: "fas fa-hospital",
    num: "01",
    title: "Out/Inpatient Services",
    desc: "Clinical consultations, post-operative care, follow-up reviews, and residential care for patients requiring surgery or intensive rehabilitation. Our SHA-accredited facility also serves the wider community with general medical services, open to all regardless of disability status.",
    href: "/services/outpatient-inpatient",
    img: "/images/services/service-inpatient-care.webp",
    alt: "A patient receiving inpatient care at Nyabondo Centre",
    badge: "SHA Accredited",
  },
  {
    icon: "fas fa-stethoscope",
    num: "02",
    title: "Corrective Surgeries",
    desc: "Skilled orthopaedic and reconstructive procedures including club foot correction, cleft lip and palate repair, post-burn contracture release, congenital impairments, and fractures, restoring mobility and quality of life.",
    href: "/services/surgeries",
    img: "/images/services/service-corrective-surgery.webp",
    alt: "Surgeons performing a corrective orthopaedic procedure",
    badge: null,
  },
  {
    icon: "fas fa-hand-holding-heart",
    num: "03",
    title: "Therapy Services",
    desc: "Individualised physiotherapy and occupational therapy programmes for children and adults, focused on restoring movement, strength, and functional independence across all stages of recovery.",
    href: "/services/therapy",
    img: "/images/services/service-therapy.webp",
    alt: "A physiotherapist working with a child during a therapy session",
    badge: null,
  },
  {
    icon: "fas fa-wheelchair",
    num: "04",
    title: "Assistive Tech Devices",
    desc: "Custom-made prosthetics, orthotics, walking aids, and mobility equipment crafted using appropriate technology. Functional, affordable, and tailored to every individual's unique needs.",
    href: "/services/assistive-devices",
    img: "/images/services/service-assistive-devices.webp",
    alt: "A technician fitting a custom prosthetic limb",
    badge: null,
  },
];

const programs = [
  {
    icon: "fas fa-seedling",
    title: "Livelihood and Economic Empowerment",
    desc: "Vocational skills training for youths with disabilities, entrepreneurship development, income-generating activities, and capacity building for organizations of persons with disabilities.",
    href: "/programs/livelihood",
  },
  {
    icon: "fas fa-people-group",
    title: "Community Based Inclusive Development",
    desc: "Early identification and intervention, disability assessment and registration with NCPWD, EARC referrals, and collaboration with county governments to strengthen community-level support systems.",
    href: "/programs/cbid",
  },
  {
    icon: "fas fa-clock-rotate-left",
    title: "Long-term Rehabilitation",
    desc: "Specialised, programme-based therapy for children with cerebral palsy and complex care needs, providing consistent, structured support for measurable progress over time within the institution.",
    href: "/programs/longterm-rehab",
  },
  {
    icon: "fas fa-hands-holding-circle",
    title: "Social Inclusion and Participation",
    desc: "Community awareness and sensitization on disability inclusion, formation of disability support groups, promotion of participation in community activities, and disability rights advocacy.",
    href: "/programs/social-inclusion",
  },
];

const partners = [
  {
    name: "Christian Blind Mission",
    logo: "/images/partners/cbm-global.webp",
    url: "https://www.cbm.org",
  },
  {
    name: "Cheshire Disability Services Kenya",
    logo: "/images/partners/cheshire-disability-services-kenya.webp",
    url: "https://www.cheshire.or.ke",
  },
  {
    name: "Ministry of Health",
    logo: "/images/partners/ministry-of-health-kenya.webp",
    url: "https://www.health.go.ke",
  },
  {
    name: "National Fund for the Disabled Kenya",
    logo: "/images/partners/national-fund-disabled-kenya.webp",
    url: "https://www.nfdk.go.ke",
  },
  {
    name: "National Council for Persons with Disabilities",
    logo: "/images/partners/national-council-persons-disabilities.webp",
    url: "https://www.ncpwd.go.ke",
  },
  {
    name: "Kenya Conference of Catholic Bishops",
    logo: "/images/partners/kenya-conference-catholic-bishops.webp",
    url: "https://kccb.or.ke",
  },
  {
    name: "Archdiocese of Kisumu",
    logo: "/images/partners/archdiocese-of-kisumu.webp",
    url: "https://www.archdioceseofkisumu.org",
  },
  {
    name: "Association of Sisterhoods of Kenya",
    logo: "/images/partners/association-of-sisterhoods-kenya.webp",
    url: "https://www.ask.or.ke",
  },
  {
    name: "Motivation Charitable Trust",
    logo: "/images/partners/motivation-charitable-trust.webp",
    url: "https://www.motivation.org.uk",
  },
  {
    name: "Stichting Bondo Kids",
    logo: "/images/partners/stichting-bondo-kids.webp",
    url: "#",
  },
];
---

<Layout
  title="Nyabondo Centre for Persons with Disabilities - Rising above Disability"
>
  <!-- ═══════════════════════════════════
       HERO
  ═══════════════════════════════════ -->
  <section class="hero" id="hero" aria-label="Welcome to Nyabondo Centre">
    <div class="hero-track" id="heroTrack">
      {
        heroSlides.map((slide, i) => (
          <div class="hero-slide">
            <picture>
              <source srcset={slide.src} type="image/webp" />
              <img
                src={slide.src}
                alt={slide.alt}
                loading={i === 0 ? "eager" : "lazy"}
                fetchpriority={i === 0 ? "high" : "auto"}
                decoding={i === 0 ? "sync" : "async"}
                width="1920"
                height="1080"
              />
            </picture>
            <div class="hero-slide-overlay" aria-hidden="true" />
          </div>
        ))
      }
    </div>

    <div class="hero-grain" aria-hidden="true"></div>

    <div class="hero-content">
      <div class="hero-badge">
        <span class="hero-badge-dot" aria-hidden="true"></span>
        Serving Kenya since 1963
      </div>

      <h1 class="hero-title">
        Rising above
        <span class="hero-accent-wrap">
          <em class="hero-accent">Disability</em>
          <svg
            class="hero-accent-underline"
            viewBox="0 0 260 12"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M2 9C60 3 120 1 258 6"
              stroke="currentColor"
              stroke-width="3.5"
              stroke-linecap="round"></path>
          </svg>
        </span>
      </h1>

      <p class="hero-subtitle">
        Providing quality rehabilitation, corrective surgery, therapy, and
        assistive technology to persons with disabilities across Kenya. Our
        SHA-accredited facility also offers general medical services to all
        community members, with or without disability.
      </p>

      <div class="hero-service-tags" aria-label="Service highlights">
        <span class="hero-tag"
          ><i class="fas fa-shield-halved" aria-hidden="true"></i> SHA Accredited</span
        >
        <span class="hero-tag"
          ><i class="fas fa-wheelchair" aria-hidden="true"></i> Disability Rehabilitation</span
        >
        <span class="hero-tag"
          ><i class="fas fa-stethoscope" aria-hidden="true"></i> General Medical
          Services</span
        >
        <span class="hero-tag"
          ><i class="fas fa-users" aria-hidden="true"></i> Open to All</span
        >
      </div>

      <div class="hero-actions">
        <a href="/get-involved/donate" class="btn btn-green">
          <i class="fas fa-heart" aria-hidden="true"></i>
          Support Our Mission
        </a>
        <a href="/services" class="btn btn-white-outline">
          <i class="fas fa-arrow-right" aria-hidden="true"></i>
          Our Services
        </a>
      </div>

      <div class="hero-stats" role="list">
        <div class="hero-stat" role="listitem">
          <span class="hero-stat-num">60+</span>
          <span class="hero-stat-label">Years of Service</span>
        </div>
        <div class="hero-stat-divider" aria-hidden="true"></div>
        <div class="hero-stat" role="listitem">
          <span class="hero-stat-num">50K+</span>
          <span class="hero-stat-label">Lives Touched</span>
        </div>
        <div class="hero-stat-divider" aria-hidden="true"></div>
        <div class="hero-stat" role="listitem">
          <span class="hero-stat-num">300+</span>
          <span class="hero-stat-label">Outreaches Done</span>
        </div>
      </div>
    </div>

    <div class="hero-slide-counter" aria-hidden="true">
      <span class="hero-slide-current" id="heroSlideNum">01</span>
      <span class="hero-slide-sep"></span>
      <span class="hero-slide-total"
        >{String(heroSlides.length).padStart(2, "00")}</span
      >
    </div>

    <button
      class="hero-arrow hero-arrow--prev"
      id="heroPrev"
      aria-label="Previous slide"
    >
      <i class="fas fa-chevron-left" aria-hidden="true"></i>
    </button>
    <button
      class="hero-arrow hero-arrow--next"
      id="heroNext"
      aria-label="Next slide"
    >
      <i class="fas fa-chevron-right" aria-hidden="true"></i>
    </button>

    <div class="hero-dots" role="tablist" aria-label="Slide indicators">
      {
        heroSlides.map((_, i) => (
          <button
            class={`hero-dot${i === 0 ? " is-active" : ""}`}
            data-index={i}
            role="tab"
            aria-selected={i === 0}
            aria-label={`Slide ${i + 1}`}
          />
        ))
      }
    </div>

    <div class="hero-progress" aria-hidden="true">
      <div class="hero-progress-bar" id="heroProgressBar"></div>
    </div>

    <div class="hero-scroll-cue" aria-hidden="true">
      <span class="hero-scroll-label">Scroll</span>
      <div class="hero-scroll-line">
        <div class="hero-scroll-line-inner"></div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════
       ABOUT
  ═══════════════════════ -->
  <section class="about-intro" id="about" aria-labelledby="about-heading">
    <div class="container">
      <div class="about-grid">
        <div class="about-left reveal-left">
          <div class="about-header-block">
            <span class="section-eyebrow">About Nyabondo Centre</span>
            <h2 id="about-heading" class="section-title about-title">
              Six Decades of Healing, Hope and Human Dignity
            </h2>
          </div>
          <div class="about-image-wrap">
            <picture>
              <source
                srcset="/images/about/about-nyabondo-centre.webp"
                type="image/webp"
              />
              <img
                src="/images/about/about-nyabondo-centre.webp"
                alt="A dedicated therapist guides a patient through rehabilitation exercises at Nyabondo Centre"
                loading="lazy"
                decoding="async"
                width="800"
                height="600"
              />
            </picture>
            <div class="about-image-badge" aria-hidden="true">
              <span class="about-image-badge-num">1963</span>
              <span class="about-image-badge-label">Year Founded</span>
            </div>
            <div class="about-image-frame" aria-hidden="true"></div>
          </div>
        </div>

        <div class="about-text reveal-right">
          <p class="about-lead">
            Nyabondo Centre for Persons with Disabilities was founded in 1963 by
            Rev. Father John Kutner, a Mill Hill Priest who found children with
            disabilities crawling and hopeless during his pastoral work. What
            began as the John F. Kennedy Memorial Home for 35 children has grown
            into one of Kenya's foremost centres of comprehensive
            rehabilitation.
          </p>
          <p class="about-body">
            Located in Kisumu County, Nyabondo offers a continuum of care
            spanning community outreach and early identification, corrective
            surgery, physiotherapy, assistive devices, and vocational training
            that enables beneficiaries to live with independence and purpose.
            Our SHA-accredited facility also serves the broader community with
            general medical services, open to all regardless of disability
            status. Rooted in integrity, spirituality, and respect for every
            human person, we hold the conviction that disability is not
            inability and that every person deserves the opportunity to thrive.
          </p>
          <div class="about-values-row">
            <div class="about-value">
              <span class="about-value-icon"
                ><i class="fas fa-shield-heart" aria-hidden="true"></i></span
              >
              <span>Integrity</span>
            </div>
            <div class="about-value">
              <span class="about-value-icon"
                ><i class="fas fa-hands-praying" aria-hidden="true"></i></span
              >
              <span>Spirituality</span>
            </div>
            <div class="about-value">
              <span class="about-value-icon"
                ><i class="fas fa-star" aria-hidden="true"></i></span
              >
              <span>Excellence</span>
            </div>
            <div class="about-value">
              <span class="about-value-icon"
                ><i class="fas fa-people-group" aria-hidden="true"></i></span
              >
              <span>Inclusivity</span>
            </div>
          </div>
          <a href="/about/our-story" class="btn btn-primary-outline">
            Discover Our Full Story <i
              class="fas fa-arrow-right"
              aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       IMPACT NUMBERS
  ═══════════════════════════════════════════════ -->
  <section class="impact" aria-labelledby="impact-heading">
    <div class="impact-inner">
      <h2 id="impact-heading" class="sr-only">Our Impact in Numbers</h2>
      {
        stats.map((s, i) => (
          <div class="impact-item" style={`--delay: ${i * 80}ms`}>
            <div class="impact-icon" aria-hidden="true">
              <i class={s.icon} />
            </div>
            <div class="impact-text">
              <span class="impact-num" data-target={s.num}>
                {s.num}
              </span>
              <span class="impact-label">{s.label}</span>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ═══════════════════════
       SERVICES
  ═══════════════════════ -->
  <section class="services" aria-labelledby="services-heading">
    <div class="container">
      <div class="section-header reveal-up">
        <span class="section-eyebrow">Our Services</span>
        <h2 id="services-heading" class="section-title">
          Comprehensive Medical and Rehabilitation Services
        </h2>
        <p class="section-subtitle">
          A holistic continuum of care for persons with disabilities and for all
          community members. Our SHA-accredited facility provides specialist
          rehabilitation alongside general medical services, open to everyone.
        </p>
      </div>

      <div class="services-grid">
        {
          services.map((svc, i) => (
            <article
              class="service-card reveal-up"
              style={`--delay: ${i * 80}ms`}
            >
              <div class="service-card-img">
                <picture>
                  <source srcset={svc.img} type="image/webp" />
                  <img
                    src={svc.img}
                    alt={svc.alt}
                    loading="lazy"
                    decoding="async"
                    width="640"
                    height="380"
                  />
                </picture>
                <div class="service-card-overlay" aria-hidden="true" />
                <div class="service-card-icon" aria-hidden="true">
                  <i class={svc.icon} />
                </div>
                <div class="service-card-num" aria-hidden="true">
                  {svc.num}
                </div>
                {svc.badge && (
                  <span class="service-card-badge">{svc.badge}</span>
                )}
              </div>
              <div class="service-card-body">
                <h3>{svc.title}</h3>
                <p>{svc.desc}</p>
                <a href={svc.href} class="service-card-link">
                  Learn More <i class="fas fa-arrow-right" aria-hidden="true" />
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <div class="services-open-note reveal-up">
        <div class="services-open-note-icon" aria-hidden="true">
          <i class="fas fa-house-medical"></i>
        </div>
        <div class="services-open-note-body">
          <strong>General medical services are available to everyone.</strong>
          <p>
            While Nyabondo specialises in physical rehabilitation for persons
            with disabilities, our SHA-accredited outpatient and inpatient
            facility is open to all community members for general medical care.
            No disability required. No referral needed for routine
            consultations.
          </p>
        </div>
        <a href="/services/outpatient-inpatient" class="services-open-note-cta">
          Book a visit <i class="fas fa-arrow-right" aria-hidden="true"></i>
        </a>
      </div>

      <div class="section-cta">
        <a href="/services" class="btn btn-primary">
          View All Services <i class="fas fa-arrow-right" aria-hidden="true"
          ></i>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════
       PROGRAMS
  ═══════════════════════ -->
  <section class="programs" aria-labelledby="programs-heading">
    <div class="programs-bg" aria-hidden="true"></div>
    <div class="container programs-inner">
      <div class="programs-layout">
        <!-- Left: two images stacked, second hidden on mobile -->
        <div class="programs-image-col reveal-left">
          <div class="programs-image-wrap">
            <picture>
              <source
                srcset="/images/programs/programs-overview.webp"
                type="image/webp"
              />
              <img
                src="/images/programs/programs-overview.webp"
                alt="Nyabondo Centre programmes transforming lives through rehabilitation and empowerment"
                loading="lazy"
                decoding="async"
                width="800"
                height="960"
              />
            </picture>
            <div class="programs-image-badge" aria-hidden="true">
              <i class="fas fa-star"></i>
              <span>Transforming Communities</span>
            </div>
          </div>

          <!-- Second image: desktop only, fills vertical gap -->
          <div class="programs-image-secondary" aria-hidden="true">
            <picture>
              <source
                srcset="/images/programs/programs-overview-1.webp"
                type="image/webp"
              />
              <img
                src="/images/programs/programs-secondary.webp"
                alt="Nyabondo programmes community impact"
                loading="lazy"
                decoding="async"
                width="800"
                height="960"
              />
            </picture>
          </div>
        </div>

        <!-- Right: content -->
        <div class="programs-content reveal-right">
          <span class="section-eyebrow">Our Programs</span>
          <h2 id="programs-heading" class="section-title">
            Empowering People,<br />Transforming Communities
          </h2>
          <p class="programs-lead">
            Beyond clinical services, Nyabondo runs structured programmes that
            address the social, economic, and community dimensions of
            disability, helping persons with disabilities and their families
            build lasting resilience.
          </p>

          <div class="programs-list">
            {
              programs.map((prog) => (
                <a href={prog.href} class="program-item">
                  <div class="program-item-icon" aria-hidden="true">
                    <i class={prog.icon} />
                  </div>
                  <div class="program-item-body">
                    <h3>{prog.title}</h3>
                    <p>{prog.desc}</p>
                  </div>
                  <div class="program-item-arrow" aria-hidden="true">
                    <i class="fas fa-arrow-right" />
                  </div>
                </a>
              ))
            }
          </div>

          <div class="programs-cta">
            <a href="/programs" class="btn btn-primary">
              Explore All Programs <i
                class="fas fa-arrow-right"
                aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════
       SHINE PROJECT SPOTLIGHT
  ═══════════════════════════════ -->
  <section class="shine" aria-labelledby="shine-heading">
    <div class="shine-bg" aria-hidden="true"></div>
    <div class="container shine-inner">
      <div class="shine-image-col reveal-left">
        <div class="shine-img-wrap">
          <picture>
            <source
              srcset="/images/programs/shine-project.webp"
              type="image/webp"
            />
            <img
              src="/images/programs/shine-project.webp"
              alt="CBM and Nyabondo SHINE Project activities in Kisumu and Homa Bay Counties"
              loading="lazy"
              decoding="async"
              width="800"
              height="620"
            />
          </picture>
          <div class="shine-cbm-badge">
            <picture>
              <source
                srcset="/images/partners/cbm-global.webp"
                type="image/webp"
              />
              <img
                src="/images/partners/cbm-global.webp"
                alt="CBM Global"
                loading="lazy"
                width="120"
                height="50"
              />
            </picture>
          </div>
        </div>
      </div>

      <div class="shine-content reveal-right">
        <div class="shine-meta-row">
          <span class="section-eyebrow section-eyebrow--light"
            >Project Spotlight</span
          >
          <span class="shine-period-pill">2026 to 2029</span>
        </div>

        <h2 id="shine-heading" class="shine-title">
          The <em>SHINE</em> Project
        </h2>

        <p class="shine-acronym">
          Strengthening capacities for Holistic and Inclusive Need-based
          rehabilitative services that Empower individuals and communities
        </p>

        <p class="shine-body">
          Supported by Christian Blind Mission, Nyabondo is implementing the
          SHINE Project across Kisumu and Homa Bay Counties from 2026 to 2029.
          The programme works on two tracks: empowering individuals with
          disabilities through improved access to surgeries, assistive products,
          rehabilitation, and social protection; and equipping healthcare
          systems, communities, and county governments to create lasting,
          inclusive change.
        </p>

        <div class="shine-tracks">
          <div class="shine-track">
            <span class="shine-track-icon"
              ><i class="fas fa-person-walking" aria-hidden="true"></i></span
            >
            <div>
              <strong>Individual Track</strong>
              <span
                >Orthopaedic surgeries, assistive products, rehabilitation and
                social protection for persons with disabilities</span
              >
            </div>
          </div>
          <div class="shine-track">
            <span class="shine-track-icon"
              ><i class="fas fa-building-columns" aria-hidden="true"></i></span
            >
            <div>
              <strong>Societal Track</strong>
              <span
                >Strengthening healthcare systems, county governments, and
                communities for lasting inclusive change</span
              >
            </div>
          </div>
          <div class="shine-track">
            <span class="shine-track-icon"
              ><i class="fas fa-map-location-dot" aria-hidden="true"></i></span
            >
            <div>
              <strong>Two Counties</strong>
              <span
                >Kisumu and Homa Bay are the target implementation areas for the
