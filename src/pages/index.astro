<script>
  (function () {
    "use strict";

    /* SCROLL REVEAL */
    (function () {
      var reduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      if (reduced) return;
      var els = Array.from(
        document.querySelectorAll(
          ".reveal-up, .reveal-left, .reveal-right, .impact-item, .partner-card",
        ),
      );
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              var el = entry.target;
              el.style.transitionDelay =
                el.style.getPropertyValue("--delay") || "0ms";
              el.classList.add("is-visible");
              io.unobserve(el);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
      );
      els.forEach(function (el) {
        io.observe(el);
      });
    })();

    /* COUNTER ANIMATION */
    (function () {
      var reduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      if (reduced) return;
      function animateCounter(el) {
        var raw = el.getAttribute("data-target") || el.textContent;
        var suffix = raw.replace(/[\d,]/g, "");
        var num = parseInt(raw.replace(/\D/g, ""), 10);
        if (!num) return;
        var duration = 1800,
          start = null;
        function step(ts) {
          if (!start) start = ts;
          var progress = Math.min((ts - start) / duration, 1);
          var ease = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.floor(ease * num).toLocaleString() + suffix;
          if (progress < 1) requestAnimationFrame(step);
          else el.textContent = raw;
        }
        requestAnimationFrame(step);
      }
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              animateCounter(entry.target);
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.5 },
      );
      document.querySelectorAll(".impact-num").forEach(function (el) {
        io.observe(el);
      });
    })();

    /* HERO CAROUSEL */
    (function () {
      var DURATION = 6000;
      var track = document.getElementById("heroTrack");
      var bar = document.getElementById("heroProgressBar");
      var prevBtn = document.getElementById("heroPrev");
      var nextBtn = document.getElementById("heroNext");
      var heroEl = document.getElementById("hero");
      var slideNum = document.getElementById("heroSlideNum");
      var dots = Array.from(document.querySelectorAll(".hero-dot"));
      if (!track) return;
      var slides = Array.from(track.querySelectorAll(".hero-slide"));
      var total = slides.length;
      if (total < 2) return;
      var reduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      track.style.display = "flex";
      track.style.height = "100%";
      track.style.width = total * 100 + "%";
      slides.forEach(function (s) {
        s.style.width = 100 / total + "%";
        s.style.flexShrink = "0";
        s.style.position = "relative";
        s.style.height = "100%";
      });

      var current = 0,
        paused = false,
        startTs = null,
        elapsed = 0,
        rafId = null;

      function moveTo(idx, anim) {
        track.style.transition =
          anim && !reduced
            ? "transform 900ms cubic-bezier(0.76,0,0.24,1)"
            : "none";
        track.style.transform = "translateX(-" + idx * (100 / total) + "%)";
      }
      function syncDots(idx) {
        dots.forEach(function (d, i) {
          d.classList.toggle("is-active", i === idx);
          d.setAttribute("aria-selected", String(i === idx));
        });
        if (slideNum) slideNum.textContent = String(idx + 1).padStart(2, "0");
      }
      function resetBar() {
        cancelAnimationFrame(rafId);
        startTs = null;
        elapsed = 0;
        if (bar) {
          bar.style.transition = "none";
          bar.style.width = "0%";
          void bar.offsetWidth;
          bar.style.transition = "width " + DURATION + "ms linear";
        }
        if (!paused && !reduced) rafId = requestAnimationFrame(tick);
      }
      function goTo(idx, anim) {
        current = ((idx % total) + total) % total;
        moveTo(current, anim !== false);
        syncDots(current);
        resetBar();
      }
      function tick(ts) {
        if (paused) return;
        if (!startTs) startTs = ts;
        elapsed = ts - startTs;
        if (bar)
          bar.style.width = Math.min((elapsed / DURATION) * 100, 100) + "%";
        if (elapsed >= DURATION) goTo(current + 1);
        else rafId = requestAnimationFrame(tick);
      }
      function pause() {
        paused = true;
        cancelAnimationFrame(rafId);
      }
      function resume() {
        if (!paused) return;
        paused = false;
        startTs = performance.now() - elapsed;
        rafId = requestAnimationFrame(tick);
      }

      prevBtn &&
        prevBtn.addEventListener("click", function () {
          goTo(current - 1);
        });
      nextBtn &&
        nextBtn.addEventListener("click", function () {
          goTo(current + 1);
        });
      dots.forEach(function (d, i) {
        d.addEventListener("click", function () {
          goTo(i);
        });
      });
      heroEl && heroEl.addEventListener("mouseenter", pause);
      heroEl && heroEl.addEventListener("mouseleave", resume);
      heroEl && heroEl.addEventListener("focusin", pause);
      heroEl && heroEl.addEventListener("focusout", resume);
      heroEl &&
        heroEl.addEventListener("keydown", function (e) {
          if (e.key === "ArrowLeft") goTo(current - 1);
          if (e.key === "ArrowRight") goTo(current + 1);
        });
      var tx = 0;
      heroEl &&
        heroEl.addEventListener(
          "touchstart",
          function (e) {
            tx = e.changedTouches[0].clientX;
          },
          { passive: true },
        );
      heroEl &&
        heroEl.addEventListener(
          "touchend",
          function (e) {
            var dx = e.changedTouches[0].clientX - tx;
            if (Math.abs(dx) > 44) goTo(current + (dx < 0 ? 1 : -1));
          },
          { passive: true },
        );

      moveTo(0, false);
      syncDots(0);
      if (!reduced) rafId = requestAnimationFrame(tick);
    })();
  })();
</script>

<style>
  /* ═══════════════════════════════════════
     DESIGN TOKENS
  ═══════════════════════════════════════ */
  :root {
    --primary: #0096c7;
    --primary-dark: #006d94;
    --primary-mid: #007bab;
    --primary-light: #48b8d8;
    --secondary: #2e8b57;
    --secondary-dark: #1f6b40;
    --secondary-light: #3dad6e;
    --secondary-pale: rgba(46, 139, 87, 0.12);
    --text: #0d2b38;
    --text-light: #2e5a6b;
    --text-muted: #5a8a99;
    --background: #f4fcff;
    --surface: #ffffff;
    --border: #c7e9f4;
    --border-light: #ddf1f9;
    --shadow-xs: 0 1px 3px rgba(0, 150, 199, 0.06);
    --shadow-sm: 0 2px 8px rgba(0, 150, 199, 0.08);
    --shadow-md: 0 6px 24px rgba(0, 150, 199, 0.1);
    --shadow-lg: 0 16px 48px rgba(0, 150, 199, 0.12);
    --shadow-xl: 0 24px 72px rgba(0, 150, 199, 0.15);
    --radius-sm: 6px;
    --radius-md: 14px;
    --radius-lg: 22px;
    --radius-xl: 32px;
    --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-in-out: cubic-bezier(0.76, 0, 0.24, 1);
    --transition-fast: 0.22s;
    --transition-base: 0.3s;
    --transition-slow: 0.55s;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Section headers */
  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 56px;
  }
  .section-header--light {
    margin-bottom: 48px;
  }

  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--primary);
    margin-bottom: 12px;
  }
  .section-eyebrow::before,
  .section-eyebrow::after {
    content: "";
    display: block;
    width: 24px;
    height: 1.5px;
    background: currentColor;
    opacity: 0.5;
  }
  .section-eyebrow--light {
    color: var(--primary-light);
  }

  .section-title {
    font-family: "Playfair Display", serif;
    font-size: clamp(1.9rem, 3vw, 2.7rem);
    font-weight: 700;
    color: var(--text);
    line-height: 1.18;
    margin-bottom: 18px;
  }
  .section-title--light {
    color: #fff;
  }
  .section-subtitle {
    font-size: 1.05rem;
    color: var(--text-light);
    line-height: 1.75;
  }
  .section-subtitle--light {
    color: rgba(255, 255, 255, 0.72);
  }
  .section-cta {
    margin-top: 44px;
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ═══════════════════════════════════════
     SCROLL REVEAL
  ═══════════════════════════════════════ */
  @media (prefers-reduced-motion: no-preference) {
    .reveal-up {
      opacity: 0;
      transform: translateY(32px);
      transition:
        opacity 0.7s var(--ease-out-expo),
        transform 0.7s var(--ease-out-expo);
    }
    .reveal-left {
      opacity: 0;
      transform: translateX(-40px);
      transition:
        opacity 0.8s var(--ease-out-expo),
        transform 0.8s var(--ease-out-expo);
    }
    .reveal-right {
      opacity: 0;
      transform: translateX(40px);
      transition:
        opacity 0.8s var(--ease-out-expo),
        transform 0.8s var(--ease-out-expo);
    }
    .impact-item {
      opacity: 0;
      transform: translateY(20px);
      transition:
        opacity 0.55s var(--ease-out-expo),
        transform 0.55s var(--ease-out-expo);
      transition-delay: var(--delay, 0ms);
    }
    .partner-card {
      opacity: 0;
      transform: translateY(14px) scale(0.97);
      transition:
        opacity 0.5s var(--ease-out-expo),
        transform 0.5s var(--ease-out-expo),
        box-shadow 0.22s ease,
        border-color 0.22s ease;
      transition-delay: var(--delay, 0ms);
    }
    .reveal-up.is-visible,
    .reveal-left.is-visible,
    .reveal-right.is-visible,
    .impact-item.is-visible,
    .partner-card.is-visible {
      opacity: 1;
      transform: none;
    }
  }

  /* ═══════════════════════════════════════
     BUTTONS
  ═══════════════════════════════════════ */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 14px 28px;
    border-radius: var(--radius-sm);
    font-family: "Source Sans 3", sans-serif;
    font-size: 0.94rem;
    font-weight: 600;
    text-decoration: none;
    border: 2px solid transparent;
    cursor: pointer;
    transition: all var(--transition-fast) var(--ease-out-expo);
    white-space: nowrap;
    position: relative;
    overflow: hidden;
  }
  .btn:hover {
    transform: translateY(-2px);
  }
  .btn:active {
    transform: translateY(0px);
  }
  .btn i {
    transition: transform var(--transition-fast) var(--ease-out-expo);
  }
  .btn:hover i.fa-arrow-right {
    transform: translateX(4px);
  }

  .btn-green {
    background: var(--secondary);
    color: #fff;
    border-color: var(--secondary);
    box-shadow: 0 4px 18px rgba(46, 139, 87, 0.3);
  }
  .btn-green:hover {
    background: var(--secondary-dark);
    border-color: var(--secondary-dark);
    box-shadow: 0 8px 28px rgba(46, 139, 87, 0.4);
  }
  .btn-white-outline {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(8px);
  }
  .btn-white-outline:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.8);
  }
  .btn-primary {
    background: var(--primary);
    color: #fff;
    box-shadow: 0 4px 16px rgba(0, 150, 199, 0.25);
  }
  .btn-primary:hover {
    background: var(--primary-dark);
    box-shadow: 0 8px 28px rgba(0, 150, 199, 0.35);
  }
  .btn-primary-outline {
    background: transparent;
    color: var(--primary);
    border-color: var(--primary);
  }
  .btn-primary-outline:hover {
    background: var(--primary);
    color: #fff;
  }
  .btn-outline-blue {
    background: transparent;
    color: var(--primary);
    border-color: var(--primary);
  }
  .btn-outline-blue:hover {
    background: var(--primary);
    color: #fff;
  }
  .btn-white-solid {
    background: #fff;
    color: var(--primary);
    border-color: #fff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
  }
  .btn-white-solid:hover {
    background: #e0f5fc;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14);
  }
  .btn-white-outline-sm {
    background: transparent;
    color: #fff;
    border-color: rgba(255, 255, 255, 0.45);
    padding: 14px 22px;
  }
  .btn-white-outline-sm:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.7);
  }
  .btn-shine {
    background: var(--primary-light);
    color: #fff;
    border-color: var(--primary-light);
    box-shadow: 0 4px 18px rgba(72, 184, 216, 0.35);
  }
  .btn-shine:hover {
    background: var(--primary);
    border-color: var(--primary);
  }

  /* ═══════════════════════════════════════
     HERO
  ═══════════════════════════════════════ */
  .hero {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 600px;
    overflow: hidden;
    background: var(--primary-dark);
    isolation: isolate;
  }
  .hero-track {
    position: absolute;
    inset: 0;
    will-change: transform;
  }
  .hero-slide picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero-slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-slide-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgba(0, 35, 60, 0.8) 0%,
      rgba(0, 35, 60, 0.35) 45%,
      rgba(0, 35, 60, 0.12) 70%,
      transparent 100%
    );
  }
  .hero-grain {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    opacity: 0.025;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 160px 160px;
  }
  .hero-content {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    padding: 0 80px 80px;
    max-width: 920px;
    animation: heroEntrance 1.1s 0.1s var(--ease-out-expo) both;
  }
  @keyframes heroEntrance {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(0, 150, 199, 0.22);
    border: 1.5px solid rgba(72, 184, 216, 0.65);
    color: var(--primary-light);
    padding: 8px 20px 8px 16px;
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 16px;
    backdrop-filter: blur(4px);
  }
  .hero-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--primary-light);
    animation: dotPulse 2s 1s ease-out infinite;
  }
  @keyframes dotPulse {
    0% {
      box-shadow: 0 0 0 0 rgba(72, 184, 216, 0.8);
    }
    70% {
      box-shadow: 0 0 0 8px rgba(72, 184, 216, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(72, 184, 216, 0);
    }
  }

  .hero-title {
    font-family: "Playfair Display", serif;
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 900;
    color: #fff;
    line-height: 1.08;
    margin-bottom: 16px;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 32px rgba(0, 0, 0, 0.35);
    word-break: break-word;
  }
  .hero-accent-wrap {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }
  .hero-accent {
    color: var(--primary-light);
    font-style: italic;
    font-weight: 900;
  }
  .hero-accent-underline {
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    color: var(--primary-light);
    opacity: 0;
    animation: underlineDraw 0.8s 1.2s var(--ease-out-expo) forwards;
  }
  @keyframes underlineDraw {
    from {
      opacity: 0;
      stroke-dasharray: 300;
      stroke-dashoffset: 300;
    }
    to {
      opacity: 0.8;
      stroke-dasharray: 300;
      stroke-dashoffset: 0;
    }
  }

  .hero-subtitle {
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    font-weight: 500;
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.75;
    margin-bottom: 16px;
    max-width: 640px;
  }

  /* Service tag pills */
  .hero-service-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
  }
  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 13px;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.76rem;
    font-weight: 600;
    backdrop-filter: blur(6px);
    white-space: nowrap;
  }
  .hero-tag i {
    font-size: 0.68rem;
    color: var(--primary-light);
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  .hero-stats {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-md);
    backdrop-filter: blur(16px);
    overflow: hidden;
  }
  .hero-stat {
    flex: 1;
    padding: 12px 20px;
    text-align: center;
  }
  .hero-stat-num {
    display: block;
    font-family: "Playfair Display", serif;
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--primary-light);
    line-height: 1;
  }
  .hero-stat-label {
    display: block;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin-top: 4px;
    white-space: nowrap;
  }
  .hero-stat-divider {
    width: 1px;
    background: rgba(255, 255, 255, 0.15);
    align-self: stretch;
  }

  .hero-slide-counter {
    position: absolute;
    right: 32px;
    bottom: 48px;
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-family: "Playfair Display", serif;
  }
  .hero-slide-current {
    font-size: 2rem;
    font-weight: 800;
    color: #fff;
    line-height: 1;
  }
  .hero-slide-sep {
    display: block;
    width: 1.5px;
    height: 28px;
    background: rgba(255, 255, 255, 0.35);
  }
  .hero-slide-total {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.4);
  }

  .hero-arrow {
    position: absolute;
    top: 72%;
    transform: translateY(-50%);
    z-index: 20;
    width: 54px;
    height: 54px;
    background: rgba(255, 255, 255, 0.1);
    border: 1.5px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    color: #fff;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: all var(--transition-fast) var(--ease-out-expo);
  }
  .hero-arrow:hover {
    background: var(--primary);
    border-color: var(--primary);
    transform: translateY(-50%) scale(1.1);
  }
  .hero-arrow--prev {
    left: 24px;
  }
  .hero-arrow--next {
    right: 72px;
  }

  .hero-dots {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 20;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .hero-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.32);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all var(--transition-fast) var(--ease-out-expo);
  }
  .hero-dot.is-active {
    background: var(--primary-light);
    width: 30px;
    border-radius: 4px;
  }

  .hero-progress {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: rgba(255, 255, 255, 0.08);
    z-index: 25;
  }
  .hero-progress-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--primary), var(--primary-light));
  }

  .hero-scroll-cue {
    position: absolute;
    left: 32px;
    bottom: 36px;
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .hero-scroll-label {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.38);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }
  .hero-scroll-line {
    width: 1.5px;
    height: 48px;
    background: rgba(255, 255, 255, 0.15);
    overflow: hidden;
    border-radius: 2px;
  }
  .hero-scroll-line-inner {
    width: 100%;
    height: 40%;
    background: var(--primary-light);
    animation: scrollDrop 1.8s 1s ease-in-out infinite;
  }
  @keyframes scrollDrop {
    0% {
      transform: translateY(-100%);
      opacity: 1;
    }
    70% {
      transform: translateY(280%);
      opacity: 0.7;
    }
    100% {
      transform: translateY(280%);
      opacity: 0;
    }
  }

  /* ═══════════════════════════════════════
     ABOUT
  ═══════════════════════════════════════ */
  .about-intro {
    padding: 108px 0;
    background: var(--surface);
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: start;
  }
  .about-left {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .about-header-block {
    display: flex;
    flex-direction: column;
  }
  .about-title {
    margin-top: 8px;
    margin-bottom: 0;
  }
  .about-image-wrap {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: visible;
  }
  .about-image-wrap picture {
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
  }
  .about-image-wrap img {
    width: 100%;
    height: 390px;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-slow) var(--ease-out-expo);
  }
  .about-image-wrap:hover img {
    transform: scale(1.03);
  }
  .about-image-frame {
    position: absolute;
    inset: -12px -12px 12px 12px;
    border: 2px solid var(--primary);
    border-radius: var(--radius-lg);
    opacity: 0.2;
    pointer-events: none;
    z-index: -1;
    transition: opacity var(--transition-base);
  }
  .about-image-wrap:hover .about-image-frame {
    opacity: 0.4;
  }
  .about-image-badge {
    position: absolute;
    bottom: -18px;
    right: 24px;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: #fff;
    border-radius: var(--radius-md);
    padding: 14px 22px;
    text-align: center;
    box-shadow: 0 8px 28px rgba(0, 150, 199, 0.4);
  }
  .about-image-badge-num {
    display: block;
    font-family: "Playfair Display", serif;
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
  }
  .about-image-badge-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    opacity: 0.85;
    margin-top: 2px;
    display: block;
  }
  .about-text {
    display: flex;
    flex-direction: column;
    padding-top: 8px;
  }
  .about-lead {
    font-size: 1.08rem;
    color: var(--text);
    line-height: 1.82;
    margin-bottom: 20px;
    font-weight: 500;
  }
  .about-body {
    font-size: 0.975rem;
    color: var(--text-light);
    line-height: 1.82;
    margin-bottom: 32px;
  }
  .about-values-row {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 36px;
  }
  .about-value {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 100px;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--primary);
    transition: all var(--transition-fast) var(--ease-out-expo);
  }
  .about-value:hover {
    background: var(--primary);
    color: #fff;
    border-color: var(--primary);
    transform: translateY(-2px);
  }
  .about-value-icon {
    font-size: 0.9rem;
    color: var(--secondary);
    transition: color var(--transition-fast);
  }
  .about-value:hover .about-value-icon {
    color: #fff;
  }

  /* ═══════════════════════════════════════
     IMPACT NUMBERS
  ═══════════════════════════════════════ */
  .impact {
    background: linear-gradient(
      135deg,
      var(--primary-dark) 0%,
      var(--primary) 55%,
      var(--primary-light) 100%
    );
    position: relative;
    overflow: hidden;
    padding: 0;
  }
  .impact::before {
    content: "";
    position: absolute;
    top: -100px;
    right: -100px;
    width: 450px;
    height: 450px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(46, 139, 87, 0.15) 0%,
      transparent 70%
    );
    pointer-events: none;
  }
  .impact-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
  }
  .impact-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 40px 16px;
    text-align: center;
    border-right: 1px solid rgba(255, 255, 255, 0.09);
    cursor: default;
    transition: all var(--transition-base) var(--ease-out-expo);
  }
  .impact-item:last-child {
    border-right: none;
  }
  .impact-item:hover {
    background: rgba(255, 255, 255, 0.06);
    transform: translateY(-4px);
  }
  .impact-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    border: 1.5px solid rgba(255, 255, 255, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
    color: #fff;
    flex-shrink: 0;
    transition: all var(--transition-base) var(--ease-out-expo);
  }
  .impact-item:hover .impact-icon {
    background: var(--secondary);
    border-color: var(--secondary);
    transform: scale(1.1) rotate(-5deg);
  }
  .impact-text {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .impact-num {
    font-family: "Playfair Display", serif;
    font-size: clamp(1.55rem, 2.2vw, 2.1rem);
    font-weight: 800;
    color: #fff;
    line-height: 1;
  }
  .impact-label {
    font-size: clamp(0.62rem, 0.85vw, 0.75rem);
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    white-space: nowrap;
  }

  /* ═══════════════════════════════════════
     SERVICES
  ═══════════════════════════════════════ */
  .services {
    padding: 108px 0;
    background: var(--background);
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }

  .service-card {
    background: var(--surface);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border-light);
    transition: all var(--transition-base) var(--ease-out-expo);
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .service-card:hover {
    box-shadow: var(--shadow-xl);
    transform: translateY(-8px);
    border-color: rgba(0, 150, 199, 0.3);
  }
  .service-card-img {
    position: relative;
    height: 220px;
    overflow: hidden;
    flex-shrink: 0;
  }
  .service-card-img picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .service-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s var(--ease-out-expo);
  }
  .service-card:hover .service-card-img img {
    transform: scale(1.07);
  }
  .service-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 50, 80, 0.72) 0%,
      rgba(0, 50, 80, 0.12) 55%,
      transparent 100%
    );
    transition: opacity var(--transition-base);
  }
  .service-card:hover .service-card-overlay {
    opacity: 0.85;
  }
  .service-card-icon {
    position: absolute;
    bottom: 14px;
    left: 16px;
    color: #fff;
    font-size: 1.5rem;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.4);
    transition: all var(--transition-base) var(--ease-out-expo);
  }
  .service-card:hover .service-card-icon {
    transform: scale(1.2) translateY(-3px);
  }
  .service-card-num {
    position: absolute;
    top: 12px;
    right: 14px;
    font-family: "Playfair Display", serif;
    font-size: 0.75rem;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.65);
    letter-spacing: 0.05em;
  }
  .service-card-badge {
    position: absolute;
    top: 12px;
    left: 14px;
    background: var(--secondary);
    color: #fff;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 100px;
  }
  .service-card-body {
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex-grow: 1;
  }
  .service-card-body h3 {
    font-family: "Playfair Display", serif;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text);
    transition: color var(--transition-fast);
  }
  .service-card:hover .service-card-body h3 {
    color: var(--primary);
  }
  .service-card-body p {
    font-size: 0.9rem;
    color: var(--text-light);
    line-height: 1.72;
    flex-grow: 1;
  }
  .service-card-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--primary);
    text-decoration: none;
    margin-top: 8px;
    transition: all var(--transition-fast) var(--ease-out-expo);
  }
  .service-card-link:hover {
    color: var(--secondary);
    gap: 12px;
  }
  .service-card::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--primary), var(--primary-light));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease-out-expo);
  }
  .service-card:hover::after {
    transform: scaleX(1);
  }

  /* General medical services note banner */
  .services-open-note {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    margin-top: 32px;
    padding: 24px 28px;
    background: linear-gradient(
      120deg,
      rgba(0, 150, 199, 0.06) 0%,
      rgba(46, 139, 87, 0.06) 100%
    );
    border: 1px solid var(--border);
    border-left: 4px solid var(--secondary);
    border-radius: var(--radius-md);
  }
  .services-open-note-icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(46, 139, 87, 0.12);
    border: 1.5px solid rgba(46, 139, 87, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    color: var(--secondary);
  }
  .services-open-note-body {
    flex: 1;
  }
  .services-open-note-body strong {
    display: block;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 6px;
  }
  .services-open-note-body p {
    font-size: 0.88rem;
    color: var(--text-light);
    line-height: 1.72;
    margin: 0;
  }
  .services-open-note-cta {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--primary);
    text-decoration: none;
    white-space: nowrap;
    align-self: center;
    transition: gap var(--transition-fast) var(--ease-out-expo);
  }
  .services-open-note-cta:hover {
    gap: 10px;
  }

  /* ═══════════════════════════════════════
     PROGRAMS
  ═══════════════════════════════════════ */
  .programs {
    position: relative;
    padding: 108px 0;
    overflow: hidden;
  }
  .programs-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(
      150deg,
      var(--surface) 0%,
      #e8f7ff 50%,
      #f0fff8 100%
    );
  }
  .programs-inner {
    position: relative;
    z-index: 1;
  }
  .programs-layout {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 72px;
    align-items: start;
  }

  .programs-image-col {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .programs-image-wrap {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: visible;
  }
  .programs-image-wrap picture {
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
  }
  .programs-image-wrap img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-slow) var(--ease-out-expo);
  }
  .programs-image-wrap:hover img {
    transform: scale(1.03);
  }

  .programs-image-badge {
    position: absolute;
    bottom: -18px;
    left: 24px;
    background: linear-gradient(
      135deg,
      var(--secondary),
      var(--secondary-dark)
    );
    color: #fff;
    border-radius: var(--radius-md);
    padding: 12px 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 8px 28px rgba(46, 139, 87, 0.4);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .programs-image-badge i {
    font-size: 1rem;
  }

  /* Second image: visible only on desktop to fill the vertical gap */
  .programs-image-secondary {
    display: block;
  }
  .programs-image-secondary picture {
    display: block;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }
  .programs-image-secondary img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: var(--radius-md);
    transition: transform var(--transition-slow) var(--ease-out-expo);
  }
  .programs-image-secondary:hover img {
    transform: scale(1.03);
  }

  .programs-content {
    display: flex;
    flex-direction: column;
    padding-top: 4px;
  }
  .programs-lead {
    font-size: 1.05rem;
    color: var(--text-light);
    line-height: 1.82;
    margin: 18px 0 32px;
  }
  .programs-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 36px;
  }

  .program-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 20px 22px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-decoration: none;
    cursor: pointer;
    transition: all var(--transition-fast) var(--ease-out-expo);
    position: relative;
    overflow: hidden;
  }
  .program-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(to bottom, var(--primary), var(--secondary));
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--transition-fast) var(--ease-out-expo);
  }
  .program-item:hover {
    border-color: var(--primary);
    box-shadow: var(--shadow-md);
    transform: translateX(4px);
  }
  .program-item:hover::before {
    transform: scaleY(1);
  }
  .program-item-icon {
    flex-shrink: 0;
    width: 46px;
    height: 46px;
    border-radius: var(--radius-sm);
    background: rgba(0, 150, 199, 0.1);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    color: var(--primary);
    transition: all var(--transition-fast) var(--ease-out-expo);
  }
  .program-item:hover .program-item-icon {
    background: var(--primary);
    color: #fff;
    border-color: var(--primary);
  }
  .program-item-body {
    flex: 1;
  }
  .program-item-body h3 {
    font-family: "Playfair Display", serif;
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 5px;
    transition: color var(--transition-fast);
  }
  .program-item:hover .program-item-body h3 {
    color: var(--primary);
  }
  .program-item-body p {
    font-size: 0.85rem;
    color: var(--text-light);
    line-height: 1.65;
  }
  .program-item-arrow {
    flex-shrink: 0;
    color: var(--text-muted);
    font-size: 0.8rem;
    margin-top: 4px;
    transition: all var(--transition-fast) var(--ease-out-expo);
  }
  .program-item:hover .program-item-arrow {
    color: var(--primary);
    transform: translateX(5px);
  }

  /* ═══════════════════════════════════════
     SHINE PROJECT SPOTLIGHT
  ═══════════════════════════════════════ */
  .shine {
    position: relative;
    padding: 100px 0;
    overflow: hidden;
  }
  .shine-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(140deg, #003a52 0%, #005476 45%, #006d94 100%);
  }
  .shine-bg::after {
    content: "";
    position: absolute;
    top: -140px;
    right: -100px;
    width: 560px;
    height: 560px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(72, 184, 216, 0.14) 0%,
      transparent 65%
    );
    pointer-events: none;
  }
  .shine-bg::before {
    content: "";
    position: absolute;
    bottom: -100px;
    left: -80px;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(46, 139, 87, 0.1) 0%,
      transparent 65%
    );
    pointer-events: none;
  }
  .shine-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 72px;
    align-items: center;
  }

  .shine-img-wrap {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: visible;
  }
  .shine-img-wrap picture {
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 20px 64px rgba(0, 0, 0, 0.5);
  }
  .shine-img-wrap img {
    width: 100%;
    height: 460px;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-slow) var(--ease-out-expo);
  }
  .shine-img-wrap:hover img {
    transform: scale(1.03);
  }
  .shine-cbm-badge {
    position: absolute;
    bottom: -16px;
    right: 20px;
    background: #fff;
    border-radius: var(--radius-md);
    padding: 10px 16px;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.22);
    display: flex;
    align-items: center;
  }
  .shine-cbm-badge img {
    height: 34px;
    width: auto;
    object-fit: contain;
  }

  .shine-content {
    display: flex;
    flex-direction: column;
  }

  .shine-meta-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }
  .shine-period-pill {
    display: inline-flex;
    align-items: center;
    background: rgba(72, 184, 216, 0.18);
    border: 1px solid rgba(72, 184, 216, 0.4);
    color: var(--primary-light);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 13px;
    border-radius: 100px;
  }

  .shine-title {
    font-family: "Playfair Display", serif;
    font-size: clamp(2rem, 3.2vw, 2.9rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.12;
    margin-bottom: 10px;
  }
  .shine-title em {
    color: var(--primary-light);
    font-style: italic;
  }

  .shine-acronym {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.5);
    font-style: italic;
    line-height: 1.6;
    margin-bottom: 20px;
    letter-spacing: 0.01em;
  }

  .shine-body {
    font-size: 0.975rem;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.82;
    margin-bottom: 28px;
  }

  .shine-tracks {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 32px;
  }
  .shine-track {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  .shine-track-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: rgba(72, 184, 216, 0.14);
    border: 1px solid rgba(72, 184, 216, 0.28);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    color: var(--primary-light);
  }
  .shine-track strong {
    display: block;
    font-size: 0.88rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 3px;
  }
  .shine-track span {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.55;
  }

  /* ═══════════════════════════════════════
     PARTNERS
  ═══════════════════════════════════════ */
  .partners {
    padding: 88px 0;
    background: var(--surface);
    border-top: 1px solid var(--border-light);
  }
  .partners-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
    align-items: center;
  }
  .partner-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 24px 16px;
    background: var(--background);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    text-decoration: none;
    min-height: 140px;
    transition: all var(--transition-fast) var(--ease-out-expo);
  }
  .partner-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-4px);
    border-color: var(--primary);
  }
  .partner-logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 70px;
  }
  .partner-logo-wrap picture {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }
  .partner-logo-wrap img {
    max-width: 100%;
    max-height: 60px;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: grayscale(0.35) opacity(0.85);
    transition: all var(--transition-base);
  }
  .partner-card:hover .partner-logo-wrap img {
    filter: grayscale(0) opacity(1);
    transform: scale(1.05);
  }
  .partner-logo-fallback {
    width: 50px;
    height: 50px;
    background: rgba(0, 150, 199, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    color: var(--primary);
  }
  .partner-name {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-light);
    text-align: center;
    line-height: 1.3;
    transition: color var(--transition-fast);
  }
  .partner-card:hover .partner-name {
    color: var(--primary);
  }

  /* ═══════════════════════════════════════
     STORIES
  ═══════════════════════════════════════ */
  .stories {
    padding: 108px 0;
    background: var(--background);
    border-top: 1px solid var(--border-light);
  }
  .stories-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .story-card {
    background: var(--surface);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border-light);
    box-shadow: var(--shadow-xs);
    transition: all var(--transition-base) var(--ease-out-expo);
    display: flex;
    flex-direction: column;
  }
  .story-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-8px);
    border-color: rgba(0, 150, 199, 0.25);
  }
  .story-img {
    height: 230px;
    overflow: hidden;
    position: relative;
  }
  .story-img picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .story-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-slow) var(--ease-out-expo);
  }
  .story-card:hover .story-img img {
    transform: scale(1.06);
  }
  .story-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 50, 80, 0.45) 0%,
      transparent 50%
    );
  }
  .story-body {
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    position: relative;
    flex-grow: 1;
  }
  .story-quote-mark {
    position: absolute;
    top: 8px;
    right: 20px;
    font-family: "Playfair Display", serif;
    font-size: 4.5rem;
    font-weight: 900;
    color: var(--primary);
    opacity: 0.08;
    line-height: 1;
    pointer-events: none;
    user-select: none;
    transition: opacity var(--transition-base);
  }
  .story-card:hover .story-quote-mark {
    opacity: 0.15;
  }
  .story-body h3 {
    font-family: "Playfair Display", serif;
    font-size: 1.12rem;
    font-weight: 700;
    color: var(--text);
  }
  .story-body blockquote {
    font-size: 0.88rem;
    color: var(--text-light);
    line-height: 1.78;
    font-style: italic;
    margin: 0;
    flex-grow: 1;
  }
  .story-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 12px;
    border-top: 1px solid var(--border-light);
    margin-top: auto;
  }
  .story-stars {
    color: var(--secondary);
    font-size: 0.75rem;
    display: flex;
    gap: 2px;
  }
  .story-body cite {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--primary);
    font-style: normal;
  }

  /* ═══════════════════════════════════════
     MISSION AND VISION
  ═══════════════════════════════════════ */
  .mvv {
    position: relative;
    padding: 108px 0;
    overflow: hidden;
  }
  .mvv-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(
      135deg,
      var(--primary-dark) 0%,
      var(--primary) 55%,
      var(--primary-light) 100%
    );
  }
  .mvv-pattern {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .mvv-pattern svg {
    width: 100%;
    height: 100%;
  }
  .mvv-inner {
    position: relative;
    z-index: 1;
  }
  .mv-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .mv-card {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-lg);
    padding: 44px 38px;
    transition: all var(--transition-base) var(--ease-out-expo);
    position: relative;
    overflow: hidden;
  }
  .mv-card:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.22);
    transform: translateY(-6px);
  }
  .mv-card--vision {
    background: rgba(46, 139, 87, 0.12);
    border-color: rgba(61, 173, 110, 0.3);
  }
  .mv-card--vision:hover {
    background: rgba(46, 139, 87, 0.18);
    border-color: rgba(61, 173, 110, 0.5);
  }
  .mv-card-icon-wrap {
    margin-bottom: 18px;
  }
  .mv-card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.22);
    font-size: 1.6rem;
    color: var(--primary-light);
    transition: all var(--transition-base) var(--ease-out-expo);
  }
  .mv-card:hover .mv-card-icon {
    transform: scale(1.1) rotate(-5deg);
  }
  .mv-card-label {
    font-family: "Playfair Display", serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 14px;
  }
  .mv-card-text {
    font-size: 0.975rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.82;
  }

  /* ═══════════════════════════════════════
     CTA BANNER
  ═══════════════════════════════════════ */
  .cta-banner {
    position: relative;
    padding: 80px 0;
    overflow: hidden;
  }
  .cta-banner-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      110deg,
      var(--primary-dark) 0%,
      var(--primary-mid) 50%,
      var(--primary) 100%
    );
  }
  .cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
    flex-wrap: wrap;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .cta-text {
    max-width: 560px;
  }
  .cta-title {
    font-family: "Playfair Display", serif;
    font-size: clamp(1.7rem, 2.5vw, 2.3rem);
    font-weight: 700;
    color: #fff;
    margin-bottom: 14px;
  }
  .cta-subtitle {
    font-size: 1.02rem;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.78;
  }
  .cta-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    align-items: center;
    flex-shrink: 0;
  }

  /* ═══════════════════════════════════════
     RESPONSIVE FIXES
  ═══════════════════════════════════════ */
  @media (max-width: 1024px) {
    .impact-inner {
      grid-template-columns: repeat(3, 1fr);
    }
    .impact-item:nth-child(3) {
      border-right: none;
    }
    .impact-item:nth-child(n + 4) {
      border-top: 1px solid rgba(255, 255, 255, 0.09);
    }
    .about-grid {
      gap: 52px;
    }
    .partners-grid {
      grid-template-columns: repeat(4, 1fr);
    }
    .programs-layout {
      gap: 48px;
    }
    .shine-inner {
      gap: 48px;
    }
  }

  @media (max-width: 768px) {
    /* Hero */
    .hero-content {
      padding: 0 20px 100px;
      align-items: center;
      text-align: center;
      max-width: 100%;
    }
    .hero-title {
      font-size: clamp(2.4rem, 8vw, 3.2rem);
      text-align: center;
    }
    .hero-accent-wrap {
      white-space: normal;
    }
    .hero-accent-underline {
      width: 90%;
      left: 5%;
      bottom: -2px;
    }
    .hero-subtitle {
      font-size: 1rem;
      max-width: 100%;
      text-align: center;
    }
    .hero-service-tags {
      justify-content: center;
    }
    .hero-actions {
      justify-content: center;
      width: 100%;
    }
    .hero-stats {
      width: 100%;
    }
    .hero-stat {
      padding: 10px 8px;
    }
    .hero-stat-num {
      font-size: 1.2rem;
    }
    .hero-stat-label {
      font-size: 0.52rem;
      white-space: normal;
    }
    .hero-arrow {
      top: 80%;
      width: 42px;
      height: 42px;
    }
    .hero-arrow--prev {
      left: 12px;
    }
    .hero-arrow--next {
      right: 12px;
    }
    .hero-dots {
      bottom: 16px;
    }
    .hero-slide-counter,
    .hero-scroll-cue {
      display: none;
    }

    /* Impact */
    .impact-inner {
      grid-template-columns: repeat(2, 1fr);
    }
    .impact-item {
      border-right: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.09);
      padding: 28px 14px;
    }
    .impact-item:nth-last-child(-n + 2) {
      border-bottom: none;
    }
