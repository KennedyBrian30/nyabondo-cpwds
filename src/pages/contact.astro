---
// src/pages/contact.astro
import Layout from "../layouts/Layout.astro";

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Contact", href: "/contact" },
];

const contactInfo = [
  {
    icon: "fas fa-phone",
    title: "Phone",
    details: [
      { label: "Main Line", value: "0733 384 352" },
      { label: "Alternative", value: "+254 733 384 352" },
    ],
  },
  {
    icon: "fas fa-envelope",
    title: "Email",
    details: [
      { label: "General Inquiries", value: "nyabdisabled2003@gmail.com" },
    ],
  },
  {
    icon: "fas fa-location-dot",
    title: "Location",
    details: [
      { label: "Physical Address", value: "Kisumu County, Nyakach Sub-county" },
      {
        label: "Directions",
        value:
          "Ahero Kisii Road, 5km off Sondu junction, Next to Nyabondo Day Primary School",
      },
    ],
  },
  {
    icon: "fas fa-clock",
    title: "Working Hours",
    details: [
      { label: "Monday - Friday", value: "8:00 AM - 5:00 PM" },
      { label: "Saturday", value: "8:00 AM - 1:00 PM" },
      { label: "Sunday", value: "Closed" },
    ],
  },
];

const socialLinks = [
  { platform: "Facebook", icon: "fab fa-facebook-f", url: "#" },
  { platform: "Twitter / X", icon: "fab fa-x-twitter", url: "#" },
  { platform: "Instagram", icon: "fab fa-instagram", url: "#" },
  { platform: "YouTube", icon: "fab fa-youtube", url: "#" },
];

const quickLinks = [
  { label: "About Us", href: "/about" },
  { label: "Our Services", href: "/services" },
  { label: "Programs", href: "/programs" },
  { label: "Get Involved", href: "/get-involved" },
  { label: "Donate", href: "/get-involved/donate" },
];
---

<Layout title="Contact Us | Nyabondo Centre for Persons with Disabilities">
  <!-- BREADCRUMB -->
  <nav class="contact-bc" aria-label="Breadcrumb">
    <div class="contact-container">
      <ol>
        {
          breadcrumbs.map((c, i) => (
            <li>
              {i < breadcrumbs.length - 1 ? (
                <a href={c.href}>{c.label}</a>
              ) : (
                <span aria-current="page">{c.label}</span>
              )}
              {i < breadcrumbs.length - 1 && (
                <i class="fas fa-chevron-right" aria-hidden="true" />
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </nav>

  <!-- HERO -->
  <section class="contact-hero">
    <div class="contact-container">
      <div class="contact-hero-content">
        <span class="contact-eyebrow">Get in Touch</span>
        <h1>Contact Us</h1>
        <p>
          We would love to hear from you. Whether you have a question about our
          services, want to partner with us, or need assistance — reach out to
          us today.
        </p>
      </div>
    </div>
    <div class="contact-hero-wave" aria-hidden="true">
      <svg viewBox="0 0 1440 40" preserveAspectRatio="none">
        <path
          d="M0,40 C240,20 480,0 720,20 C960,40 1200,20 1440,40 L1440,40 L0,40 Z"
          fill="#f4fcff"></path>
      </svg>
    </div>
  </section>

  <!-- CONTACT INFO CARDS -->
  <section class="contact-info">
    <div class="contact-container">
      <div class="contact-info-grid">
        {
          contactInfo.map((info) => (
            <div class="contact-info-card">
              <div class="contact-info-icon" aria-hidden="true">
                <i class={info.icon} />
              </div>
              <h3>{info.title}</h3>
              {info.details.map((detail) => (
                <p>
                  <strong>{detail.label}:</strong> {detail.value}
                </p>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CONTACT FORM + MAP -->
  <section class="contact-form-section">
    <div class="contact-container">
      <div class="contact-form-grid">
        <!-- Form Column -->
        <div class="contact-form-col">
          <div class="contact-form-header">
            <span class="contact-eyebrow">Send a Message</span>
            <h2>We'd Love to Hear From You</h2>
            <p>
              Fill in the form below and our team will get back to you as soon
              as possible.
            </p>
          </div>
          <form
            class="contact-form"
            action="https://script.google.com/macros/s/AKfycbwG2CDSDdLYA5nlNDZAP4xWI1bi8a4VcrIPW4TFwxKRFk8vT6UIr8S6dAXImOdHIv2VMw/exec"
            method="POST"
            target="_blank"
          >
            <!-- Name -->
            <div class="contact-form-group">
              <label for="contact-name"
                >Full Name <span class="required">*</span></label
              >
              <input
                type="text"
                id="contact-name"
                name="name"
                placeholder="e.g., John Mwangi"
                required
              />
            </div>

            <!-- Email -->
            <div class="contact-form-group">
              <label for="contact-email"
                >Email Address <span class="required">*</span></label
              >
              <input
                type="email"
                id="contact-email"
                name="email"
                placeholder="e.g., john@example.com"
                required
              />
            </div>

            <!-- Phone -->
            <div class="contact-form-group">
              <label for="contact-phone">Phone Number</label>
              <input
                type="tel"
                id="contact-phone"
                name="phone"
                placeholder="e.g., 0712345678"
              />
            </div>

            <!-- Subject -->
            <div class="contact-form-group">
              <label for="contact-subject"
                >Subject <span class="required">*</span></label
              >
              <select id="contact-subject" name="subject" required>
                <option value="">— Select a subject —</option>
                <option value="General Inquiry">General Inquiry</option>
                <option value="Services Information"
                  >Services Information</option
                >
                <option value="Partnership">Partnership</option>
                <option value="Donation">Donation</option>
                <option value="Volunteering">Volunteering</option>
                <option value="Feedback">Feedback / Compliment</option>
                <option value="Other">Other</option>
              </select>
            </div>

            <!-- Message -->
            <div class="contact-form-group">
              <label for="contact-message"
                >Message <span class="required">*</span></label
              >
              <textarea
                id="contact-message"
                name="message"
                rows="5"
                placeholder="Tell us how we can help you..."
                required></textarea>
            </div>

            <!-- Submit -->
            <div class="contact-form-group contact-form-submit">
              <button type="submit" class="contact-btn contact-btn-submit">
                <i class="fas fa-paper-plane"></i> Send Message
              </button>
              <p class="contact-form-note">
                By submitting this form, you consent to Nyabondo Centre
                contacting you. Your data will not be shared with third parties.
              </p>
            </div>
          </form>
        </div>

        <!-- Map Column -->
        <div class="contact-map-col">
          <div class="contact-map-card">
            <h3>Find Us</h3>
            <div class="contact-map-wrapper">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d255199.54811170907!2d34.90894845742245!3d-0.24318199999999997!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x182f1b0ba64aafab%3A0x4c2128a3370f79fd!2sNyabondo%20Centre%20for%20Persons%20with%20Disabilities!5e0!3m2!1sen!2ske!4v1719999999999!5m2!1sen!2ske"
                width="100%"
                height="350"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Nyabondo Centre location map"></iframe>
            </div>
            <div class="contact-address-details">
              <p>
                <i class="fas fa-location-dot" aria-hidden="true"></i>
                <strong>Physical Address:</strong> Kisumu County, Nyakach Sub-county
              </p>
              <p>
                <i class="fas fa-road" aria-hidden="true"></i>
                <strong>Directions:</strong> Ahero Kisii Road, 5km off Sondu junction,
                Next to Nyabondo Day Primary School
              </p>
              <p>
                <i class="fas fa-envelope" aria-hidden="true"></i>
                <strong>Postal Address:</strong> P.O Box 75-40109, Sondu, Kenya
              </p>
            </div>
          </div>

          <!-- Social Links -->
          <div class="contact-social">
            <h3>Connect With Us</h3>
            <div class="contact-social-links">
              {
                socialLinks.map((social) => (
                  <a
                    href={social.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={social.platform}
                  >
                    <i class={social.icon} aria-hidden="true" />
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- QUICK LINKS -->
  <section class="contact-quick-links">
    <div class="contact-container">
      <div class="contact-quick-links-card">
        <h3>Quick Links</h3>
        <div class="contact-quick-links-grid">
          {
            quickLinks.map((link) => (
              <a href={link.href} class="contact-quick-link">
                <i class="fas fa-chevron-right" aria-hidden="true" />
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- CTA BANNER -->
  <section class="contact-cta">
    <div class="contact-container">
      <div class="contact-cta-card">
        <h2>Want to Make a Difference?</h2>
        <p>
          Join us in transforming the lives of persons with disabilities across
          Kenya.
        </p>
        <div class="contact-cta-buttons">
          <a href="/get-involved/donate" class="contact-btn contact-btn-green">
            <i class="fas fa-heart" aria-hidden="true"></i> Donate Now
          </a>
          <a
            href="/get-involved/volunteer"
            class="contact-btn contact-btn-white"
          >
            <i class="fas fa-hands-helping" aria-hidden="true"></i> Volunteer
          </a>
          <a
            href="/get-involved/partner"
            class="contact-btn contact-btn-outline-light"
          >
            <i class="fas fa-handshake" aria-hidden="true"></i> Partner With Us
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* =============================================
     CONTACT PAGE STYLES
  ============================================= */
  :root {
    --contact-primary: #0096c7;
    --contact-primary-dark: #006d94;
    --contact-primary-light: #48b8d8;
    --contact-green: #2e8b57;
    --contact-green-dark: #1f6b40;
    --contact-text: #0d2b38;
    --contact-text-light: #2e5a6b;
    --contact-bg: #f4fcff;
    --contact-surface: #ffffff;
    --contact-border: #c7e9f4;
    --contact-shadow: 0 6px 24px rgba(0, 150, 199, 0.1);
    --contact-radius: 14px;
    --contact-ease: cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Breadcrumb */
  .contact-bc {
    background: var(--contact-surface);
    border-bottom: 1px solid var(--contact-border);
    padding: 12px 0;
  }
  .contact-bc ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .contact-bc li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
  }
  .contact-bc a {
    color: var(--contact-primary);
    text-decoration: none;
  }
  .contact-bc a:hover {
    text-decoration: underline;
  }
  .contact-bc span {
    color: var(--contact-text-light);
  }
  .contact-bc i {
    font-size: 0.65rem;
    color: var(--contact-text-light);
  }

  /* Hero */
  .contact-hero {
    background: linear-gradient(
      135deg,
      var(--contact-primary-dark) 0%,
      var(--contact-primary) 100%
    );
    padding: 80px 0 96px;
    position: relative;
    color: white;
  }
  .contact-hero-content {
    max-width: 720px;
    text-align: center;
    margin: 0 auto;
  }
  .contact-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--contact-primary-light);
    margin-bottom: 12px;
  }
  .contact-eyebrow::before,
  .contact-eyebrow::after {
    content: "";
    display: block;
    width: 24px;
    height: 1.5px;
    background: currentColor;
    opacity: 0.6;
  }
  .contact-hero h1 {
    font-family: "Playfair Display", serif;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 16px;
  }
  .contact-hero p {
    font-size: 1.05rem;
    opacity: 0.9;
    line-height: 1.6;
  }
  .contact-hero-wave {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    line-height: 0;
  }
  .contact-hero-wave svg {
    width: 100%;
    height: 40px;
    display: block;
  }

  /* Contact Info Cards */
  .contact-info {
    padding: 64px 0;
    background: var(--contact-surface);
  }
  .contact-info-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .contact-info-card {
    text-align: center;
    padding: 28px 20px;
    background: var(--contact-bg);
    border-radius: var(--contact-radius);
    border: 1px solid var(--contact-border);
    transition:
      transform 0.3s var(--contact-ease),
      box-shadow 0.3s;
  }
  .contact-info-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--contact-shadow);
  }
  .contact-info-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 16px;
    background: rgba(0, 150, 199, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    color: var(--contact-primary);
  }
  .contact-info-card h3 {
    font-family: "Playfair Display", serif;
    font-size: 1.1rem;
    margin-bottom: 10px;
    color: var(--contact-text);
  }
  .contact-info-card p {
    font-size: 0.88rem;
    color: var(--contact-text-light);
    margin: 4px 0;
    line-height: 1.5;
  }
  .contact-info-card p strong {
    color: var(--contact-text);
  }

  /* Contact Form Section */
  .contact-form-section {
    padding: 64px 0;
    background: var(--contact-bg);
  }
  .contact-form-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 48px;
  }
  .contact-form-header {
    margin-bottom: 32px;
  }
  .contact-form-header h2 {
    font-family: "Playfair Display", serif;
    font-size: 1.8rem;
    color: var(--contact-text);
    margin-bottom: 8px;
  }
  .contact-form-header p {
    color: var(--contact-text-light);
  }
  .contact-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .contact-form-group {
    display: flex;
    flex-direction: column;
  }
  .contact-form-group label {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--contact-text);
    margin-bottom: 6px;
  }
  .contact-form-group .required {
    color: #e74c3c;
  }
  .contact-form-group input,
  .contact-form-group select,
  .contact-form-group textarea {
    padding: 12px 16px;
    border: 1px solid var(--contact-border);
    border-radius: 8px;
    font-family: inherit;
    font-size: 0.95rem;
    background: var(--contact-surface);
    transition:
      border-color 0.3s,
      box-shadow 0.3s;
  }
  .contact-form-group input:focus,
  .contact-form-group select:focus,
  .contact-form-group textarea:focus {
    outline: none;
    border-color: var(--contact-primary);
    box-shadow: 0 0 0 3px rgba(0, 150, 199, 0.15);
  }
  .contact-form-group textarea {
    resize: vertical;
  }
  .contact-form-group:has(textarea) {
    grid-column: 1 / -1;
  }
  .contact-form-submit {
    grid-column: 1 / -1;
    align-items: center;
    margin-top: 8px;
  }
  .contact-btn-submit {
    background: var(--contact-green);
    color: white;
    border: none;
    padding: 14px 36px;
    font-size: 1rem;
    cursor: pointer;
    border-radius: 8px;
    font-weight: 700;
    transition:
      background 0.3s,
      transform 0.2s;
  }
  .contact-btn-submit:hover {
    background: var(--contact-green-dark);
    transform: translateY(-2px);
  }
  .contact-form-note {
    font-size: 0.8rem;
    color: var(--contact-text-light);
    margin-top: 12px;
    text-align: center;
  }

  /* Map Column */
  .contact-map-col {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .contact-map-card {
    background: var(--contact-surface);
    border-radius: var(--contact-radius);
    padding: 24px;
    border: 1px solid var(--contact-border);
    box-shadow: var(--contact-shadow);
  }
  .contact-map-card h3 {
    font-family: "Playfair Display", serif;
    font-size: 1.3rem;
    color: var(--contact-text);
    margin-bottom: 16px;
  }
  .contact-map-wrapper {
    border-radius: 8px;
    overflow: hidden;
  }
  .contact-map-wrapper iframe {
    width: 100%;
    height: 350px;
    display: block;
  }
  .contact-address-details {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--contact-border);
  }
  .contact-address-details p {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.9rem;
    color: var(--contact-text-light);
    margin: 8px 0;
  }
  .contact-address-details p i {
    color: var(--contact-primary);
    margin-top: 4px;
    width: 18px;
  }
  .contact-address-details p strong {
    color: var(--contact-text);
  }

  /* Social Links */
  .contact-social {
    background: var(--contact-surface);
    border-radius: var(--contact-radius);
    padding: 24px;
    border: 1px solid var(--contact-border);
    text-align: center;
    box-shadow: var(--contact-shadow);
  }
  .contact-social h3 {
    font-family: "Playfair Display", serif;
    font-size: 1.3rem;
    color: var(--contact-text);
    margin-bottom: 16px;
  }
  .contact-social-links {
    display: flex;
    gap: 16px;
    justify-content: center;
  }
  .contact-social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--contact-bg);
    color: var(--contact-primary);
    font-size: 1.2rem;
    transition: all 0.3s var(--contact-ease);
    text-decoration: none;
    border: 1px solid var(--contact-border);
  }
  .contact-social-links a:hover {
    background: var(--contact-primary);
    color: white;
    transform: translateY(-4px);
    border-color: var(--contact-primary);
  }

  /* Quick Links */
  .contact-quick-links {
    padding: 64px 0;
    background: var(--contact-surface);
  }
  .contact-quick-links-card {
    max-width: 800px;
    margin: 0 auto;
    background: var(--contact-bg);
    border-radius: var(--contact-radius);
    padding: 40px;
    text-align: center;
    border: 1px solid var(--contact-border);
  }
  .contact-quick-links-card h3 {
    font-family: "Playfair Display", serif;
    font-size: 1.5rem;
    color: var(--contact-text);
    margin-bottom: 24px;
  }
  .contact-quick-links-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
  .contact-quick-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: var(--contact-surface);
    border: 1px solid var(--contact-border);
    border-radius: 100px;
    color: var(--contact-text);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
    transition: all 0.3s var(--contact-ease);
  }
  .contact-quick-link i {
    color: var(--contact-primary);
    font-size: 0.7rem;
  }
  .contact-quick-link:hover {
    background: var(--contact-primary);
    color: white;
    border-color: var(--contact-primary);
    transform: translateY(-2px);
  }
  .contact-quick-link:hover i {
    color: white;
  }

  /* CTA Banner */
  .contact-cta {
    padding: 64px 0;
    background: linear-gradient(
      135deg,
      var(--contact-primary-dark) 0%,
      var(--contact-primary) 100%
    );
    color: white;
  }
  .contact-cta-card {
    text-align: center;
    max-width: 680px;
    margin: 0 auto;
  }
  .contact-cta-card h2 {
    font-family: "Playfair Display", serif;
    font-size: 2rem;
    margin-bottom: 16px;
  }
  .contact-cta-card p {
    margin-bottom: 32px;
    opacity: 0.9;
  }
  .contact-cta-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Buttons */
  .contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.2s,
      background 0.2s,
      box-shadow 0.2s;
    border: 2px solid transparent;
  }
  .contact-btn:hover {
    transform: translateY(-2px);
  }
  .contact-btn-green {
    background: var(--contact-green);
    color: white;
  }
  .contact-btn-green:hover {
    background: var(--contact-green-dark);
  }
  .contact-btn-white {
    background: white;
    color: var(--contact-primary);
  }
  .contact-btn-white:hover {
    background: #e0f5fc;
  }
  .contact-btn-outline-light {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.6);
    color: white;
  }
  .contact-btn-outline-light:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: white;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .contact-info-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .contact-form-grid {
      grid-template-columns: 1fr;
