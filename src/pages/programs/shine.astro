---
// src/pages/programs/shine.astro
import Layout from "../../layouts/Layout.astro";

// Breadcrumb data
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Programmes", href: "/programs" },
  { label: "SHINE Project", href: "/programs/shine" },
];

// Related programmes for interlinking
const relatedProgrammes = [
  {
    title: "Physical Rehabilitation & Corrective Surgeries",
    href: "/programs/physical-rehabilitation",
    description: "SHINE strengthens access to orthopaedic surgeries, physiotherapy, and assistive technology.",
    icon: "fas fa-scalpel",
  },
  {
    title: "Community Based Inclusive Development (CBID)",
    href: "/programs/cbid",
    description: "Early identification and referral pathways are key components of SHINE's societal track.",
    icon: "fas fa-hand-holding-heart",
  },
  {
    title: "Stakeholder Capacity Building",
    href: "/programs/capacity-building",
    description: "SHINE invests in training rehabilitation personnel and improving data capture tools.",
    icon: "fas fa-chalkboard-user",
  },
  {
    title: "BEN MAPP II",
    href: "/programs/ben-mapp-ii",
    description: "Another multi‑annual programme complementing SHINE in the same counties.",
    icon: "fas fa-building",
  },
];

// Key needs from document
const keyNeeds = [
  "Limited availability of quality rehabilitative services and assistive technology in communities and at primary and secondary healthcare levels.",
  "Insufficient skilled rehabilitation personnel, including physiotherapists, occupational therapists, and rehabilitation technicians.",
  "Fragmented production and provision of assistive products.",
  "Limited coordination among different organisations providing rehabilitation services.",
  "Weak and delayed referral pathways linking community, primary, and specialised care.",
  "Limited integration of rehabilitation services within county health systems.",
  "Lack of knowledge and consistent use of data capture tools, resulting in deficiencies in accurate data for decision‑making.",
];

// Twin tracks
const twinTracks = [
  {
    title: "Individual Track",
    icon: "fas fa-user",
    description: "Empower persons with functional limitations and their families through improved access to quality orthopaedic surgeries, assistive products, rehabilitation and social protection services.",
  },
  {
    title: "Societal Track",
    icon: "fas fa-building-columns",
    description: "Educate and equip healthcare systems, communities, and county governments to create lasting inclusive change.",
  },
];

// Images
const heroImg = "/images/programs/shine-project-a.webp";
const partnerImg = "/images/partners/cbm-global.webp";
---

<Layout title="SHINE Project 2026–2029 | Nyabondo Centre for Persons with Disabilities">
  <!-- Breadcrumbs -->
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <div class="container">
      <ol>
        {breadcrumbs.map((crumb, i) => (
          <li>
            {i < breadcrumbs.length - 1 ? (
              <a href={crumb.href}>{crumb.label}</a>
            ) : (
              <span aria-current="page">{crumb.label}</span>
            )}
            {i < breadcrumbs.length - 1 && (
              <i class="fas fa-chevron-right" aria-hidden="true"></i>
            )}
          </li>
        ))}
      </ol>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="programme-hero">
    <div class="container">
      <div class="programme-hero-grid">
        <div class="programme-hero-content">
          <span class="section-eyebrow">Flagship Programme 2026–2029</span>
          <h1 class="programme-title">
            The <span class="accent">SHINE</span> Project
          </h1>
          <p class="programme-acronym">
            <strong>S</strong>trengthening capacities for <strong>H</strong>olistic and <strong>I</strong>nclusive
            <strong>N</strong>eed-based rehabilitative services that <strong>E</strong>mpower individuals and communities
          </p>
          <p class="programme-lead">
            A multi‑annual programme supported by Christian Blind Mission (CBM),
            transforming rehabilitation services across Kisumu and Homa Bay Counties.
          </p>
          <div class="programme-hero-stats">
            <div class="stat">
              <span class="stat-num">2026–2029</span>
              <span class="stat-label">Programme Duration</span>
            </div>
            <div class="stat">
              <span class="stat-num">2</span>
              <span class="stat-label">Counties</span>
            </div>
            <div class="stat">
              <span class="stat-num">Twin‑Track</span>
              <span class="stat-label">Approach</span>
            </div>
          </div>
        </div>
        <div class="programme-hero-image">
          <picture>
            <source srcset={heroImg} type="image/webp" />
            <img
              src={heroImg}
              alt="CBM and Nyabondo SHINE Project activities in Kisumu and Homa Bay Counties"
              loading="eager"
              width="640"
              height="480"
            />
          </picture>
          <div class="image-credit" aria-hidden="true">SHINE Project implementation</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Partner & Counties -->
  <section class="partner-info" aria-labelledby="partner-heading">
    <div class="container">
      <div class="partner-card reveal-up">
        <div class="partner-logo">
          <picture>
            <source srcset={partnerImg} type="image/webp" />
            <img src={partnerImg} alt="Christian Blind Mission (CBM) logo" loading="lazy" />
          </picture>
        </div>
        <div class="partner-text">
          <h2 id="partner-heading">Supported by Christian Blind Mission (CBM)</h2>
          <p>
            The SHINE Project is made possible through the generous support of
            Christian Blind Mission, a global disability and development
            organisation working to improve the quality of life of persons with
            disabilities in the world's poorest communities.
          </p>
          <div class="location-badge">
            <i class="fas fa-map-marker-alt"></i> Implementing in Kisumu County & Homa Bay County
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Needs Addressed -->
  <section class="needs" aria-labelledby="needs-heading">
    <div class="container">
      <div class="section-header reveal-up">
        <span class="section-eyebrow">Why SHINE?</span>
        <h2 id="needs-heading" class="section-title">Critical Gaps the Project Addresses</h2>
        <p class="section-subtitle">
          Through extensive consultation, the SHINE Project targets seven key
          barriers to quality rehabilitation in Kenya.
        </p>
      </div>
      <div class="needs-grid reveal-up">
        {keyNeeds.map((need, i) => (
          <div class="need-card" style={`--delay: ${i * 50}ms`}>
            <i class="fas fa-circle-exclamation"></i>
            <p>{need}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Twin Track Approach -->
  <section class="twin-track" aria-labelledby="track-heading">
    <div class="container">
      <div class="section-header reveal-up">
        <span class="section-eyebrow">Our Strategy</span>
        <h2 id="track-heading" class="section-title">A Twin‑Track Approach for Sustainable Change</h2>
        <p class="section-subtitle">
          The SHINE Programme creates change at both the individual and societal levels.
        </p>
      </div>
      <div class="tracks-grid">
        {twinTracks.map((track, i) => (
          <div class="track-card reveal-up" style={`--delay: ${i * 100}ms`}>
            <div class="track-icon"><i class={track.icon}></i></div>
            <h3>{track.title}</h3>
            <p>{track.description}</p>
            <div class="track-highlights">
              {track.title === "Individual Track" ? (
                <>
                  <span><i class="fas fa-scalpel"></i> Orthopaedic surgeries</span>
                  <span><i class="fas fa-wheelchair"></i> Assistive products</span>
                  <span><i class="fas fa-hand-holding-heart"></i> Rehabilitation & social protection</span>
                </>
              ) : (
                <>
                  <span><i class="fas fa-hospital-user"></i> Healthcare systems</span>
                  <span><i class="fas fa-people-group"></i> Communities</span>
                  <span><i class="fas fa-building"></i> County governments</span>
                </>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Key Interventions -->
  <section class="interventions" aria-labelledby="interventions-heading">
    <div class="container">
      <div class="section-header reveal-up">
        <span class="section-eyebrow">What SHINE Does</span>
        <h2 id="interventions-heading" class="section-title">Key Interventions</h2>
        <p class="section-subtitle">
          The project focuses on improving rehabilitation and health facilities
          through vital infrastructure, equipment, and cutting‑edge assistive
          technology, alongside comprehensive training for healthcare personnel.
        </p>
      </div>
      <div class="interventions-grid">
        <div class="intervention-card">
          <i class="fas fa-building"></i>
          <h3>Infrastructure & Equipment</h3>
          <p>Upgrading rehabilitation facilities with vital infrastructure and modern equipment to deliver quality services.</p>
        </div>
        <div class="intervention-card">
          <i class="fas fa-microchip"></i>
          <h3>Assistive Technology</h3>
          <p>Introducing cutting‑edge assistive products and strengthening local production and provision systems.</p>
        </div>
        <div class="intervention-card">
          <i class="fas fa-graduation-cap"></i>
          <h3>Personnel Training</h3>
          <p>Upgrading skills of physiotherapists, occupational therapists, and rehabilitation technicians.</p>
        </div>
        <div class="intervention-card">
          <i class="fas fa-chart-line"></i>
          <h3>Data Systems</h3>
          <p>Introducing consistent data capture tools for accurate decision‑making and referral tracking.</p>
        </div>
        <div class="intervention-card">
          <i class="fas fa-handshake"></i>
          <h3>Coordination & Referrals</h3>
          <p>Strengthening coordination among organisations and establishing clear referral pathways.</p>
        </div>
        <div class="intervention-card">
          <i class="fas fa-chart-simple"></i>
          <h3>County Health Integration</h3>
          <p>Working with county health systems to embed rehabilitation services into primary and secondary care.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Thematic Focus Areas from Document (expanded) -->
  <section class="themes" aria-labelledby="themes-heading">
    <div class="container">
      <div class="themes-grid reveal-up">
        <div class="themes-text">
          <span class="section-eyebrow">Holistic Impact</span>
          <h2 id="themes-heading">Beyond Clinical Services</h2>
          <p>
            While physical rehabilitation is central, the SHINE Project recognises
            that sustainable change requires addressing social protection,
            community awareness, and county government commitment.
          </p>
          <ul>
            <li><i class="fas fa-check-circle"></i> Linkages to cash transfer programmes for persons with severe disabilities</li>
            <li><i class="fas fa-check-circle"></i> Community awareness campaigns to reduce stigma</li>
            <li><i class="fas fa-check-circle"></i> County government advocacy for inclusive health budgets</li>
            <li><i class="fas fa-check-circle"></i> Empowerment of OPDs to demand quality services</li>
          </ul>
        </div>
        <div class="themes-image">
          <picture>
            <source srcset="/images/hero/hero-community-outreach.webp" type="image/webp" />
            <img
              src="/images/hero/hero-community-outreach.webp"
              alt="Community outreach as part of SHINE Project"
              loading="lazy"
            />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <!-- Expected Outcomes -->
  <section class="outcomes" aria-labelledby="outcomes-heading">
    <div class="container">
      <div class="section-header reveal-up">
        <span class="section-eyebrow">Measuring Success</span>
        <h2 id="outcomes-heading" class="section-title">Expected Outcomes by 2029</h2>
      </div>
      <div class="outcomes-grid">
        <div class="outcome-card">
          <div class="outcome-num">1</div>
          <h3>Improved Access</h3>
          <p>Increased number of persons with functional limitations accessing quality orthopaedic surgeries, assistive products, and rehabilitation.</p>
        </div>
        <div class="outcome-card">
          <div class="outcome-num">2</div>
          <h3>Skilled Workforce</h3>
          <p>More trained rehabilitation personnel delivering evidence‑based care at primary and secondary levels.</p>
        </div>
        <div class="outcome-card">
          <div class="outcome-num">3</div>
          <h3>Stronger Systems</h3>
          <p>County health systems that have integrated rehabilitation services and sustainable assistive technology provision.</p>
        </div>
        <div class="outcome-card">
          <div class="outcome-num">4</div>
          <h3>Effective Referrals</h3>
          <p>Functional referral pathways between community, primary, and specialised care with consistent data tracking.</p>
        </div>
        <div class="outcome-card">
          <div class="outcome-num">5</div>
          <h3>Inclusive Communities</h3>
          <p>Reduced stigma and increased participation of persons with disabilities in community life.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Programmes -->
  <section class="related-programmes" aria-labelledby="related-heading">
    <div class="container">
      <div class="section-header reveal-up">
        <span class="section-eyebrow">Explore More</span>
        <h2 id="related-heading" class="section-title">Related Programmes</h2>
        <p class="section-subtitle">
          SHINE works alongside other initiatives to create comprehensive support.
        </p>
      </div>
      <div class="related-grid">
        {relatedProgrammes.map((prog, i) => (
          <a href={prog.href} class="related-card reveal-up" style={`--delay: ${i * 60}ms`}>
            <div class="related-icon"><i class={prog.icon}></i></div>
            <h3>{prog.title}</h3>
            <p>{prog.description}</p>
            <span class="related-arrow"><i class="fas fa-arrow-right"></i></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-involve">
    <div class="container">
      <div class="cta-card">
        <div>
          <h2>Support the SHINE Project</h2>
          <p>
            Your contribution helps us strengthen rehabilitation services, train
            healthcare workers, and provide assistive devices to those who need them most.
          </p>
        </div>
        <div class="cta-buttons">
          <a href="/get-involved/donate" class="btn btn-green">
            <i class="fas fa-heart"></i> Donate Now
          </a>
          <a href="/get-involved/partner" class="btn btn-primary-outline">
            Partner with Us <i class="fas fa-handshake"></i>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ===== DESIGN TOKENS ===== */
  :root {
    --primary: #0096c7;
    --primary-dark: #006d94;
    --primary-light: #48b8d8;
    --secondary: #2e8b57;
    --secondary-dark: #1f6b40;
    --text: #0d2b38;
    --text-light: #2e5a6b;
    --text-muted: #5a8a99;
    --background: #f4fcff;
    --surface: #ffffff;
    --border: #c7e9f4;
    --border-light: #ddf1f9;
    --shadow-sm: 0 2px 8px rgba(0, 150, 199, 0.08);
    --shadow-md: 0 6px 24px rgba(0, 150, 199, 0.1);
    --shadow-lg: 0 16px 48px rgba(0, 150, 199, 0.12);
    --radius-md: 14px;
    --radius-lg: 22px;
    --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Breadcrumbs */
  .breadcrumbs {
    background: var(--background);
    padding: 16px 0;
    border-bottom: 1px solid var(--border-light);
  }
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .breadcrumbs li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
  }
  .breadcrumbs a {
    color: var(--primary);
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    text-decoration: underline;
  }
  .breadcrumbs i {
    font-size: 0.7rem;
    color: var(--text-muted);
  }
  .breadcrumbs span[aria-current="page"] {
    color: var(--text-light);
    font-weight: 500;
  }

  /* Section utilities */
  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--primary);
    margin-bottom: 12px;
  }
  .section-eyebrow::before,
  .section-eyebrow::after {
    content: "";
    display: block;
    width: 24px;
    height: 1.5px;
    background: currentColor;
    opacity: 0.5;
  }
  .section-title {
    font-family: "Playfair Display", serif;
    font-size: clamp(1.9rem, 3vw, 2.7rem);
    font-weight: 700;
    color: var(--text);
    line-height: 1.18;
    margin-bottom: 18px;
  }
  .section-subtitle {
    font-size: 1.05rem;
    color: var(--text-light);
    line-height: 1.75;
  }
  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 56px;
  }

  /* Hero */
  .programme-hero {
    padding: 64px 0 48px;
    background: linear-gradient(120deg, #f0fcff 0%, #ffffff 100%);
  }
  .programme-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .programme-hero-content {
    padding-right: 20px;
  }
  .programme-title {
    font-family: "Playfair Display", serif;
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    font-weight: 800;
    color: var(--text);
    margin: 16px 0 8px;
  }
  .programme-title .accent {
    color: var(--primary-light);
    background: linear-gradient(135deg, var(--primary), var(--primary-light));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .programme-acronym {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-style: italic;
    margin-bottom: 16px;
  }
  .programme-lead {
    font-size: 1.12rem;
    color: var(--text-light);
    line-height: 1.7;
    margin-bottom: 32px;
  }
  .programme-hero-stats {
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
  }
  .stat {
    text-align: left;
  }
  .stat-num {
    display: block;
    font-family: "Playfair Display", serif;
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--primary);
    line-height: 1;
  }
  .stat-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }
  .programme-hero-image {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }
  .programme-hero-image img {
    width: 100%;
    height: auto;
    display: block;
  }
  .image-credit {
    position: absolute;
    bottom: 8px;
    right: 12px;
    background: rgba(0,0,0,0.6);
    color: #eee;
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: 20px;
  }

  /* Partner Card */
  .partner-info {
    padding: 40px 0 60px;
    background: var(--surface);
  }
  .partner-card {
    display: flex;
    gap: 32px;
    align-items: center;
    background: var(--background);
    border-radius: var(--radius-lg);
    padding: 32px;
    border: 1px solid var(--border);
  }
  .partner-logo {
    flex-shrink: 0;
    width: 120px;
  }
  .partner-logo img {
    max-width: 100%;
    height: auto;
  }
  .partner-text h2 {
    font-family: "Playfair Display", serif;
    font-size: 1.5rem;
    margin-bottom: 12px;
  }
  .location-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(0, 150, 199, 0.1);
    padding: 8px 16px;
    border-radius: 40px;
    font-size: 0.85rem;
    margin-top: 16px;
  }

  /* Needs Grid */
  .needs {
    padding: 60px 0;
    background: var(--background);
  }
  .needs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .need-card {
    background: var(--surface);
    border-radius: var(--radius-md);
    padding: 20px;
    display: flex;
    gap: 14px;
    align-items: flex-start;
    border-left: 4px solid var(--primary);
    box-shadow: var(--shadow-sm);
  }
  .need-card i {
    color: var(--primary);
    font-size: 1.2rem;
    margin-top: 2px;
  }
  .need-card p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-light);
  }

  /* Twin Track */
  .twin-track {
    padding: 80px 0;
    background: linear-gradient(135deg, #0a2f3f 0%, #004b6e 100%);
    color: white;
  }
  .twin-track .section-title,
  .twin-track .section-subtitle {
    color: white;
  }
  .twin-track .section-eyebrow {
    color: var(--primary-light);
  }
  .tracks-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .track-card {
    background: rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    padding: 36px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition: transform 0.25s;
  }
  .track-card:hover {
    transform: translateY(-6px);
    background: rgba(255, 255, 255, 0.12);
  }
  .track-icon {
    font-size: 2.5rem;
    color: var(--primary-light);
    margin-bottom: 20px;
  }
  .track-card h3 {
    font-family: "Playfair Display", serif;
    font-size: 1.5rem;
    margin-bottom: 16px;
  }
  .track-card p {
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.7;
    margin-bottom: 24px;
  }
  .track-highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .track-highlights span {
    background: rgba(72, 184, 216, 0.15);
    padding: 6px 14px;
    border-radius: 40px;
    font-size: 0.8rem;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* Interventions */
  .interventions {
    padding: 80px 0;
    background: var(--surface);
  }
  .interventions-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .intervention-card {
    background: var(--background);
    border-radius: var(--radius-md);
    padding: 28px;
    text-align: center;
    border: 1px solid var(--border-light);
    transition: all 0.25s;
  }
  .intervention-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-md);
  }
  .intervention-card i {
    font-size: 2rem;
    color: var(--primary);
    margin-bottom: 16px;
  }
  .intervention-card h3 {
    font-family: "Playfair Display", serif;
    font-size: 1.2rem;
    margin-bottom: 12px;
  }
  .intervention-card p {
    font-size: 0.9rem;
    color: var(--text-light);
    line-height: 1.6;
  }

  /* Themes */
  .themes {
    padding: 80px 0;
    background: var(--background);
  }
  .themes-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .themes-text ul {
    list-style: none;
    padding: 0;
