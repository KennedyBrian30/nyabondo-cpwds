---
// src/pages/programs/physical-rehabilitation.astro
import Layout from "../../layouts/Layout.astro";

// Breadcrumb data
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Programmes", href: "/programs" },
  { label: "Physical Rehabilitation & Corrective Surgeries", href: "/programs/physical-rehabilitation" },
];

// Related programmes for interlinking
const relatedProgrammes = [
  {
    title: "Long‑term Rehabilitation for Children",
    href: "/programs/longterm-rehab",
    description: "Extended therapy for children with cerebral palsy and complex needs – often following corrective surgery.",
    icon: "fas fa-clock-rotate-left",
  },
  {
    title: "Community Based Inclusive Development (CBID)",
    href: "/programs/cbid",
    description: "Early identification and referral pathways that bring children to surgical and therapy services.",
    icon: "fas fa-hand-holding-heart",
  },
  {
    title: "Assistive Technology Devices",
    href: "/services/assistive-devices",
    description: "Custom prosthetics, orthotics, and mobility aids – provided on‑site by our orthopaedic technologists.",
    icon: "fas fa-wheelchair",
  },
  {
    title: "SHINE Project",
    href: "/programs/shine",
    description: "Strengthening rehabilitation systems, training personnel, and improving access to quality surgical and therapy services.",
    icon: "fas fa-seedling",
  },
];

// Images – reusing existing assets
const heroImg = "/images/services/service-corrective-surgery.webp";
const surgeryImg = "/images/hero/hero-surgery-child.webp";
const physioImg = "/images/services/service-therapy.webp";
const orthoImg = "/images/services/service-assistive-devices.webp";
const followupImg = "/images/hero/hero-post-op.webp";
---

<Layout title="Physical Rehabilitation & Corrective Surgeries | Nyabondo Centre for Persons with Disabilities">
  <!-- Breadcrumbs -->
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <div class="container">
      <ol>
        {breadcrumbs.map((crumb, i) => (
          <li>
            {i < breadcrumbs.length - 1 ? (
              <a href={crumb.href}>{crumb.label}</a>
            ) : (
              <span aria-current="page">{crumb.label}</span>
            )}
            {i < breadcrumbs.length - 1 && (
              <i class="fas fa-chevron-right" aria-hidden="true"></i>
            )}
          </li>
        ))}
      </ol>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="programme-hero">
    <div class="container">
      <div class="programme-hero-grid">
        <div class="programme-hero-content">
          <span class="section-eyebrow">Restoring Mobility, Rebuilding Lives</span>
          <h1 class="programme-title">
            Physical Rehabilitation <span class="accent">& Corrective Surgeries</span>
          </h1>
          <p class="programme-lead">
            High‑quality orthopaedic and reconstructive surgery, post‑operative
            care, physiotherapy, occupational therapy, and custom assistive
            devices – a complete continuum of physical rehabilitation.
          </p>
          <div class="programme-hero-stats">
            <div class="stat">
              <span class="stat-num">12,000+</span>
              <span class="stat-label">Corrective Surgeries</span>
            </div>
            <div class="stat">
              <span class="stat-num">8,500+</span>
              <span class="stat-label">Assistive Devices Given</span>
            </div>
            <div class="stat">
              <span class="stat-num">50,000+</span>
              <span class="stat-label">Patients Served</span>
            </div>
          </div>
        </div>
        <div class="programme-hero-image">
          <picture>
            <source srcset={heroImg} type="image/webp" />
            <img
              src={heroImg}
              alt="Surgeons performing a corrective orthopaedic procedure at Nyabondo Centre"
              loading="eager"
              width="640"
              height="480"
            />
          </picture>
          <div class="image-credit" aria-hidden="true">Orthopaedic surgery in progress</div>
        </div>
      </div>
    </div>
  </section>

  <!-- What is Physical Rehabilitation -->
  <section class="intro" aria-labelledby="intro-heading">
    <div class="container">
      <div class="intro-grid">
        <div class="intro-text reveal-left">
          <span class="section-eyebrow">Our Approach</span>
          <h2 id="intro-heading" class="section-title">A Complete Continuum of Rehabilitation</h2>
          <p>
            Physical rehabilitation at Nyabondo is not a single service – it is an
            integrated pathway from surgical correction to full functional
            independence. Our multidisciplinary team includes orthopaedic
            surgeons, physiotherapists, occupational therapists, orthopaedic
            technologists, and rehabilitation nurses.
          </p>
          <p>
            We treat children and adults with a wide range of conditions:
            clubfoot, cleft lip and palate, post‑burn contractures, congenital
            limb deformities, fractures, cerebral palsy‑related contractures,
            and other orthopaedic impairments.
          </p>
          <div class="intro-highlights">
            <span><i class="fas fa-scalpel"></i> Corrective Surgeries</span>
            <span><i class="fas fa-walking"></i> Physiotherapy</span>
            <span><i class="fas fa-hand-peace"></i> Occupational Therapy</span>
            <span><i class="fas fa-wheelchair"></i> Assistive Technology</span>
          </div>
        </div>
        <div class="intro-image reveal-right">
          <picture>
            <source srcset={physioImg} type="image/webp" />
            <img
              src={physioImg}
              alt="A physiotherapist working with a patient at Nyabondo"
              loading="lazy"
            />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Services -->
  <section class="services" aria-labelledby="services-heading">
    <div class="container">
      <div class="section-header reveal-up">
        <span class="section-eyebrow">What We Provide</span>
        <h2 id="services-heading" class="section-title">Comprehensive Rehabilitation Services</h2>
        <p class="section-subtitle">
          From the operating theatre to the therapy gym to the orthopaedic workshop – all under one roof.
        </p>
      </div>

      <div class="services-grid">
        <article class="service-card reveal-up">
          <div class="service-icon"><i class="fas fa-scalpel"></i></div>
          <h3>Corrective & Reconstructive Surgeries</h3>
          <p>Orthopaedic procedures including clubfoot correction, cleft lip and palate repair, post‑burn contracture release, congenital deformity correction, and fracture management.</p>
        </article>
        <article class="service-card reveal-up">
          <div class="service-icon"><i class="fas fa-stethoscope"></i></div>
          <h3>Post‑operative Reviews & Follow‑ups</h3>
          <p>Regular surgical follow‑up appointments to monitor healing, remove casts, and adjust rehabilitation plans. Our team tracks every patient long after discharge.</p>
        </article>
        <article class="service-card reveal-up">
          <div class="service-icon"><i class="fas fa-walking"></i></div>
          <h3>Physiotherapy Services</h3>
          <p>Individualised exercise programmes, gait training, strengthening, balance, and pain management – delivered by qualified physiotherapists.</p>
        </article>
        <article class="service-card reveal-up">
          <div class="service-icon"><i class="fas fa-hand-peace"></i></div>
          <h3>Occupational Therapy Services</h3>
          <p>Fine motor development, activities of daily living (feeding, dressing, writing), sensory integration, and adaptive equipment training.</p>
        </article>
        <article class="service-card reveal-up">
          <div class="service-icon"><i class="fas fa-microchip"></i></div>
          <h3>Orthopaedic Technology Services</h3>
          <p>Custom‑made prosthetics, orthotics (braces, splints), walking aids, and mobility equipment – crafted on‑site by our senior orthopaedic technologists.</p>
        </article>
        <article class="service-card reveal-up">
          <div class="service-icon"><i class="fas fa-hospital-user"></i></div>
          <h3>Inpatient Rehabilitation Care</h3>
          <p>Residential care for patients requiring intensive daily therapy following surgery or for children with complex conditions. Family accommodation available.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Surgical Conditions Spotlight -->
  <section class="conditions" aria-labelledby="conditions-heading">
    <div class="container">
      <div class="conditions-header reveal-up">
        <span class="section-eyebrow">We Treat</span>
        <h2 id="conditions-heading" class="section-title">Common Conditions We Address</h2>
      </div>
      <div class="conditions-grid">
        <div class="condition-card">
          <i class="fas fa-baby"></i>
          <h3>Clubfoot (CTEV)</h3>
          <p>Ponseti method casting and tenotomy, followed by bracing and physiotherapy.</p>
        </div>
        <div class="condition-card">
          <i class="fas fa-smile"></i>
          <h3>Cleft Lip & Palate</h3>
          <p>Reconstructive surgery with post‑operative feeding and speech support.</p>
        </div>
        <div class="condition-card">
          <i class="fas fa-hand-paper"></i>
          <h3>Post‑Burn Contractures</h3>
          <p>Release of scar tissue, skin grafting, and prolonged therapy to restore mobility.</p>
        </div>
        <div class="condition-card">
          <i class="fas fa-bone"></i>
          <h3>Congenital Limb Deformities</h3>
          <p>Corrective osteotomies, limb lengthening, and prosthetic fitting.</p>
        </div>
        <div class="condition-card">
          <i class="fas fa-brain"></i>
          <h3>Cerebral Palsy Related</h3>
          <p>Muscle release surgeries (e.g., adductor tenotomy, heel cord lengthening).</p>
        </div>
        <div class="condition-card">
          <i class="fas fa-ambulance"></i>
          <h3>Fractures & Trauma</h3>
          <p>Internal/external fixation and post‑traumatic rehabilitation.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Assistive Technology Focus -->
  <section class="assistive-tech" aria-labelledby="atech-heading">
    <div class="container">
      <div class="atech-grid">
        <div class="atech-text reveal-left">
          <span class="section-eyebrow">On‑Site Production</span>
          <h2 id="atech-heading">Orthopaedic Technology & Assistive Devices</h2>
          <p>
            Our orthopaedic workshop produces high‑quality, affordable assistive
            products tailored to each individual’s needs. From custom‑moulded
            knee‑ankle‑foot orthoses (KAFOs) to lightweight wheelchairs and
            walking frames – we ensure the right device for the right person.
          </p>
          <div class="atech-list">
            <span><i class="fas fa-check-circle"></i> Prosthetics (artificial limbs)</span>
            <span><i class="fas fa-check-circle"></i> Orthotics (braces, splints, calipers)</span>
            <span><i class="fas fa-check-circle"></i> Mobility aids (crutches, walkers, canes)</span>
            <span><i class="fas fa-check-circle"></i> Paediatric seating & standing frames</span>
          </div>
          <a href="/services/assistive-devices" class="btn-link">Learn more about assistive devices →</a>
        </div>
        <div class="atech-image reveal-right">
          <picture>
            <source srcset={orthoImg} type="image/webp" />
            <img
              src={orthoImg}
              alt="A senior orthopaedic technologist fitting a custom prosthetic limb"
              loading="lazy"
            />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <!-- Therapy and Follow‑up -->
  <section class="followup" aria-labelledby="followup-heading">
    <div class="container">
      <div class="followup-grid">
        <div class="followup-image reveal-left">
          <picture>
            <source srcset={followupImg} type="image/webp" />
            <img
              src={followupImg}
              alt="A child receiving post‑operative care and review at Nyabondo"
              loading="lazy"
            />
          </picture>
        </div>
        <div class="followup-text reveal-right">
          <span class="section-eyebrow">Continuity of Care</span>
          <h2 id="followup-heading">Post‑Surgery Rehabilitation & Long‑term Follow‑up</h2>
          <p>
            Surgery is only the beginning. Our rehabilitation team works with
            each patient for weeks or months to restore strength, mobility, and
            independence. We also conduct regular follow‑up clinics to monitor
            progress, adjust devices, and prevent relapse.
          </p>
          <div class="followup-stats">
            <div><strong>6–12 months</strong> average therapy duration after major surgery</div>
            <div><strong>98%</strong> follow‑up rate for surgical patients</div>
            <div><strong>85%</strong> achieve their functional goals</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Integration with SHINE Project -->
  <section class="integration" aria-labelledby="integration-heading">
    <div class="container">
      <div class="section-header reveal-up">
        <span class="section-eyebrow">Strengthening Systems</span>
        <h2 id="integration-heading" class="section-title">The SHINE Project (2026–2029)</h2>
        <p class="section-subtitle">
          With support from Christian Blind Mission, the SHINE Project is transforming rehabilitation services across Kisumu and Homa Bay counties.
        </p>
      </div>
      <div class="integration-card-large reveal-up">
        <div class="integration-content">
          <p>
            <strong>Key needs addressed:</strong> limited availability of quality rehabilitative services,
            insufficient skilled personnel, fragmented assistive product provision, weak referral pathways,
            and lack of data for decision‑making. The project provides vital infrastructure, equipment,
            assistive technology, and thorough training for rehabilitation personnel.
          </p>
          <div class="integration-tracks">
            <div><i class="fas fa-user"></i> <strong>Individual Track:</strong> Access to orthopaedic surgeries, assistive products, rehabilitation & social protection</div>
            <div><i class="fas fa-building"></i> <strong>Societal Track:</strong> Strengthened healthcare systems, communities, and county governments</div>
          </div>
          <a href="/programs/shine" class="btn btn-primary">Learn about SHINE →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Programmes -->
  <section class="related-programmes" aria-labelledby="related-heading">
    <div class="container">
      <div class="section-header reveal-up">
        <span class="section-eyebrow">Explore More</span>
        <h2 id="related-heading" class="section-title">Related Services & Programmes</h2>
        <p class="section-subtitle">
          Physical rehabilitation is most effective when combined with community support, economic empowerment, and long‑term care.
        </p>
      </div>
      <div class="related-grid">
        {relatedProgrammes.map((prog, i) => (
          <a href={prog.href} class="related-card reveal-up" style={`--delay: ${i * 60}ms`}>
            <div class="related-icon"><i class={prog.icon}></i></div>
            <h3>{prog.title}</h3>
            <p>{prog.description}</p>
            <span class="related-arrow"><i class="fas fa-arrow-right"></i></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-involve">
    <div class="container">
      <div class="cta-card">
        <div>
          <h2>Support Life‑Changing Surgeries & Therapy</h2>
          <p>
            Your donation can fund a corrective surgery, provide a prosthetic limb,
            or sponsor a child’s full rehabilitation programme.
          </p>
        </div>
        <div class="cta-buttons">
          <a href="/get-involved/donate" class="btn btn-green">
            <i class="fas fa-heart"></i> Donate Now
          </a>
          <a href="/get-involved/partner" class="btn btn-primary-outline">
            Partner with Us <i class="fas fa-handshake"></i>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ===== DESIGN TOKENS ===== */
  :root {
    --primary: #0096c7;
    --primary-dark: #006d94;
    --primary-light: #48b8d8;
    --secondary: #2e8b57;
    --secondary-dark: #1f6b40;
    --text: #0d2b38;
    --text-light: #2e5a6b;
    --text-muted: #5a8a99;
    --background: #f4fcff;
    --surface: #ffffff;
    --border: #c7e9f4;
    --border-light: #ddf1f9;
    --shadow-sm: 0 2px 8px rgba(0, 150, 199, 0.08);
    --shadow-md: 0 6px 24px rgba(0, 150, 199, 0.1);
    --shadow-lg: 0 16px 48px rgba(0, 150, 199, 0.12);
    --radius-md: 14px;
    --radius-lg: 22px;
    --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Breadcrumbs */
  .breadcrumbs {
    background: var(--background);
    padding: 16px 0;
    border-bottom: 1px solid var(--border-light);
  }
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .breadcrumbs li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
  }
  .breadcrumbs a {
    color: var(--primary);
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    text-decoration: underline;
  }
  .breadcrumbs i {
    font-size: 0.7rem;
    color: var(--text-muted);
  }
  .breadcrumbs span[aria-current="page"] {
    color: var(--text-light);
    font-weight: 500;
  }

  /* Section utilities */
  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--primary);
    margin-bottom: 12px;
  }
  .section-eyebrow::before,
  .section-eyebrow::after {
    content: "";
    display: block;
    width: 24px;
    height: 1.5px;
    background: currentColor;
    opacity: 0.5;
  }
  .section-title {
    font-family: "Playfair Display", serif;
    font-size: clamp(1.9rem, 3vw, 2.7rem);
    font-weight: 700;
    color: var(--text);
    line-height: 1.18;
    margin-bottom: 18px;
  }
  .section-subtitle {
    font-size: 1.05rem;
    color: var(--text-light);
    line-height: 1.75;
  }
  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 56px;
  }

  /* Hero */
  .programme-hero {
    padding: 64px 0 48px;
    background: linear-gradient(120deg, #f0fcff 0%, #ffffff 100%);
  }
  .programme-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .programme-hero-content {
    padding-right: 20px;
  }
  .programme-title {
    font-family: "Playfair Display", serif;
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    color: var(--text);
    margin: 16px 0 20px;
  }
  .programme-title .accent {
    color: var(--primary);
    border-bottom: 3px solid var(--primary-light);
    display: inline-block;
  }
  .programme-lead {
    font-size: 1.12rem;
    color: var(--text-light);
    line-height: 1.7;
    margin-bottom: 32px;
  }
  .programme-hero-stats {
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
  }
  .stat {
    text-align: left;
  }
  .stat-num {
    display: block;
    font-family: "Playfair Display", serif;
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--primary);
    line-height: 1;
  }
  .stat-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }
  .programme-hero-image {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }
  .programme-hero-image img {
    width: 100%;
    height: auto;
    display: block;
  }
  .image-credit {
    position: absolute;
    bottom: 8px;
    right: 12px;
    background: rgba(0,0,0,0.6);
    color: #eee;
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: 20px;
  }

  /* Intro */
  .intro {
    padding: 80px 0;
    background: var(--surface);
  }
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .intro-text p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-light);
    margin-bottom: 24px;
  }
  .intro-highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 16px;
  }
  .intro-highlights span {
    background: rgba(0, 150, 199, 0.08);
    padding: 6px 14px;
    border-radius: 40px;
    font-size: 0.8rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .intro-image {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  /* Services Grid */
  .services {
    padding: 80px 0;
    background: var(--background);
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .service-card {
    background: var(--surface);
    border-radius: var(--radius-md);
    padding: 28px;
    border: 1px solid var(--border-light);
    transition: all 0.25s;
  }
  .service-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-md);
    border-color: var(--primary-light);
  }
  .service-icon {
    width: 56px;
    height: 56px;
    background: rgba(0, 150, 199, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    color: var(--primary);
    margin-bottom: 24px;
  }
  .service-card h3 {
    font-family: "Playfair Display", serif;
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 12px;
  }
  .service-card p {
    color: var(--text-light);
    line-height: 1.65;
    font-size: 0.9rem;
  }

  /* Conditions Grid */
  .conditions {
    padding: 80px 0;
    background: var(--surface);
  }
  .conditions-header {
    text-align: center;
    margin-bottom: 48px;
  }
  .conditions-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .condition-card {
    background: var(--background);
    border-radius: var(--radius-md);
    padding: 24px;
    text-align: center;
    border: 1px solid var(--border);
  }
  .condition-card i {
    font-size: 2rem;
    color: var(--primary);
    margin-bottom: 12px;
  }
  .condition-card h3 {
    font-size: 1.1rem;
    margin-bottom: 8px;
  }
  .condition-card p {
    font-size: 0.85rem;
    color: var(--text-light);
  }

  /* Assistive Tech */
  .assistive-tech {
    padding: 80px 0;
    background: var(--background);
  }
  .atech-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .atech-text p {
    margin-bottom: 20px;
  }
  .atech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 24px 0;
  }
  .atech-list span {
    background: var(--surface);
    padding: 6px 14px;
    border-radius: 40px;
    font-size: 0.8rem;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid var(--border);
  }
  .btn-link {
    color: var(--primary);
    font-weight: 600;
    text-decoration: none;
  }
  .atech-image {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  /* Follow-up */
  .followup {
    padding: 80px 0;
    background: var(--surface);
  }
  .followup-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
