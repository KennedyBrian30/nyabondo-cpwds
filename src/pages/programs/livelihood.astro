---
// src/pages/programs/livelihood.astro
import Layout from "../../layouts/Layout.astro";

// Breadcrumb data
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Programmes", href: "/programs" },
  { label: "Livelihood & Economic Empowerment", href: "/programs/livelihood" },
];

// Related programmes for interlinking
const relatedProgrammes = [
  {
    title: "Community Based Inclusive Development (CBID)",
    href: "/programs/cbid",
    description: "Early identification, disability assessment, and referral pathways that connect individuals to livelihood opportunities.",
    icon: "fas fa-hand-holding-heart",
  },
  {
    title: "Social Inclusion & Protection",
    href: "/programs/social-inclusion",
    description: "Support groups, rights advocacy, and linkages to cash transfer programmes that complement economic empowerment.",
    icon: "fas fa-people-group",
  },
  {
    title: "SHINE Project",
    href: "/programs/shine",
    description: "Twin-track approach strengthening rehabilitation and social protection – a foundation for sustainable livelihoods.",
    icon: "fas fa-seedling",
  },
  {
    title: "BEN MAPP II",
    href: "/programs/ben-mapp-ii",
    description: "Five‑domain CBR programme with dedicated Inclusive Livelihood component including VSLAs, IGAs, and market access.",
    icon: "fas fa-chalkboard-user",
  },
];

// Images – reusing existing assets from the site
const heroImg = "/images/stories/story-james-vocational.webp";
const trainingImg = "/images/programs/programs-overview-1.webp";
const groupImg = "/images/hero/hero-community-outreach.webp";
const financialImg = "/images/services/service-assistive-devices.webp";
---

<Layout title="Livelihood & Economic Empowerment | Nyabondo Centre for Persons with Disabilities">
  <!-- Breadcrumbs -->
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <div class="container">
      <ol>
        {breadcrumbs.map((crumb, i) => (
          <li>
            {i < breadcrumbs.length - 1 ? (
              <a href={crumb.href}>{crumb.label}</a>
            ) : (
              <span aria-current="page">{crumb.label}</span>
            )}
            {i < breadcrumbs.length - 1 && (
              <i class="fas fa-chevron-right" aria-hidden="true"></i>
            )}
          </li>
        ))}
      </ol>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="programme-hero">
    <div class="container">
      <div class="programme-hero-grid">
        <div class="programme-hero-content">
          <span class="section-eyebrow">Economic Empowerment</span>
          <h1 class="programme-title">
            Livelihood & <span class="accent">Economic Empowerment</span>
          </h1>
          <p class="programme-lead">
            Breaking the cycle of poverty by equipping persons with disabilities
            and their families with skills, resources, and opportunities for
            sustainable income generation.
          </p>
          <div class="programme-hero-stats">
            <div class="stat">
              <span class="stat-num">5,000+</span>
              <span class="stat-label">Vocational Graduates</span>
            </div>
            <div class="stat">
              <span class="stat-num">1,200+</span>
              <span class="stat-label">Self‑Help Groups Formed</span>
            </div>
            <div class="stat">
              <span class="stat-num">80%</span>
              <span class="stat-label">Income Improvement Rate</span>
            </div>
          </div>
        </div>
        <div class="programme-hero-image">
          <picture>
            <source srcset={heroImg} type="image/webp" />
            <img
              src={heroImg}
              alt="A young man with disability confidently working at his computer business, a graduate of Nyabondo's vocational training"
              loading="eager"
              width="640"
              height="480"
            />
          </picture>
          <div class="image-credit" aria-hidden="true">James, vocational graduate & business owner</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Activities Section -->
  <section class="activities" aria-labelledby="activities-heading">
    <div class="container">
      <div class="section-header reveal-up">
        <span class="section-eyebrow">What We Do</span>
        <h2 id="activities-heading" class="section-title">
          Building Skills, Creating Opportunities
        </h2>
        <p class="section-subtitle">
          Our livelihood programme is anchored on practical training, enterprise
          development, and market linkages – ensuring that persons with
          disabilities and their caregivers achieve lasting financial independence.
        </p>
      </div>

      <div class="activities-grid">
        <!-- Vocational Skills -->
        <article class="activity-card reveal-up">
          <div class="activity-icon" aria-hidden="true">
            <i class="fas fa-graduation-cap"></i>
          </div>
          <h3>Vocational Skills Training</h3>
          <p>
            Tailoring, carpentry, agribusiness, soap making, computer literacy,
            and other market‑driven trades. Training is accessible and adapted
            to diverse functional abilities.
          </p>
        </article>

        <!-- Entrepreneurship for Caregivers -->
        <article class="activity-card reveal-up">
          <div class="activity-icon" aria-hidden="true">
            <i class="fas fa-chart-line"></i>
          </div>
          <h3>Entrepreneurship Development</h3>
          <p>
            Caregivers of children with disabilities receive business skills
            training, mentorship, and start‑up support to launch or expand
            income‑generating activities at household level.
          </p>
        </article>

        <!-- Self-Help Groups & VSLAs -->
        <article class="activity-card reveal-up">
          <div class="activity-icon" aria-hidden="true">
            <i class="fas fa-hand-holding-usd"></i>
          </div>
          <h3>Self‑Help Groups & VSLAs</h3>
          <p>
            Formation of self‑help groups and Village Savings & Loan Associations
            (VSLAs) for persons with disabilities and caregivers, promoting
            collective savings, access to small loans, and peer support.
          </p>
        </article>

        <!-- Financial Literacy -->
        <article class="activity-card reveal-up">
          <div class="activity-icon" aria-hidden="true">
            <i class="fas fa-calculator"></i>
          </div>
          <h3>Financial Literacy Training</h3>
          <p>
            Budgeting, saving, debt management, and basic bookkeeping – delivered
            in accessible formats to individuals and groups.
          </p>
        </article>

        <!-- Market Access & BDS -->
        <article class="activity-card reveal-up">
          <div class="activity-icon" aria-hidden="true">
            <i class="fas fa-store"></i>
          </div>
          <h3>Market Access & Business Development Services</h3>
          <p>
            Linkages to local markets, business development services (BDS),
            one‑off grants, seed funds, and start‑up kits to turn skills into
            sustainable enterprises.
          </p>
        </article>

        <!-- OPD Capacity Building -->
        <article class="activity-card reveal-up">
          <div class="activity-icon" aria-hidden="true">
            <i class="fas fa-building"></i>
          </div>
          <h3>Organisational Capacity Building</h3>
          <p>
            Supporting Organisations of Persons with Disabilities (OPDs) to form
            self‑help groups, access funding, and advocate for inclusive
            economic policies at county level.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Programme in Action: BEN MAPP II & SHINE -->
  <section class="project-integration" aria-labelledby="integration-heading">
    <div class="container">
      <div class="integration-header reveal-up">
        <span class="section-eyebrow">Flagship Partnerships</span>
        <h2 id="integration-heading" class="section-title">
          Livelihood at Scale: Multi‑Annual Projects
        </h2>
        <p class="section-subtitle">
          Our livelihood work is embedded in two major programmes that reach
          thousands of households across Kisumu and Homa Bay counties.
        </p>
      </div>

      <div class="integration-grid">
        <!-- BEN MAPP II Card -->
        <div class="integration-card reveal-up">
          <div class="card-badge">BEN MAPP II</div>
          <h3>Inclusive Livelihood Domain</h3>
          <p>
            Under the 5‑year BEN MAPP II project (Cheshire Disability Services
            Kenya), we mobilise households with children or youth with
            disabilities into productive self‑help groups. Activities include
            household‑level livelihood skills training (tailoring, agribusiness,
            soap making, carpentry), provision of start‑up kits, seed funds,
            one‑off grants, and business development services.
          </p>
          <div class="highlight-list">
            <span><i class="fas fa-check-circle"></i> VSLAs & IGAs</span>
            <span><i class="fas fa-check-circle"></i> Climate‑smart agribusiness</span>
            <span><i class="fas fa-check-circle"></i> Market linkages</span>
          </div>
          <a href="/programs/ben-mapp-ii" class="btn-link">
            Learn about BEN MAPP II <i class="fas fa-arrow-right"></i>
          </a>
        </div>

        <!-- SHINE Project Card -->
        <div class="integration-card reveal-up">
          <div class="card-badge">SHINE Project 2026–2029</div>
          <h3>Twin‑Track Economic Empowerment</h3>
          <p>
            Supported by Christian Blind Mission, the SHINE Project works on two
            tracks: <strong>individual track</strong> (access to orthopaedic
            surgeries, assistive products, rehabilitation and social protection)
            and <strong>societal track</strong> (strengthening healthcare
            systems and county governments). Improved health and functional
            ability directly enable participation in livelihood activities.
          </p>
          <div class="highlight-list">
            <span><i class="fas fa-check-circle"></i> Social protection linkages</span>
            <span><i class="fas fa-check-circle"></i> Rehabilitation for employability</span>
            <span><i class="fas fa-check-circle"></i> County system strengthening</span>
          </div>
          <a href="/programs/shine" class="btn-link">
            Explore SHINE Project <i class="fas fa-arrow-right"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Success Spotlight -->
  <section class="success-spotlight" aria-labelledby="spotlight-heading">
    <div class="container">
      <div class="spotlight-wrapper">
        <div class="spotlight-text reveal-left">
          <span class="section-eyebrow">Real Impact</span>
          <h2 id="spotlight-heading">From Trainee to Business Owner</h2>
          <blockquote>
            "After completing the computer skills training at Nyabondo, I could
            not imagine running my own cyber café. Today, I employ two other
            youth from my village. The start‑up kit and mentorship gave me the
            confidence I needed."
          </blockquote>
          <cite>— James, 24, Vocational Graduate</cite>
          <div class="spotlight-stats">
            <div>
              <span class="stat-num">300%</span>
              <span class="stat-label">increase in his monthly income</span>
            </div>
            <div>
              <span class="stat-num">15</span>
              <span class="stat-label">youth with disabilities he has trained</span>
            </div>
          </div>
        </div>
        <div class="spotlight-image reveal-right">
          <picture>
            <source srcset="/images/stories/story-james-vocational.webp" type="image/webp" />
            <img
              src="/images/stories/story-james-vocational.webp"
              alt="James working at his computer business"
              loading="lazy"
            />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Programmes (Interlinking) -->
  <section class="related-programmes" aria-labelledby="related-heading">
    <div class="container">
      <div class="section-header reveal-up">
        <span class="section-eyebrow">Explore More</span>
        <h2 id="related-heading" class="section-title">Related Programmes</h2>
        <p class="section-subtitle">
          Livelihood empowerment works best when combined with other interventions.
          Discover how our other programme clusters support economic inclusion.
        </p>
      </div>
      <div class="related-grid">
        {relatedProgrammes.map((prog, i) => (
          <a href={prog.href} class="related-card reveal-up" style={`--delay: ${i * 60}ms`}>
            <div class="related-icon" aria-hidden="true">
              <i class={prog.icon}></i>
            </div>
            <h3>{prog.title}</h3>
            <p>{prog.description}</p>
            <span class="related-arrow"><i class="fas fa-arrow-right"></i></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA to Get Involved -->
  <section class="cta-involve">
    <div class="container">
      <div class="cta-card">
        <div>
          <h2>Support Economic Empowerment</h2>
          <p>
            Your donation can provide a start‑up kit, fund vocational training,
            or help a self‑help group access seed capital.
          </p>
        </div>
        <div class="cta-buttons">
          <a href="/get-involved/donate" class="btn btn-green">
            <i class="fas fa-heart"></i> Donate Now
          </a>
          <a href="/get-involved/partner" class="btn btn-primary-outline">
            Become a Partner <i class="fas fa-handshake"></i>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ===== DESIGN TOKENS ===== */
  :root {
    --primary: #0096c7;
    --primary-dark: #006d94;
    --primary-light: #48b8d8;
    --secondary: #2e8b57;
    --secondary-dark: #1f6b40;
    --text: #0d2b38;
    --text-light: #2e5a6b;
    --text-muted: #5a8a99;
    --background: #f4fcff;
    --surface: #ffffff;
    --border: #c7e9f4;
    --border-light: #ddf1f9;
    --shadow-sm: 0 2px 8px rgba(0, 150, 199, 0.08);
    --shadow-md: 0 6px 24px rgba(0, 150, 199, 0.1);
    --shadow-lg: 0 16px 48px rgba(0, 150, 199, 0.12);
    --radius-md: 14px;
    --radius-lg: 22px;
    --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Breadcrumbs */
  .breadcrumbs {
    background: var(--background);
    padding: 16px 0;
    border-bottom: 1px solid var(--border-light);
  }
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .breadcrumbs li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
  }
  .breadcrumbs a {
    color: var(--primary);
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    text-decoration: underline;
  }
  .breadcrumbs i {
    font-size: 0.7rem;
    color: var(--text-muted);
  }
  .breadcrumbs span[aria-current="page"] {
    color: var(--text-light);
    font-weight: 500;
  }

  /* Section utilities */
  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--primary);
    margin-bottom: 12px;
  }
  .section-eyebrow::before,
  .section-eyebrow::after {
    content: "";
    display: block;
    width: 24px;
    height: 1.5px;
    background: currentColor;
    opacity: 0.5;
  }
  .section-title {
    font-family: "Playfair Display", serif;
    font-size: clamp(1.9rem, 3vw, 2.7rem);
    font-weight: 700;
    color: var(--text);
    line-height: 1.18;
    margin-bottom: 18px;
  }
  .section-subtitle {
    font-size: 1.05rem;
    color: var(--text-light);
    line-height: 1.75;
  }
  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 56px;
  }

  /* Hero */
  .programme-hero {
    padding: 64px 0 48px;
    background: linear-gradient(120deg, #f0fcff 0%, #ffffff 100%);
  }
  .programme-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .programme-hero-content {
    padding-right: 20px;
  }
  .programme-title {
    font-family: "Playfair Display", serif;
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    color: var(--text);
    margin: 16px 0 20px;
  }
  .programme-title .accent {
    color: var(--primary);
    border-bottom: 3px solid var(--primary-light);
    display: inline-block;
  }
  .programme-lead {
    font-size: 1.12rem;
    color: var(--text-light);
    line-height: 1.7;
    margin-bottom: 32px;
  }
  .programme-hero-stats {
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
  }
  .stat {
    text-align: left;
  }
  .stat-num {
    display: block;
    font-family: "Playfair Display", serif;
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--primary);
    line-height: 1;
  }
  .stat-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }
  .programme-hero-image {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }
  .programme-hero-image img {
    width: 100%;
    height: auto;
    display: block;
  }
  .image-credit {
    position: absolute;
    bottom: 8px;
    right: 12px;
    background: rgba(0,0,0,0.6);
    color: #eee;
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: 20px;
  }

  /* Activities Grid */
  .activities {
    padding: 80px 0;
    background: var(--background);
  }
  .activities-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .activity-card {
    background: var(--surface);
    border-radius: var(--radius-md);
    padding: 28px;
    border: 1px solid var(--border-light);
    transition: all 0.25s var(--ease-out-expo);
  }
  .activity-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-md);
    border-color: var(--primary-light);
  }
  .activity-icon {
    width: 56px;
    height: 56px;
    background: rgba(0, 150, 199, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    color: var(--primary);
    margin-bottom: 24px;
  }
  .activity-card h3 {
    font-family: "Playfair Display", serif;
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 12px;
  }
  .activity-card p {
    color: var(--text-light);
    line-height: 1.65;
    font-size: 0.9rem;
  }

  /* Project Integration Cards */
  .project-integration {
    padding: 80px 0;
    background: var(--surface);
  }
  .integration-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .integration-card {
    background: linear-gradient(145deg, #ffffff, #f8fefc);
    border-radius: var(--radius-lg);
    padding: 32px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    transition: transform 0.25s;
  }
  .integration-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  .card-badge {
    display: inline-block;
    background: var(--primary-light);
    color: white;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 4px 12px;
    border-radius: 40px;
    letter-spacing: 0.05em;
    margin-bottom: 20px;
  }
  .integration-card h3 {
    font-family: "Playfair Display", serif;
    font-size: 1.4rem;
    margin-bottom: 16px;
  }
  .integration-card p {
    color: var(--text-light);
    line-height: 1.7;
    margin-bottom: 20px;
  }
  .highlight-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 24px;
  }
  .highlight-list span {
    font-size: 0.8rem;
    background: rgba(46, 139, 87, 0.08);
    padding: 4px 12px;
    border-radius: 40px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .highlight-list i {
    color: var(--secondary);
  }
  .btn-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    color: var(--primary);
    text-decoration: none;
  }
  .btn-link:hover {
    gap: 12px;
    color: var(--secondary);
  }

  /* Success Spotlight */
  .success-spotlight {
    padding: 80px 0;
    background: var(--background);
  }
  .spotlight-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .spotlight-text blockquote {
    font-size: 1.2rem;
    font-style: italic;
    color: var(--text);
    border-left: 4px solid var(--primary);
    padding-left: 24px;
    margin: 24px 0;
    line-height: 1.6;
  }
  .spotlight-text cite {
    font-weight: 700;
    color: var(--primary-dark);
    font-style: normal;
    display: block;
    margin-bottom: 24px;
  }
  .spotlight-stats {
    display: flex;
    gap: 32px;
    margin-top: 20px;
  }
  .spotlight-image {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }
  .spotlight-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Related Programmes */
  .related-programmes {
    padding: 80px 0;
    background: var(--surface);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }
  .related-card {
    background: var(--background);
    border-radius: var(--radius-md);
    padding: 28px 20px;
    text-decoration: none;
    border: 1px solid var(--border-light);
    transition: all 0.25s;
    display: block;
    position: relative;
  }
  .related-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-md);
    border-color: var(--primary);
  }
  .related-icon {
    font-size: 1.8rem;
    color: var(--primary);
    margin-bottom: 16px;
  }
  .related-card h3 {
    font-family: "Playfair Display", serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 8px;
  }
  .related-card p {
    font-size: 0.85rem;
    color: var(--text-light);
    line-height: 1.55;
  }
  .related-arrow {
    position: absolute;
    bottom: 20px;
    right: 20px;
    color: var(--primary-light);
    transition: transform 0.2s;
  }
  .related-card:hover .related-arrow {
    transform: translateX(4px);
    color: var(--primary);
  }

  /* CTA */
  .cta-involve {
    padding: 60px 0 80px;
  }
  .cta-card {
    background: linear-gradient(115deg, var(--primary-dark) 0%, var(--primary) 100%);
    border-radius: var(--radius-lg);
    padding: 48px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
    flex-wrap: wrap;
  }
  .cta-card h2 {
    font-family: "Playfair Display", serif;
    font-size: 1.8rem;
    color: white;
    margin-bottom: 12px;
  }
  .cta-card p {
    color: rgba(255,255,255,0.85);
    max-width: 500px;
  }
  .cta-buttons {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .btn {
