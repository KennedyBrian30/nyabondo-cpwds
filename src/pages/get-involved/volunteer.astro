---
// src/pages/get-involved/volunteer.astro
import Layout from "../../layouts/Layout.astro";

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Get Involved", href: "/get-involved" },
  { label: "Volunteer", href: "/get-involved/volunteer" },
];

const volunteerRoles = [
  {
    title: "Medical Volunteers",
    description:
      "Doctors, surgeons, nurses, physiotherapists, occupational therapists, and clinical officers.",
    commitment: "Flexible – 1 week to 3 months",
    requirements:
      "Valid license/degree, experience in rehabilitation preferred.",
  },
  {
    title: "Therapy Assistants",
    description:
      "Help with exercises, mobilise patients, prepare therapy equipment.",
    commitment: "2–4 weeks minimum",
    requirements:
      "Basic physiotherapy knowledge or training; empathy and patience.",
  },
  {
    title: "Orthopaedic Technologist / Prosthetist",
    description:
      "Assist in orthopaedic workshop: fabricate and repair assistive devices.",
    commitment: "1 month or longer",
    requirements: "Diploma in Orthopaedic Technology or relevant experience.",
  },
  {
    title: "Vocational Trainers",
    description:
      "Teach tailoring, computer literacy, hairdressing, shoemaking, or basket weaving.",
    commitment: "2 weeks minimum",
    requirements:
      "Expertise in the trade, ability to teach youths with disabilities.",
  },
  {
    title: "Administrative Support",
    description:
      "Help with data entry, donor communication, social media, photography, grant writing.",
    commitment: "Flexible – remote or onsite",
    requirements: "Computer literacy, communication skills.",
  },
  {
    title: "Maintenance & Logistics",
    description:
      "Assist with facility upkeep, equipment repair, driving, or organising material donations.",
    commitment: "Flexible",
    requirements:
      "Practical skills, valid driving license for transport roles.",
  },
];
---

<Layout title="Volunteer | Nyabondo Centre for Persons with Disabilities">
  <!-- BREADCRUMB -->
  <nav class="volunteer-bc" aria-label="Breadcrumb">
    <div class="volunteer-container">
      <ol>
        {
          breadcrumbs.map((c, i) => (
            <li>
              {i < breadcrumbs.length - 1 ? (
                <a href={c.href}>{c.label}</a>
              ) : (
                <span aria-current="page">{c.label}</span>
              )}
              {i < breadcrumbs.length - 1 && (
                <i class="fas fa-chevron-right" aria-hidden="true" />
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </nav>

  <!-- HERO -->
  <section class="volunteer-hero">
    <div class="volunteer-container">
      <div class="volunteer-hero-content">
        <span class="volunteer-eyebrow">Give Your Time</span>
        <h1>Volunteer at Nyabondo</h1>
        <p>
          Share your skills, learn from our team, and make a tangible difference
          in the lives of persons with disabilities. Volunteers are a vital part
          of our family.
        </p>
      </div>
    </div>
    <div class="volunteer-hero-wave" aria-hidden="true">
      <svg viewBox="0 0 1440 40" preserveAspectRatio="none">
        <path
          d="M0,40 C240,20 480,0 720,20 C960,40 1200,20 1440,40 L1440,40 L0,40 Z"
          fill="#f4fcff"></path>
      </svg>
    </div>
  </section>

  <!-- ROLES GRID -->
  <section class="volunteer-roles">
    <div class="volunteer-container">
      <h2>Areas Where You Can Help</h2>
      <div class="volunteer-roles-grid">
        {
          volunteerRoles.map((role) => (
            <div class="volunteer-role-card">
              <h3>{role.title}</h3>
              <p>{role.description}</p>
              <div class="volunteer-role-details">
                <span>
                  <i class="fas fa-clock" /> {role.commitment}
                </span>
                <span>
                  <i class="fas fa-clipboard-list" /> {role.requirements}
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- WHY VOLUNTEER -->
  <section class="volunteer-why">
    <div class="volunteer-container">
      <div class="volunteer-why-card">
        <i class="fas fa-smile"></i>
        <h3>What You Gain</h3>
        <ul>
          <li>Hands-on experience in a rehabilitation centre</li>
          <li>Cross‑cultural exchange and community immersion</li>
          <li>Certificate of appreciation and reference letter</li>
          <li>The joy of seeing someone walk, smile, or gain independence</li>
        </ul>
        <p>Accommodation can be arranged for long‑term volunteers.</p>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="volunteer-process">
    <div class="volunteer-container">
      <h2>How to Become a Volunteer</h2>
      <div class="volunteer-steps">
        <div class="step">
          <span class="step-num">1</span>
          <div>Fill out the online application form below.</div>
        </div>
        <div class="step">
          <span class="step-num">2</span>
          <div>
            We will contact you to discuss your skills, availability, and
            placement.
          </div>
        </div>
        <div class="step">
          <span class="step-num">3</span>
          <div>Complete a simple orientation (online or onsite).</div>
        </div>
        <div class="step">
          <span class="step-num">4</span>
          <div>Start changing lives!</div>
        </div>
      </div>
    </div>
  </section>

  <!-- VOLUNTEER APPLICATION FORM -->
  <section class="volunteer-form-section" id="application-form">
    <div class="volunteer-container">
      <div class="volunteer-form-card">
        <h2>Apply to Volunteer</h2>
        
        <!-- Formspree Integration -->
        <form
          action="https://formspree.io/f/mpqvlbkn"
          method="POST"
          class="volunteer-form"
          id="volunteer-form"
        >
          <!-- Honeypot field to prevent spam -->
          <input type="text" name="_gotcha" style="display:none" />
          
          <div class="volunteer-form-row">
            <div class="form-group">
              <label for="full_name">Full Name *</label>
              <input
                type="text"
                id="full_name"
                name="full_name"
                placeholder="Enter your full name"
                required
                autocomplete="name"
              />
            </div>
            <div class="form-group">
              <label for="email">Email Address *</label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="you@example.com"
                required
                autocomplete="email"
              />
            </div>
          </div>
          
          <div class="volunteer-form-row">
            <div class="form-group">
              <label for="phone">Phone Number *</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                placeholder="+254 700 000 000"
                required
                autocomplete="tel"
              />
            </div>
            <div class="form-group">
              <label for="location">Location (City/Country)</label>
              <input
                type="text"
                id="location"
                name="location"
                placeholder="Nairobi, Kenya"
                autocomplete="address-level2"
              />
            </div>
          </div>

          <div class="form-group">
            <label for="role_interest">Primary Role Interest *</label>
            <select id="role_interest" name="role_interest" required>
              <option value="">Select a role...</option>
              <option value="Medical Volunteer">Medical Volunteer</option>
              <option value="Therapy Assistant">Therapy Assistant</option>
              <option value="Orthopaedic Technologist">Orthopaedic Technologist</option>
              <option value="Vocational Trainer">Vocational Trainer</option>
              <option value="Administrative Support">Administrative Support</option>
              <option value="Maintenance & Logistics">Maintenance & Logistics</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <div class="form-group">
            <label for="availability">Availability</label>
            <input
              type="text"
              id="availability"
              name="availability"
              placeholder="e.g., March 2026, 2 weeks"
            />
          </div>

          <div class="form-group">
            <label for="qualifications">Qualifications & Experience</label>
            <textarea
              id="qualifications"
              name="qualifications"
              rows="3"
              placeholder="Briefly describe your qualifications, skills, or relevant experience"
            ></textarea>
          </div>

          <div class="form-group">
            <label for="motivation">Why do you want to volunteer at Nyabondo?</label>
            <textarea
              id="motivation"
              name="motivation"
              rows="3"
              placeholder="Share your motivation and what you hope to contribute"
            ></textarea>
          </div>

          <div class="form-group">
            <label for="emergency_contact">Emergency Contact (Name & Phone)</label>
            <input
              type="text"
              id="emergency_contact"
              name="emergency_contact"
              placeholder="e.g., Jane Doe, +254 700 000 000"
            />
          </div>

          <!-- Hidden field to identify the form source -->
          <input type="hidden" name="_subject" value="New Volunteer Application - Nyabondo Centre" />
          
          <button type="submit" class="volunteer-btn volunteer-btn-primary" id="submit-btn">
            <span id="btn-text">Submit Application</span>
            <span id="btn-spinner" style="display:none;">
              <i class="fas fa-spinner fa-spin"></i> Submitting...
            </span>
          </button>
        </form>

        <!-- Success/Error Message -->
        <div id="form-message" style="display:none; margin-top: 20px; padding: 15px; border-radius: 6px;"></div>

        <p class="volunteer-note">
          <i class="fas fa-info-circle" style="color: var(--volunteer-primary);"></i>
          After submitting, our volunteer coordinator will respond within 5–7 days. 
          For urgent inquiries, call <a href="tel:+254733384352">0733 384 352</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- TESTIMONIAL -->
  <section class="volunteer-testimonial">
    <div class="volunteer-container">
      <div class="volunteer-testimonial-card">
        <i class="fas fa-quote-left"></i>
        <blockquote>
          Volunteering at Nyabondo as a physiotherapy student was life‑changing.
          I learned more in one month than a year in class, and the patients'
          resilience inspired me daily.
        </blockquote>
        <cite>— Sarah, Physiotherapy volunteer (2024)</cite>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Handle form submission with AJAX for better UX
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('volunteer-form');
    const submitBtn = document.getElementById('submit-btn');
    const btnText = document.getElementById('btn-text');
    const btnSpinner = document.getElementById('btn-spinner');
    const messageDiv = document.getElementById('form-message');

    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      
      // Show loading state
      btnText.style.display = 'none';
      btnSpinner.style.display = 'inline';
      submitBtn.disabled = true;
      messageDiv.style.display = 'none';
      messageDiv.className = '';

      try {
        const formData = new FormData(form);
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });

        if (response.ok) {
          // Success
          messageDiv.style.display = 'block';
          messageDiv.style.backgroundColor = '#d4edda';
          messageDiv.style.color = '#155724';
          messageDiv.style.border = '1px solid #c3e6cb';
          messageDiv.innerHTML = `
            <strong><i class="fas fa-check-circle"></i> Thank you for your application!</strong>
            <p style="margin-top: 8px; margin-bottom: 0;">
              Your application has been submitted successfully. Our volunteer coordinator will 
              respond within 5–7 days. We look forward to welcoming you to the Nyabondo family!
            </p>
          `;
          form.reset(); // Clear the form
        } else {
          // Error
          const errorData = await response.json();
          throw new Error(errorData.error || 'Submission failed. Please try again.');
        }
      } catch (error) {
        // Display error message
        messageDiv.style.display = 'block';
        messageDiv.style.backgroundColor = '#f8d7da';
        messageDiv.style.color = '#721c24';
        messageDiv.style.border = '1px solid #f5c6cb';
        messageDiv.innerHTML = `
          <strong><i class="fas fa-exclamation-circle"></i> Something went wrong</strong>
          <p style="margin-top: 8px; margin-bottom: 0;">
            ${error.message || 'There was a problem submitting your application. Please try again or contact us directly.'}
          </p>
        `;
      } finally {
        // Reset button state
        btnText.style.display = 'inline';
        btnSpinner.style.display = 'none';
        submitBtn.disabled = false;
        
        // Auto-hide success message after 10 seconds
        if (messageDiv.style.backgroundColor === '#d4edda') {
          setTimeout(() => {
            messageDiv.style.display = 'none';
          }, 10000);
        }
      }
    });
  });
</script>

<style>
  /* ===== Volunteer Page Styles ===== */
  :root {
    --volunteer-primary: #0096c7;
    --volunteer-primary-dark: #006d94;
    --volunteer-primary-light: #48b8d8;
    --volunteer-green: #2e8b57;
    --volunteer-text: #0d2b38;
    --volunteer-text-light: #2e5a6b;
    --volunteer-bg: #f4fcff;
    --volunteer-surface: #ffffff;
    --volunteer-border: #c7e9f4;
    --volunteer-shadow: 0 6px 24px rgba(0, 150, 199, 0.1);
    --volunteer-radius: 14px;
  }
  
  .volunteer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  
  .volunteer-bc {
    background: var(--volunteer-surface);
    border-bottom: 1px solid var(--volunteer-border);
    padding: 12px 0;
  }
  
  .volunteer-bc ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  
  .volunteer-bc li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
  }
  
  .volunteer-bc a {
    color: var(--volunteer-primary);
    text-decoration: none;
    transition: color 0.2s;
  }
  
  .volunteer-bc a:hover {
    color: var(--volunteer-primary-dark);
    text-decoration: underline;
  }
  
  .volunteer-bc span {
    color: var(--volunteer-text-light);
  }
  
  .volunteer-hero {
    background: linear-gradient(
      135deg,
      var(--volunteer-primary-dark) 0%,
      var(--volunteer-primary) 100%
    );
    padding: 80px 0 96px;
    position: relative;
    color: white;
  }
  
  .volunteer-hero-content {
    max-width: 720px;
    text-align: center;
    margin: 0 auto;
  }
  
  .volunteer-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--volunteer-primary-light);
    margin-bottom: 12px;
  }
  
  .volunteer-eyebrow::before,
  .volunteer-eyebrow::after {
    content: "";
    display: block;
    width: 24px;
    height: 1.5px;
    background: currentColor;
    opacity: 0.6;
  }
  
  .volunteer-hero h1 {
    font-family: "Playfair Display", serif;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 16px;
  }
  
  .volunteer-hero p {
    font-size: 1.05rem;
    opacity: 0.9;
    line-height: 1.6;
  }
  
  .volunteer-hero-wave {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    line-height: 0;
  }
  
  .volunteer-hero-wave svg {
    width: 100%;
    height: 40px;
    display: block;
  }

  .volunteer-roles {
    padding: 64px 0;
    background: var(--volunteer-surface);
  }
  
  .volunteer-roles h2 {
    font-family: "Playfair Display", serif;
    font-size: 1.8rem;
    text-align: center;
    margin-bottom: 48px;
    color: var(--volunteer-text);
  }
  
  .volunteer-roles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  
  .volunteer-role-card {
    background: var(--volunteer-bg);
    border-radius: var(--volunteer-radius);
    padding: 24px;
    border: 1px solid var(--volunteer-border);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  
  .volunteer-role-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--volunteer-shadow);
  }
  
  .volunteer-role-card h3 {
    color: var(--volunteer-primary);
    margin-bottom: 12px;
    font-size: 1.1rem;
  }
  
  .volunteer-role-details {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--volunteer-text-light);
  }
  
  .volunteer-role-details i {
    width: 20px;
    color: var(--volunteer-green);
  }

  .volunteer-why {
    padding: 48px 0;
    background: var(--volunteer-bg);
  }
  
  .volunteer-why-card {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
    background: var(--volunteer-surface);
    border-radius: var(--volunteer-radius);
    padding: 40px;
    box-shadow: var(--volunteer-shadow);
  }
  
  .volunteer-why-card i {
    font-size: 3rem;
    color: var(--volunteer-primary-light);
    margin-bottom: 16px;
  }
  
  .volunteer-why-card ul {
    text-align: left;
    max-width: 400px;
    margin: 20px auto;
    padding-left: 20px;
  }
  
  .volunteer-why-card li {
    margin-bottom: 8px;
  }

  .volunteer-process {
    padding: 64px 0;
    background: var(--volunteer-surface);
    text-align: center;
  }
  
  .volunteer-process h2 {
    font-family: "Playfair Display", serif;
    font-size: 1.8rem;
    margin-bottom: 48px;
    color: var(--volunteer-text);
  }
  
  .volunteer-steps {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 32px;
  }
  
  .step {
    flex: 1;
    min-width: 180px;
    text-align: center;
  }
  
  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--volunteer-primary);
    color: white;
    border-radius: 50%;
    font-size: 1.4rem;
    font-weight: bold;
    margin-bottom: 12px;
  }

  .volunteer-form-section {
    padding: 64px 0;
    background: var(--volunteer-bg);
  }
  
  .volunteer-form-card {
    max-width: 800px;
    margin: 0 auto;
    background: var(--volunteer-surface);
    border-radius: var(--volunteer-radius);
    padding: 48px;
    box-shadow: var(--volunteer-shadow);
  }
  
  .volunteer-form-card h2 {
    text-align: center;
    margin-bottom: 32px;
    color: var(--volunteer-text);
    font-family: "Playfair Display", serif;
  }
  
  .volunteer-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  
  .volunteer-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  
  .form-group label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--volunteer-text);
  }
  
  .volunteer-form input,
  .volunteer-form select,
  .volunteer-form textarea {
    padding: 12px;
    border: 1px solid var(--volunteer-border);
    border-radius: 6px;
    font-family: inherit;
    font-size: 0.95rem;
    transition: border-color 0.2s, box-shadow 0.2s;
    width: 100%;
    box-sizing: border-box;
  }
  
  .volunteer-form input:focus,
  .volunteer-form select:focus,
  .volunteer-form textarea:focus {
    outline: none;
    border-color: var(--volunteer-primary);
    box-shadow: 0 0 0 3px rgba(0, 150, 199, 0.1);
  }
  
  .volunteer-form textarea {
    resize: vertical;
    min-height: 80px;
  }
  
  .volunteer-btn-primary {
    background: var(--volunteer-primary);
    color: white;
    border: none;
    padding: 14px 32px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
    align-self: flex-start;
    min-width: 200px;
  }
  
  .volunteer-btn-primary:hover:not(:disabled) {
    background: var(--volunteer-primary-dark);
  }
  
  .volunteer-btn-primary:active:not(:disabled) {
    transform: scale(0.98);
  }
  
  .volunteer-btn-primary:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }
  
  .volunteer-note {
    font-size: 0.85rem;
    color: var(--volunteer-text-light);
    margin-top: 24px;
    text-align: center;
  }
  
  .volunteer-note a {
    color: var(--volunteer-primary);
    text-decoration: none;
    font-weight: 600;
  }
  
  .volunteer-note a:hover {
    text-decoration: underline;
  }
  
  .volunteer-note i {
    margin-right: 6px;
  }

  .volunteer-testimonial {
    padding: 64px 0;
    background: var(--volunteer-surface);
  }
  
  .volunteer-testimonial-card {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    padding: 40px;
    background: var(--volunteer-bg);
    border-radius: var(--volunteer-radius);
    border-left: 4px solid var(--volunteer-primary);
  }
  
  .volunteer-testimonial-card i {
    font-size: 2rem;
    color: var(--volunteer-primary-light);
    opacity: 0.5;
    margin-bottom: 16px;
  }
  
  .volunteer-testimonial-card blockquote {
    font-size: 1.2rem;
    font-style: italic;
    margin: 0 0 16px;
    color: var(--volunteer-text);
  }
  
  .volunteer-testimonial-card cite {
    font-style: normal;
    color: var(--volunteer-text-light);
    font-weight: 500;
  }

  /* Responsive Styles */
  @media (max-width: 1024px) {
    .volunteer-roles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 768px) {
    .volunteer-roles-grid {
      grid-template-columns: 1fr;
    }
    
    .volunteer-steps {
      flex-direction: column;
      align-items: center;
    }
    
    .volunteer-form-row {
      grid-template-columns: 1fr;
    }
    
    .volunteer-form-card {
      padding: 32px 24px;
    }
    
    .volunteer-btn-primary {
      width: 100%;
      align-self: center;
    }
    
    .volunteer-hero {
      padding: 60px 0 76px;
    }
  }
  
  @media (max-width: 480px) {
    .volunteer-form-card {
      padding: 24px 16px;
    }
    
    .volunteer-role-card {
      padding: 16px;
