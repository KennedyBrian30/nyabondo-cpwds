---
// src/pages/get-involved/donate.astro
import Layout from "../../layouts/Layout.astro";

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Get Involved", href: "/get-involved" },
  { label: "Donate", href: "/get-involved/donate" },
];

// Categories of needed items
const neededItems = [
  {
    category: "Orthotics & Prosthetics Lab",
    items: [
      "Carbon fibre sheets and resins",
      "Thermoplastic materials (polypropylene, polyethylene)",
      "Vacuum forming machine (used or new)",
      "Grinding and sanding tools",
      "Ankle joints, knee joints, and other hardware",
      "Foam for prosthetic liners",
    ],
  },
  {
    category: "Medical Equipment (Wards & Theatre)",
    items: [
      "Patient monitors (vital signs)",
      "Suction machines",
      "Surgical lamps",
      "Operating tables (orthopaedic)",
      "Anaesthesia machine (refurbished accepted)",
      "Stretchers and wheelchairs",
      "IV stands and infusion pumps",
    ],
  },
  {
    category: "Therapy & Rehabilitation",
    items: [
      "Parallel bars",
      "Exercise mats and plinths",
      "Therapy balls, weights, and resistance bands",
      "TENS units",
      "Pediatric therapy equipment (walkers, standing frames)",
    ],
  },
  {
    category: "Vocational Training Workshop",
    items: [
      "Sewing machines (manual and electric)",
      "Computers for computer literacy classes",
      "Hairdressing equipment (dummies, dryers)",
      "Shoe-making tools and leather",
      "Basket weaving materials",
    ],
  },
  {
    category: "General Facility",
    items: [
      "Hospital beds and mattresses",
      "Bedside lockers",
      "Laundry equipment (washer, dryer)",
      "Kitchen equipment (industrial stove, refrigerator)",
      "Office computers and printers",
    ],
  },
];

// Donation types for the form dropdown
const donationTypes = [
  "Monetary Donation",
  "Materials (Carbon fibre, thermoplastics, resins, foam, hardware)",
  "Equipment (Medical, therapy, or lab equipment)",
  "Machines & Tools (For vocational training or orthotics lab)",
  "In-kind goods",
  "Other / I'd like to discuss further",
];
---

<Layout title="Donate | Nyabondo Centre for Persons with Disabilities">
  <!-- BREADCRUMB -->
  <nav class="donate-bc" aria-label="Breadcrumb">
    <div class="donate-container">
      <ol>
        {
          breadcrumbs.map((c, i) => (
            <li>
              {i < breadcrumbs.length - 1 ? (
                <a href={c.href}>{c.label}</a>
              ) : (
                <span aria-current="page">{c.label}</span>
              )}
              {i < breadcrumbs.length - 1 && (
                <i class="fas fa-chevron-right" aria-hidden="true" />
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </nav>

  <!-- HERO -->
  <section class="donate-hero">
    <div class="donate-container">
      <div class="donate-hero-content">
        <span class="donate-eyebrow">Give Generously</span>
        <h1>Support Our Work</h1>
        <p>
          Your donation — whether financial, material, or in-kind — directly
          transforms the lives of persons with disabilities. Every contribution
          brings healing, mobility, and hope.
        </p>
      </div>
    </div>
    <div class="donate-hero-wave" aria-hidden="true">
      <svg viewBox="0 0 1440 40" preserveAspectRatio="none">
        <path
          d="M0,40 C240,20 480,0 720,20 C960,40 1200,20 1440,40 L1440,40 L0,40 Z"
          fill="#f4fcff"></path>
      </svg>
    </div>
  </section>

  <!-- HOW TO GIVE - INTRODUCTION -->
  <section class="donate-intro">
    <div class="donate-container">
      <div class="donate-intro-grid">
        <div class="donate-intro-card">
          <div class="donate-intro-icon"><i class="fas fa-boxes"></i></div>
          <h3>Materials &amp; Supplies</h3>
          <p>
            Carbon fibre, thermoplastics, resins, foam, hardware, and other
            consumables for our orthotics and prosthetics lab.
          </p>
        </div>
        <div class="donate-intro-card">
          <div class="donate-intro-icon"><i class="fas fa-gear"></i></div>
          <h3>Machines &amp; Tools</h3>
          <p>
            Equipment for our vocational training programs and the prosthetics
            and orthotics (orthopaedic technology lab). Sewing machines,
            computers, vacuum formers, and more.
          </p>
        </div>
        <div class="donate-intro-card">
          <div class="donate-intro-icon"><i class="fas fa-syringe"></i></div>
          <h3>Medical Equipment</h3>
          <p>
            Necessary for delivering top-notch occupational therapy and
            physiotherapy services: patient monitors, therapy mats, parallel
            bars, TENS units, and more.
          </p>
        </div>
        <div class="donate-intro-card">
          <div class="donate-intro-icon">
            <i class="fas fa-hand-holding-dollar"></i>
          </div>
          <h3>Monetary Donations</h3>
          <p>
            Sponsoring surgeries, therapy sessions, and assistive technology
            devices (prosthetics, orthotics and mobility aids) for needy
            clients, as well as supporting community outreach and awareness
            programs.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- BANK & M-PESA DETAILS -->
  <section class="donate-bank">
    <div class="donate-container">
      <div class="donate-bank-card">
        <h2>Quick Monetary Donations</h2>
        <p>
          For those who prefer to make a fast donation, here are our account
          details:
        </p>

        <div class="donate-bank-details">
          <div class="donate-bank-row">
            <span class="donate-bank-label">Account Name:</span>
            <span class="donate-bank-value">Nyabondo Centre for Disabled</span>
          </div>
          <div class="donate-bank-row">
            <span class="donate-bank-label">Bank:</span>
            <span class="donate-bank-value">KCB Bank Kenya, Kisumu Branch</span>
          </div>
          <div class="donate-bank-row">
            <span class="donate-bank-label">Account Number:</span>
            <span class="donate-bank-value">1103806459</span>
          </div>
        </div>

        <div class="donate-mpesa-details">
          <h4>M-Pesa</h4>
          <div class="donate-bank-row">
            <span class="donate-bank-label">Paybill Business No:</span>
            <span class="donate-bank-value">522522</span>
          </div>
          <div class="donate-bank-row">
            <span class="donate-bank-label">Account No:</span>
            <span class="donate-bank-value">7570955</span>
          </div>
        </div>

        <div class="donate-note">
          <i class="fas fa-globe" aria-hidden="true"></i>
          <p>
            These donations are accepted from both local and international
            prospects. For international transfers, please contact us for SWIFT
            details.
          </p>
        </div>

        <div class="donate-cta-buttons">
          <a href="#donation-form" class="donate-btn donate-btn-primary">
            <i class="fas fa-pen-to-square"></i> Fill Donation Form
          </a>
          <a href="/contact" class="donate-btn donate-btn-outline">
            <i class="fas fa-headset"></i> Speak with Our Team
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- DONATION FORM -->
  <section class="donate-form-section" id="donation-form">
    <div class="donate-container">
      <div class="donate-form-card">
        <div class="donate-form-header">
          <span class="donate-eyebrow">Donation Form</span>
          <h2>Tell Us About Your Donation</h2>
          <p>
            Fill in the form below and our team will contact you to coordinate
            the collection or receipt of your donation.
          </p>
        </div>
        <form
          class="donate-form"
          action="https://script.google.com/macros/s/YOUR_GOOGLE_SCRIPT_ID/exec"
          method="POST"
          target="_blank"
        >
          <!-- Name -->
          <div class="donate-form-group">
            <label for="donor-name"
              >Full Name <span class="required">*</span></label
            >
            <input
              type="text"
              id="donor-name"
              name="name"
              placeholder="e.g., John Mwangi"
              required
            />
          </div>

          <!-- Email -->
          <div class="donate-form-group">
            <label for="donor-email"
              >Email Address <span class="required">*</span></label
            >
            <input
              type="email"
              id="donor-email"
              name="email"
              placeholder="e.g., john@example.com"
              required
            />
          </div>

          <!-- Phone -->
          <div class="donate-form-group">
            <label for="donor-phone"
              >Phone Number <span class="required">*</span></label
            >
            <input
              type="tel"
              id="donor-phone"
              name="phone"
              placeholder="e.g., 0712345678"
              required
            />
          </div>

          <!-- Country (for international donors) -->
          <div class="donate-form-group">
            <label for="donor-country">Country</label>
            <input
              type="text"
              id="donor-country"
              name="country"
              placeholder="e.g., Kenya, USA, UK"
            />
          </div>

          <!-- Donation Type (Dropdown) -->
          <div class="donate-form-group">
            <label for="donation-type"
              >Type of Donation <span class="required">*</span></label
            >
            <select id="donation-type" name="donation_type" required>
              <option value="">— Select donation type —</option>
              {
                donationTypes.map((type) => (
                  <option value={type}>{type}</option>
                ))
              }
            </select>
          </div>

          <!-- Message / Details -->
          <div class="donate-form-group">
            <label for="donor-message"
              >Donation Details &amp; Pickup Instructions</label
            >
            <textarea
              id="donor-message"
              name="message"
              rows="5"
              placeholder="Please describe what you are donating (e.g., quantity, condition, size, weight) and provide any pickup or delivery instructions so we can coordinate with you."
            ></textarea>
          </div>

          <!-- Submit -->
          <div class="donate-form-group donate-form-submit">
            <button type="submit" class="donate-btn donate-btn-submit">
              <i class="fas fa-paper-plane"></i> Submit Donation
            </button>
            <p class="donate-form-note">
              By submitting this form, you consent to Nyabondo Centre contacting
              you to process your donation. Your data will not be shared with
              third parties.
            </p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- MATERIAL / IN-KIND DONATIONS -->
  <section class="donate-material" id="material">
    <div class="donate-container">
      <h2>What We Need — Materials, Equipment &amp; Tools</h2>
      <p>
        We gratefully accept new or gently used items that help us deliver
        quality rehabilitation and training. See below for our current needs.
      </p>
      <div class="donate-material-grid">
        {
          neededItems.map((cat) => (
            <div class="donate-material-category">
              <h3>{cat.category}</h3>
              <ul>
                {cat.items.map((item) => (
                  <li>
                    <i class="fas fa-check-circle" aria-hidden="true" /> {item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <div class="donate-coordination">
        <p>
          <strong>How to coordinate a material donation:</strong><br />
          Please contact our logistics team before shipping or dropping off items.
          Call <a href="tel:+254733384352">0733 384 352</a> or email
          <a href="mailto:nyabdisabled2003@gmail.com"
            >nyabdisabled2003@gmail.com</a
          >. We can provide a donation receipt and arrange collection for large
          items.
        </p>
      </div>
    </div>
  </section>

  <!-- ADDITIONAL WAYS -->
  <section class="donate-other">
    <div class="donate-container">
      <div class="donate-other-card">
        <i class="fas fa-heart" aria-hidden="true"></i>
        <h3>Other Ways to Give</h3>
        <ul>
          <li>
            <strong>Monthly Giving:</strong> Become a regular donor — even a small
            monthly amount helps sustain ongoing therapy for a child.
          </li>
          <li>
            <strong>Workplace Giving:</strong> Ask your employer about payroll giving
            or corporate matching programs.
          </li>
          <li>
            <strong>Legacy / Estate Gift:</strong> Include Nyabondo in your will
            to leave a lasting impact.
          </li>
          <li>
            <strong>Prayers &amp; Advocacy:</strong> Share our mission with your
            network and keep our work in your prayers.
          </li>
        </ul>
        <a href="/contact" class="donate-btn donate-btn-outline"
          >Speak with our team</a
        >
      </div>
    </div>
  </section>

  <!-- QUOTE -->
  <section class="donate-quote">
    <div class="donate-container">
      <div class="donate-quote-card">
        <i class="fas fa-quote-left"></i>
        <blockquote>
          The donated wheelchair gave my daughter freedom. She can now go to
          school. Thank you, Nyabondo and everyone who gives.
        </blockquote>
        <cite>— Mary, mother of Grace, age 10</cite>
      </div>
    </div>
  </section>

  <!-- CTA BANNER -->
  <section class="donate-cta">
    <div class="donate-container">
      <div class="donate-cta-card">
        <h2>Every Gift Matters</h2>
        <p>
          No donation is too small. Join the community of supporters changing
          lives.
        </p>
        <div class="donate-cta-buttons">
          <a href="#donation-form" class="donate-btn donate-btn-white"
            ><i class="fas fa-pen-to-square"></i> Fill Donation Form</a
          >
          <a href="#material" class="donate-btn donate-btn-green"
            ><i class="fas fa-boxes"></i> See What We Need</a
          >
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ===== Donate Page Styles ===== */
  :root {
    --donate-primary: #0096c7;
    --donate-primary-dark: #006d94;
    --donate-primary-light: #48b8d8;
    --donate-green: #2e8b57;
    --donate-green-dark: #1f6b40;
    --donate-text: #0d2b38;
    --donate-text-light: #2e5a6b;
    --donate-bg: #f4fcff;
    --donate-surface: #ffffff;
    --donate-border: #c7e9f4;
    --donate-shadow: 0 6px 24px rgba(0, 150, 199, 0.1);
    --donate-radius: 14px;
    --donate-ease: cubic-bezier(0.16, 1, 0.3, 1);
  }
  .donate-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Breadcrumb */
  .donate-bc {
    background: var(--donate-surface);
    border-bottom: 1px solid var(--donate-border);
    padding: 12px 0;
  }
  .donate-bc ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .donate-bc li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
  }
  .donate-bc a {
    color: var(--donate-primary);
    text-decoration: none;
  }
  .donate-bc a:hover {
    text-decoration: underline;
  }
  .donate-bc span {
    color: var(--donate-text-light);
  }
  .donate-bc i {
    font-size: 0.65rem;
    color: var(--donate-text-light);
  }

  /* Hero */
  .donate-hero {
    background: linear-gradient(
      135deg,
      var(--donate-primary-dark) 0%,
      var(--donate-primary) 100%
    );
    padding: 80px 0 96px;
    position: relative;
    color: white;
  }
  .donate-hero-content {
    max-width: 720px;
    text-align: center;
    margin: 0 auto;
  }
  .donate-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--donate-primary-light);
    margin-bottom: 12px;
  }
  .donate-eyebrow::before,
  .donate-eyebrow::after {
    content: "";
    display: block;
    width: 24px;
    height: 1.5px;
    background: currentColor;
    opacity: 0.6;
  }
  .donate-hero h1 {
    font-family: "Playfair Display", serif;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 16px;
  }
  .donate-hero p {
    font-size: 1.05rem;
    opacity: 0.9;
    line-height: 1.6;
  }
  .donate-hero-wave {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    line-height: 0;
  }
  .donate-hero-wave svg {
    width: 100%;
    height: 40px;
    display: block;
  }

  /* Intro - How to Give */
  .donate-intro {
    padding: 64px 0;
    background: var(--donate-surface);
  }
  .donate-intro-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .donate-intro-card {
    text-align: center;
    padding: 28px 20px;
    background: var(--donate-bg);
    border-radius: var(--donate-radius);
    border: 1px solid var(--donate-border);
    transition:
      transform 0.3s var(--donate-ease),
      box-shadow 0.3s;
  }
  .donate-intro-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--donate-shadow);
  }
  .donate-intro-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 16px;
    background: rgba(0, 150, 199, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    color: var(--donate-primary);
  }
  .donate-intro-card h3 {
    font-family: "Playfair Display", serif;
    font-size: 1.1rem;
    margin-bottom: 10px;
    color: var(--donate-text);
  }
  .donate-intro-card p {
    font-size: 0.9rem;
    color: var(--donate-text-light);
    line-height: 1.6;
  }

  /* Bank & M-Pesa */
  .donate-bank {
    padding: 64px 0;
    background: var(--donate-bg);
  }
  .donate-bank-card {
    max-width: 800px;
    margin: 0 auto;
    background: var(--donate-surface);
    border-radius: var(--donate-radius);
    padding: 48px 40px;
    text-align: center;
    box-shadow: var(--donate-shadow);
    border: 1px solid var(--donate-border);
  }
  .donate-bank-card h2 {
    font-family: "Playfair Display", serif;
    font-size: 1.8rem;
    margin-bottom: 12px;
    color: var(--donate-text);
  }
  .donate-bank-card > p {
    color: var(--donate-text-light);
    margin-bottom: 32px;
  }
  .donate-bank-details {
    background: var(--donate-bg);
    border-radius: var(--donate-radius);
    padding: 24px;
    margin-bottom: 24px;
    text-align: left;
  }
  .donate-bank-row {
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px solid var(--donate-border);
  }
  .donate-bank-row:last-child {
    border-bottom: none;
  }
  .donate-bank-label {
    font-weight: 600;
    color: var(--donate-text);
  }
  .donate-bank-value {
    color: var(--donate-text-light);
    font-weight: 500;
  }
  .donate-mpesa-details {
    background: rgba(0, 150, 199, 0.05);
    border: 1px solid var(--donate-border);
    border-radius: var(--donate-radius);
    padding: 20px 24px;
    margin-bottom: 24px;
    text-align: left;
  }
  .donate-mpesa-details h4 {
    color: var(--donate-primary);
    font-family: "Playfair Display", serif;
    font-size: 1.2rem;
    margin-bottom: 12px;
  }
  .donate-note {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: #fef9e7;
    border-left: 4px solid #f1c40f;
    padding: 16px 20px;
    border-radius: var(--donate-radius);
    margin-bottom: 28px;
    text-align: left;
  }
  .donate-note i {
    font-size: 1.2rem;
    color: #f1c40f;
    margin-top: 2px;
  }
  .donate-note p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--donate-text-light);
  }

  /* Donation Form */
  .donate-form-section {
    padding: 64px 0;
    background: var(--donate-surface);
  }
  .donate-form-card {
    max-width: 800px;
    margin: 0 auto;
    background: var(--donate-bg);
    border-radius: var(--donate-radius);
    padding: 48px 40px;
    border: 1px solid var(--donate-border);
  }
  .donate-form-header {
    text-align: center;
    margin-bottom: 32px;
  }
  .donate-form-header h2 {
    font-family: "Playfair Display", serif;
    font-size: 1.8rem;
    color: var(--donate-text);
    margin-bottom: 8px;
  }
  .donate-form-header p {
    color: var(--donate-text-light);
  }
  .donate-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .donate-form-group {
    display: flex;
    flex-direction: column;
  }
  .donate-form-group label {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--donate-text);
    margin-bottom: 6px;
  }
  .donate-form-group .required {
    color: #e74c3c;
  }
  .donate-form-group input,
  .donate-form-group select,
  .donate-form-group textarea {
    padding: 12px 16px;
    border: 1px solid var(--donate-border);
    border-radius: 8px;
    font-family: inherit;
    font-size: 0.95rem;
    background: var(--donate-surface);
    transition:
      border-color 0.3s,
      box-shadow 0.3s;
  }
  .donate-form-group input:focus,
  .donate-form-group select:focus,
  .donate-form-group textarea:focus {
    outline: none;
    border-color: var(--donate-primary);
    box-shadow: 0 0 0 3px rgba(0, 150, 199, 0.15);
  }
  .donate-form-group textarea {
    resize: vertical;
  }
  .donate-form-group:has(textarea) {
    grid-column: 1 / -1;
  }
  .donate-form-submit {
    grid-column: 1 / -1;
    align-items: center;
    margin-top: 8px;
  }
  .donate-btn-submit {
    background: var(--donate-green);
    color: white;
    border: none;
    padding: 14px 36px;
    font-size: 1rem;
    cursor: pointer;
    border-radius: 8px;
    font-weight: 700;
    transition:
      background 0.3s,
      transform 0.2s;
  }
  .donate-btn-submit:hover {
    background: var(--donate-green-dark);
    transform: translateY(-2px);
  }
  .donate-form-note {
    font-size: 0.8rem;
    color: var(--donate-text-light);
    margin-top: 12px;
    text-align: center;
  }

  /* Material Donations */
  .donate-material {
    padding: 64px 0;
    background: var(--donate-bg);
  }
  .donate-material h2 {
    font-family: "Playfair Display", serif;
