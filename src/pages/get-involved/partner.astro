---
// src/pages/get-involved/partner.astro
import Layout from "../../layouts/Layout.astro";

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Get Involved", href: "/get-involved" },
  { label: "Partner", href: "/get-involved/partner" },
];

const partnershipLevels = [
  {
    title: "Funding Partner",
    description:
      "Provide financial grants, programmatic support, or core funding. Your contribution helps us run surgeries, outreach, and salaries.",
    benefits: [
      "Logo on website and annual report",
      "Quarterly impact reports",
      "Site visit opportunities",
    ],
  },
  {
    title: "Technical Partner",
    description:
      "Share expertise in rehabilitation, prosthetics, therapy, or organizational development. Train our staff or help us improve systems.",
    benefits: [
      "Recognition in training materials",
      "Joint publications (where applicable)",
      "Direct collaboration with clinical teams",
    ],
  },
  {
    title: "Material/Equipment Partner",
    description:
      "Donate orthopaedic supplies, medical equipment, wheelchairs, or vocational training tools. In-kind support reduces our operational costs.",
    benefits: [
      "Donation acknowledgment",
      "Named sponsorship of specific equipment",
      "Photo documentation of usage",
    ],
  },
  {
    title: "Advocacy Partner",
    description:
      "Help us influence disability-inclusive policies at county and national levels. Amplify our voice through your networks.",
    benefits: [
      "Co-branded advocacy campaigns",
      "Invitation to policy roundtables",
      "Recognition as strategic ally",
    ],
  },
];
---

<Layout title="Partner With Us | Nyabondo Centre for Persons with Disabilities">
  <!-- BREADCRUMB -->
  <nav class="partner-bc" aria-label="Breadcrumb">
    <div class="partner-container">
      <ol>
        {
          breadcrumbs.map((c, i) => (
            <li>
              {i < breadcrumbs.length - 1 ? (
                <a href={c.href}>{c.label}</a>
              ) : (
                <span aria-current="page">{c.label}</span>
              )}
              {i < breadcrumbs.length - 1 && (
                <i class="fas fa-chevron-right" aria-hidden="true" />
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </nav>

  <!-- HERO -->
  <section class="partner-hero">
    <div class="partner-container">
      <div class="partner-hero-content">
        <span class="partner-eyebrow">Collaborate for Change</span>
        <h1>Become a Partner</h1>
        <p>
          Join a growing network of organisations, foundations, and corporations
          that are making inclusive rehabilitation a reality for thousands of
          Kenyans with disabilities.
        </p>
      </div>
    </div>
    <div class="partner-hero-wave" aria-hidden="true">
      <svg viewBox="0 0 1440 40" preserveAspectRatio="none">
        <path
          d="M0,40 C240,20 480,0 720,20 C960,40 1200,20 1440,40 L1440,40 L0,40 Z"
          fill="#f4fcff"></path>
      </svg>
    </div>
  </section>

  <!-- WHY PARTNER -->
  <section class="partner-why">
    <div class="partner-container">
      <div class="partner-why-grid">
        <div class="partner-why-text">
          <h2>Why Partner with Nyabondo?</h2>
          <p>
            We offer transparency, measurable impact, and deep community roots.
            With over 60 years of experience, we are a trusted referral centre
            for physical rehabilitation in Western Kenya.
          </p>
          <ul>
            <li>
              <i class="fas fa-chart-line"></i> Proven track record – 50,000+ lives
              touched
            </li>
            <li>
              <i class="fas fa-hand-holding-usd"></i> Efficient use of funds – low
              overhead, high direct impact
            </li>
            <li>
              <i class="fas fa-users"></i> Community‑driven and disability‑inclusive
              approach
            </li>
            <li>
              <i class="fas fa-file-alt"></i> Regular reporting and accountability
            </li>
          </ul>
        </div>
        <div class="partner-why-image">
          <picture>
            <source
              srcset="/images/about/about-nyabondo-centre.webp"
              type="image/webp"
            />
            <img
              src="/images/about/about-nyabondo-centre.webp"
              alt="Nyabondo team with partners"
              loading="lazy"
            />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <!-- PARTNERSHIP LEVELS -->
  <section class="partner-levels">
    <div class="partner-container">
      <h2>Ways to Partner</h2>
      <div class="partner-levels-grid">
        {
          partnershipLevels.map((level) => (
            <div class="partner-level-card">
              <h3>{level.title}</h3>
              <p>{level.description}</p>
              <div class="partner-level-benefits">
                <strong>What you get:</strong>
                <ul>
                  {level.benefits.map((b) => (
                    <li>
                      <i class="fas fa-check" /> {b}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CURRENT PARTNERS (logos strip) -->
  <section class="partner-current">
    <div class="partner-container">
      <h2>Trusted by Leading Organisations</h2>
      <div class="partner-logos">
        <img
          src="/images/partners/cbm-global.webp"
          alt="CBM Global"
          loading="lazy"
        />
        <img
          src="/images/partners/cheshire-disability-services-kenya.webp"
          alt="Cheshire Disability Services"
          loading="lazy"
        />
        <img
          src="/images/partners/ministry-of-health-kenya.webp"
          alt="Ministry of Health"
          loading="lazy"
        />
        <img
          src="/images/partners/national-council-persons-disabilities.webp"
          alt="NCPWD"
          loading="lazy"
        />
        <img
          src="/images/partners/archdiocese-of-kisumu.webp"
          alt="Archdiocese of Kisumu"
          loading="lazy"
        />
      </div>
      <div class="partner-cta-small">
        <a href="/partners" class="partner-link">View all partners →</a>
      </div>
    </div>
  </section>

  <!-- NEXT STEPS / INQUIRY FORM -->
  <section class="partner-inquiry">
    <div class="partner-container">
      <div class="partner-inquiry-card">
        <h2>Ready to Partner?</h2>
        <p>
          Tell us about your organisation, and we will get back to you within
          2–3 business days.
        </p>
        <form action="/api/partner-inquiry" method="POST" class="partner-form">
          <div class="partner-form-row">
            <input
              type="text"
              name="org_name"
              placeholder="Organisation Name *"
              required
            />
            <input
              type="text"
              name="contact_person"
              placeholder="Contact Person *"
              required
            />
          </div>
          <div class="partner-form-row">
            <input type="email" name="email" placeholder="Email *" required />
            <input type="tel" name="phone" placeholder="Phone" />
          </div>
          <select name="partnership_type" required>
            <option value="">Select Partnership Interest *</option>
            <option>Funding Partner</option>
            <option>Technical Partner</option>
            <option>Material/Equipment Partner</option>
            <option>Advocacy Partner</option>
            <option>Other</option>
          </select>
          <textarea
            name="message"
            rows="4"
            placeholder="Tell us about your organisation and how you'd like to collaborate..."
          ></textarea>
          <button type="submit" class="partner-btn partner-btn-primary"
            >Send Inquiry</button
          >
        </form>
        <p class="partner-alternative">
          Or directly email our Programmes Manager: <a
            href="mailto:partners@nyabondo.org">partners@nyabondo.org</a>
        </p>
      </div>
    </div>
  </section>

  <!-- TESTIMONIAL -->
  <section class="partner-testimonial">
    <div class="partner-container">
      <div class="partner-testimonial-card">
        <i class="fas fa-quote-left"></i>
        <blockquote>
          Nyabondo is an exceptional partner – accountable, impactful, and
          deeply connected to the communities they serve. We are proud to
          support their SHINE Project.
        </blockquote>
        <cite>— Christian Blind Mission (CBM) Global</cite>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ===== Partner Page Styles ===== */
  :root {
    --partner-primary: #0096c7;
    --partner-primary-dark: #006d94;
    --partner-primary-light: #48b8d8;
    --partner-green: #2e8b57;
    --partner-text: #0d2b38;
    --partner-text-light: #2e5a6b;
    --partner-bg: #f4fcff;
    --partner-surface: #ffffff;
    --partner-border: #c7e9f4;
    --partner-shadow: 0 6px 24px rgba(0, 150, 199, 0.1);
    --partner-radius: 14px;
  }
  .partner-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .partner-bc {
    background: var(--partner-surface);
    border-bottom: 1px solid var(--partner-border);
    padding: 12px 0;
  }
  .partner-bc ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .partner-bc li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
  }
  .partner-bc a {
    color: var(--partner-primary);
    text-decoration: none;
  }
  .partner-bc span {
    color: var(--partner-text-light);
  }
  .partner-hero {
    background: linear-gradient(
      135deg,
      var(--partner-primary-dark) 0%,
      var(--partner-primary) 100%
    );
    padding: 80px 0 96px;
    position: relative;
    color: white;
  }
  .partner-hero-content {
    max-width: 720px;
    text-align: center;
    margin: 0 auto;
  }
  .partner-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--partner-primary-light);
    margin-bottom: 12px;
  }
  .partner-eyebrow::before,
  .partner-eyebrow::after {
    content: "";
    display: block;
    width: 24px;
    height: 1.5px;
    background: currentColor;
    opacity: 0.6;
  }
  .partner-hero h1 {
    font-family: "Playfair Display", serif;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 16px;
  }
  .partner-hero p {
    font-size: 1.05rem;
    opacity: 0.9;
    line-height: 1.6;
  }
  .partner-hero-wave {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    line-height: 0;
  }
  .partner-hero-wave svg {
    width: 100%;
    height: 40px;
    display: block;
  }

  .partner-why {
    padding: 80px 0;
    background: var(--partner-surface);
  }
  .partner-why-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .partner-why-text h2 {
    font-family: "Playfair Display", serif;
    font-size: 1.8rem;
    margin-bottom: 16px;
  }
  .partner-why-text p {
    margin-bottom: 24px;
    color: var(--partner-text-light);
  }
  .partner-why-text ul {
    list-style: none;
    padding: 0;
  }
  .partner-why-text li {
    display: flex;
    gap: 12px;
    margin-bottom: 12px;
    align-items: center;
  }
  .partner-why-text li i {
    color: var(--partner-green);
    width: 20px;
  }
  .partner-why-image img {
    width: 100%;
    border-radius: var(--partner-radius);
    box-shadow: var(--partner-shadow);
  }

  .partner-levels {
    padding: 64px 0;
    background: var(--partner-bg);
    text-align: center;
  }
  .partner-levels h2 {
    font-family: "Playfair Display", serif;
    font-size: 1.8rem;
    margin-bottom: 48px;
  }
  .partner-levels-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }
  .partner-level-card {
    background: var(--partner-surface);
    border-radius: var(--partner-radius);
    padding: 32px;
    text-align: left;
    border: 1px solid var(--partner-border);
    transition: transform 0.2s;
  }
  .partner-level-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--partner-shadow);
  }
  .partner-level-card h3 {
    color: var(--partner-primary);
    margin-bottom: 12px;
  }
  .partner-level-card p {
    margin-bottom: 20px;
    color: var(--partner-text-light);
    line-height: 1.5;
  }
  .partner-level-benefits strong {
    display: block;
    margin-bottom: 8px;
  }
  .partner-level-benefits ul {
    padding-left: 20px;
    margin: 0;
  }
  .partner-level-benefits li {
    margin-bottom: 6px;
  }

  .partner-current {
    padding: 64px 0;
    text-align: center;
    background: var(--partner-surface);
  }
  .partner-current h2 {
    font-family: "Playfair Display", serif;
    font-size: 1.6rem;
    margin-bottom: 32px;
  }
  .partner-logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 40px;
    align-items: center;
    margin-bottom: 24px;
  }
  .partner-logos img {
    max-height: 60px;
    width: auto;
    filter: grayscale(0.3);
    transition: filter 0.2s;
  }
  .partner-logos img:hover {
    filter: grayscale(0);
  }

  .partner-inquiry {
    padding: 64px 0;
    background: var(--partner-bg);
  }
  .partner-inquiry-card {
    max-width: 800px;
    margin: 0 auto;
    background: var(--partner-surface);
    border-radius: var(--partner-radius);
    padding: 48px;
    box-shadow: var(--partner-shadow);
  }
  .partner-inquiry-card h2 {
    text-align: center;
    margin-bottom: 16px;
  }
  .partner-inquiry-card p {
    text-align: center;
    margin-bottom: 32px;
    color: var(--partner-text-light);
  }
  .partner-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .partner-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .partner-form input,
  .partner-form select,
  .partner-form textarea {
    padding: 12px;
    border: 1px solid var(--partner-border);
    border-radius: 6px;
    font-family: inherit;
  }
  .partner-form button {
    align-self: flex-start;
  }
  .partner-alternative {
    text-align: center;
    margin-top: 24px;
    font-size: 0.9rem;
  }
  .partner-btn-primary {
    background: var(--partner-primary);
    color: white;
    border: none;
    padding: 12px 28px;
    border-radius: 6px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }
  .partner-btn-primary:hover {
    background: var(--partner-primary-dark);
  }

  .partner-testimonial {
    padding: 64px 0;
    background: var(--partner-surface);
  }
  .partner-testimonial-card {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    padding: 40px;
    background: var(--partner-bg);
    border-radius: var(--partner-radius);
    border-left: 4px solid var(--partner-primary);
  }
  .partner-testimonial-card i {
    font-size: 2rem;
    color: var(--partner-primary-light);
    opacity: 0.5;
    margin-bottom: 16px;
  }
  .partner-testimonial-card blockquote {
    font-size: 1.2rem;
    font-style: italic;
    margin: 0 0 16px;
  }
  .partner-testimonial-card cite {
    font-size: 0.9rem;
    color: var(--partner-text-light);
  }

  @media (max-width: 768px) {
    .partner-why-grid,
    .partner-levels-grid {
      grid-template-columns: 1fr;
    }
    .partner-form-row {
      grid-template-columns: 1fr;
    }
    .partner-inquiry-card {
      padding: 32px 24px;
    }
  }
</style>
