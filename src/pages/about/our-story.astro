---
// src/pages/about/our-story.astro
import Layout from "../../layouts/Layout.astro";

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Our Story", href: "/about/our-story" },
];

// Hero images
const heroImg = "/images/about/about-nyabondo-centre.webp";
const founderImg = "/images/hero/hero-nyabondo-staff-1.webp";
const sistersImg = "/images/hero/hero-administrator.webp";
const todayImg = "/images/about/excellence.webp";
const outreachImg = "/images/hero/hero-community-outreach.webp";

// Partners: first 4 with logos (matching home page)
const partners = [
  {
    name: "Christian Blind Mission",
    logo: "/images/partners/cbm-global.webp",
    url: "https://www.cbm.org",
  },
  {
    name: "Cheshire Disability Services Kenya",
    logo: "/images/partners/cheshire-disability-services-kenya.webp",
    url: "https://www.cheshire.or.ke",
  },
  {
    name: "Ministry of Health",
    logo: "/images/partners/ministry-of-health-kenya.webp",
    url: "https://www.health.go.ke",
  },
  {
    name: "National Fund for the Disabled Kenya",
    logo: "/images/partners/national-fund-disabled-kenya.webp",
    url: "https://www.nfdk.go.ke",
  },
];
---

<Layout title="Our Story | Nyabondo Centre for Persons with Disabilities">
  <!-- BREADCRUMB -->
  <nav class="bc" aria-label="Breadcrumb">
    <div class="os-container">
      <ol>
        {
          breadcrumbs.map((c, i) => (
            <li>
              {i < breadcrumbs.length - 1 ? (
                <a href={c.href}>{c.label}</a>
              ) : (
                <span aria-current="page">{c.label}</span>
              )}
              {i < breadcrumbs.length - 1 && (
                <i class="fas fa-chevron-right" aria-hidden="true" />
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </nav>

  <!-- PAGE HERO -->
  <header class="os-hero" aria-labelledby="os-hero-title">
    <div class="os-hero-bg" aria-hidden="true"></div>
    <div class="os-hero-overlay" aria-hidden="true"></div>
    <picture class="os-hero-img">
      <source srcset={heroImg} type="image/webp" />
      <img
        src={heroImg}
        alt="Nyabondo Centre"
        loading="eager"
        fetchpriority="high"
        width="1920"
        height="1080"
      />
    </picture>
    <div class="os-container os-hero-inner">
      <div class="os-hero-content">
        <span class="os-eyebrow os-eyebrow--light">Our Story</span>
        <h1 id="os-hero-title" class="os-hero-title">
          A Story of Faith,<br />Hope and
          <em class="os-hero-accent">Rising Above</em>
        </h1>
        <p class="os-hero-sub">
          From a single priest's vision and 35 abandoned children to a national
          referral centre. Nyabondo's journey is a testament to what compassion
          can achieve over six decades.
        </p>
        <div class="os-hero-chips" aria-label="Key statistics">
          <div class="os-chip">
            <span class="os-chip-num">60+</span><span class="os-chip-label"
              >Years of Service</span
            >
          </div>
          <div class="os-chip">
            <span class="os-chip-num">50K+</span><span class="os-chip-label"
              >Lives Touched</span
            >
          </div>
          <div class="os-chip">
            <span class="os-chip-num">12K+</span><span class="os-chip-label"
              >Surgeries Performed</span
            >
          </div>
        </div>
      </div>
    </div>
    <div class="os-hero-wave" aria-hidden="true">
      <svg
        viewBox="0 0 1440 80"
        preserveAspectRatio="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M0,40 C240,80 480,0 720,40 C960,80 1200,0 1440,40 L1440,80 L0,80 Z"
          fill="var(--os-bg)"></path>
      </svg>
    </div>
  </header>

  <!-- CHAPTER 1: THE CRY OF THE HOPELESS -->
  <section class="os-chapter" id="chapter-1" aria-labelledby="ch1-title">
    <div class="os-container">
      <div class="os-chapter-grid">
        <div class="os-chapter-text">
          <div class="os-ch-num" aria-hidden="true">01</div>
          <h2 id="ch1-title" class="os-ch-title">The Cry of the Hopeless</h2>
          <!-- mobile image will be injected here via CSS (desktop hidden) -->
          <div class="os-chapter-mobile-img">
            <div class="os-img-frame">
              <picture>
                <source srcset={founderImg} type="image/webp" />
                <img
                  src={founderImg}
                  alt="Early days at Nyabondo"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="600"
                />
              </picture>
              <div class="os-img-label">
                The spirit of compassion that started it all
              </div>
            </div>
          </div>
          <p class="os-ch-lead">
            In 1963, a Mill Hill Priest from the Netherlands,
            <strong>Rev. Father John Kutner</strong>, was walking through the
            villages of Western Kenya. What he saw broke his heart.
          </p>
          <p>
            Children with disabilities were crawling in the dust, hidden away by
            families ashamed or unable to care for them. No food, no clothes, no
            hope. Father Kutner could not look away. With nothing but deep faith
            and a few generous hearts, he opened a small home for 35 of these
            children. He called it the
            <strong>John F. Kennedy Memorial Home for Crippled Children</strong
            >.
          </p>

          <blockquote class="os-pullquote">
            <span class="os-pq-mark" aria-hidden="true">"</span>
            <p>
              These children were crawling and hopeless. We knew we had to do
              something, not out of pity, but out of love.
            </p>
            <cite>Rev. Fr. John Kutner, Founder</cite>
          </blockquote>

          <p>
            It was not a hospital. It was not a grand centre. It was a promise:
            that every child, regardless of disability, deserves dignity, care,
            and a chance to rise.
          </p>
        </div>

        <!-- desktop media column -->
        <div class="os-chapter-media">
          <div class="os-img-frame">
            <picture>
              <source srcset={founderImg} type="image/webp" />
              <img
                src={founderImg}
                alt="Early days at Nyabondo"
                loading="lazy"
                decoding="async"
                width="800"
                height="600"
              />
            </picture>
            <div class="os-img-label">
              The spirit of compassion that started it all
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CHAPTER 2: THE HANDS THAT CARRIED THE VISION -->
  <section
    class="os-chapter os-chapter--alt"
    id="chapter-2"
    aria-labelledby="ch2-title"
  >
    <div class="os-container">
      <div class="os-chapter-grid os-chapter-grid--flip">
        <div class="os-chapter-text">
          <div class="os-ch-num" aria-hidden="true">02</div>
          <h2 id="ch2-title" class="os-ch-title">
            The Hands That Carried the Vision
          </h2>
          <div class="os-chapter-mobile-img">
            <div class="os-img-frame os-img-frame--portrait">
              <picture>
                <source srcset={sistersImg} type="image/webp" />
                <img
                  src={sistersImg}
                  alt="Franciscan Sisters who shaped Nyabondo"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="1000"
                />
              </picture>
              <div class="os-img-label">
                The Franciscan Sisters, pillars of the ministry
              </div>
            </div>
          </div>
          <p class="os-ch-lead">
            After Father Kutner's initial work, the
            <strong>Franciscan Missionary Sisters for Africa (FMSA)</strong>
            took over the management. These Irish nuns brought not only nursing skills
            but a fierce commitment to the abandoned.
          </p>
          <p>
            For nearly three decades they ran the home, expanding its reach and
            reputation. In 1989, the
            <strong>Franciscan Sisters of Saint Anna (FSSA)</strong> received the
            baton. Under their leadership, what began as a shelter grew into a true
            rehabilitation centre, with a surgery unit, a therapy department, and
            an orthopaedic workshop.
          </p>

          <div class="os-stat-pair">
            <div class="os-stat-pair-item">
              <span class="os-stat-pair-num">1989</span>
              <span class="os-stat-pair-label"
                >Sisters of St. Anna take over</span
              >
            </div>
            <div class="os-stat-pair-divider" aria-hidden="true"></div>
            <div class="os-stat-pair-item">
              <span class="os-stat-pair-num">35+ yrs</span>
              <span class="os-stat-pair-label">Continuous sister-led care</span>
            </div>
          </div>

          <p>
            Today, <strong>Rev. Sr. Ludovena Anyango Onyino</strong> leads the Centre,
            supported by a nine-member Board appointed by the Archdiocese of Kisumu.
            The sisters still walk the wards, pray with families, and ensure every
            patient is treated as a child of God.
          </p>

          <a href="/about/administration" class="os-text-link">
            Meet our leadership team <i
              class="fas fa-arrow-right"
              aria-hidden="true"></i>
          </a>
        </div>

        <div class="os-chapter-media">
          <div class="os-img-frame os-img-frame--portrait">
            <picture>
              <source srcset={sistersImg} type="image/webp" />
              <img
                src={sistersImg}
                alt="Franciscan Sisters who shaped Nyabondo"
                loading="lazy"
                decoding="async"
                width="800"
                height="1000"
              />
            </picture>
            <div class="os-img-label">
              The Franciscan Sisters, pillars of the ministry
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CHAPTER 3: FROM A HOME TO A CENTRE OF EXCELLENCE -->
  <section
    class="os-chapter os-chapter--bleed"
    id="chapter-3"
    aria-labelledby="ch3-title"
  >
    <div class="os-container">
      <div class="os-bleed-card">
        <div class="os-bleed-text">
          <div class="os-ch-num" aria-hidden="true">03</div>
          <h2 id="ch3-title" class="os-ch-title">
            From a Home to a Centre of Excellence
          </h2>
          <div class="os-chapter-mobile-img">
            <picture>
              <source srcset={todayImg} type="image/webp" />
              <img
                src={todayImg}
                alt="Corrective surgery at Nyabondo today"
                loading="lazy"
                decoding="async"
                width="800"
                height="8000"
              />
            </picture>
          </div>
          <p class="os-ch-lead">
            Over the decades, Nyabondo evolved. What started as a place of
            refuge became a <strong
              >referral Physical Rehabilitation Centre</strong
            >
            for Western Kenya and beyond.
          </p>
          <p>
            Thousands of children and adults have received
            <a href="/services/surgeries" class="os-inline-link"
              >corrective surgeries</a
            >
            for clubfoot, cleft lip, post-burn contractures, and congenital deformities.
            Our
            <a href="/services/therapy" class="os-inline-link"
              >physiotherapy and occupational therapy</a
            >
            teams work daily to restore movement and independence. And our
            <a href="/services/assistive-devices" class="os-inline-link"
              >orthopaedic workshop</a
            >
            produces custom prosthetics, orthotics, and mobility aids, all on-site
            and made to fit the individual.
          </p>

          <ul class="os-milestone-list" aria-label="Key milestones">
            <li>
              <span class="os-milestone-icon"
                ><i class="fas fa-calendar-check" aria-hidden="true"></i></span
              >
              <span
                ><strong>1963</strong> — 35 children, one priest, one promise</span
              >
            </li>
            <li>
              <span class="os-milestone-icon"
                ><i class="fas fa-chart-line" aria-hidden="true"></i></span
              >
              <span><strong>Today</strong> — over 50,000 persons served</span>
            </li>
            <li>
              <span class="os-milestone-icon"
                ><i class="fas fa-globe-africa" aria-hidden="true"></i></span
              >
              <span
                ><strong>Impact</strong> — national and regional referral centre</span
              >
            </li>
          </ul>

          <a href="/services" class="btn os-btn-outline">
            Explore Our Services <i
              class="fas fa-arrow-right"
              aria-hidden="true"></i>
          </a>
        </div>

        <div class="os-bleed-media" aria-hidden="true">
          <picture>
            <source srcset={todayImg} type="image/webp" />
            <img
              src={todayImg}
              alt="Corrective surgery at Nyabondo today"
              loading="lazy"
              decoding="async"
              width="800"
              height="800"
            />
          </picture>
          <div class="os-bleed-media-tint" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- MISSION / VISION / MOTTO PILLAR -->
  <section class="os-mvv" aria-labelledby="os-mvv-title">
    <div class="os-mvv-bg" aria-hidden="true"></div>
    <div class="os-mvv-pattern" aria-hidden="true">
      <svg
        viewBox="0 0 800 400"
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="xMidYMid slice"
      >
        <circle
          cx="100"
          cy="200"
          r="320"
          fill="none"
          stroke="rgba(255,255,255,0.04)"
          stroke-width="1.5"></circle>
        <circle
          cx="700"
          cy="150"
          r="260"
          fill="none"
          stroke="rgba(72,184,216,0.07)"
          stroke-width="1.5"></circle>
        <circle
          cx="400"
          cy="350"
          r="200"
          fill="none"
          stroke="rgba(255,255,255,0.03)"
          stroke-width="1"></circle>
      </svg>
    </div>
    <div class="os-container os-mvv-inner">
      <span class="os-eyebrow os-eyebrow--light" id="os-mvv-title"
        >Our Purpose</span
      >
      <h2 class="os-mvv-heading">Mission, Vision and Motto</h2>
      <div class="os-mvv-grid">
        <div class="os-mvv-card">
          <div class="os-mvv-card-icon" aria-hidden="true">
            <i class="fas fa-bullseye"></i>
          </div>
          <h3>Our Mission</h3>
          <p>
            Provision of quality rehabilitation and medical services through
            corrective surgery, therapy, and assistive devices to persons with
            disabilities in a safe and secure environment.
          </p>
        </div>
        <div class="os-mvv-card os-mvv-card--accent">
          <div class="os-mvv-card-icon" aria-hidden="true">
            <i class="fas fa-eye"></i>
          </div>
          <h3>Our Vision</h3>
          <p>
            To be a referral centre of excellence in the provision of integral,
            comprehensive rehabilitation services that are affordable and
            accessible to all persons with disabilities in Kenya.
          </p>
        </div>
        <div class="os-mvv-card os-mvv-card--motto">
          <div class="os-mvv-card-icon" aria-hidden="true">
            <i class="fas fa-quote-left"></i>
          </div>
          <h3>Our Motto</h3>
          <p class="os-mvv-motto-text">Rising above Disability</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CHAPTER 4: THE ROAD AHEAD -->
  <section
    class="os-chapter os-chapter--challenge"
    id="chapter-4"
    aria-labelledby="ch4-title"
  >
    <div class="os-container">
      <div class="os-chapter-grid">
        <div class="os-chapter-text">
          <div class="os-ch-num" aria-hidden="true">04</div>
          <h2 id="ch4-title" class="os-ch-title">
            The Road Ahead: Challenges and How You Can Help
          </h2>
          <div class="os-chapter-mobile-img">
            <div class="os-challenge-img-wrap">
              <picture>
                <source srcset={outreachImg} type="image/webp" />
                <img
                  src={outreachImg}
                  alt="Community outreach bringing services to remote areas"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="600"
                />
              </picture>
              <div class="os-challenge-img-caption">
                <i class="fas fa-hands-holding-heart" aria-hidden="true"></i>
                <span>You can help us reach more communities</span>
              </div>
            </div>
          </div>
          <p class="os-ch-lead">
            For all our successes, the need is still far greater than our
            resources. Every week, we turn away patients because we lack beds,
            equipment, or funds for their surgery.
          </p>
          <p>
            Donor fatigue has reduced support, and our infrastructure struggles
            to keep pace with demand. Yet we refuse to give up.
          </p>

          <div class="os-challenge-box">
            <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
            <div>
              <strong>What holds us back</strong>
              <ul>
                <li>Inadequate and shrinking financial support</li>
                <li>Overwhelming demand for services</li>
                <li>Ageing infrastructure and equipment</li>
              </ul>
            </div>
          </div>

          <p>
            We are seeking new partners, donors, and volunteers to walk with us.
            Your support, whether a one-time gift, a monthly pledge, or a
            corporate partnership, translates directly into more surgeries, more
            therapy sessions, more assistive devices, and more children walking
            for the first time.
          </p>

          <div class="os-cta-pair">
            <a href="/get-involved/donate" class="btn os-btn-green">
              <i class="fas fa-heart" aria-hidden="true"></i> Support Our Mission
            </a>
            <a href="/get-involved/partner" class="btn os-btn-outline">
              Become a Partner <i class="fas fa-arrow-right" aria-hidden="true"
              ></i>
            </a>
          </div>
        </div>

        <div class="os-chapter-media">
          <div class="os-challenge-img-wrap">
            <picture>
              <source srcset={outreachImg} type="image/webp" />
              <img
                src={outreachImg}
                alt="Community outreach bringing services to remote areas"
                loading="lazy"
                decoding="async"
                width="800"
                height="600"
              />
            </picture>
            <div class="os-challenge-img-caption">
              <i class="fas fa-hands-holding-heart" aria-hidden="true"></i>
              <span>You can help us reach more communities</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PARTNERS SECTION (only first 4 logos + CTA) -->
  <section class="os-partners" aria-labelledby="os-partners-title">
    <div class="os-container">
      <div class="os-partners-header">
        <span class="os-eyebrow">Trusted Partners</span>
        <h2 id="os-partners-title" class="os-partners-heading">
          We Walk With Others
        </h2>
        <p>Our work is made possible by these incredible organisations.</p>
      </div>
      <div class="os-partners-grid">
        {
          partners.map((partner) => (
            <a
              href={partner.url}
              target="_blank"
              rel="noopener noreferrer"
              class="os-partner-card"
              aria-label={`Visit ${partner.name} (opens in new tab)`}
            >
              <div class="os-partner-logo-wrap">
                <picture>
                  <source srcset={partner.logo} type="image/webp" />
                  <img
                    src={partner.logo}
                    alt={`${partner.name} logo`}
                    loading="lazy"
                    decoding="async"
                    width="160"
                    height="80"
                    onerror="this.closest('picture').style.display='none';this.closest('.os-partner-logo-wrap').querySelector('.os-partner-logo-fallback').style.display='flex';"
                  />
                </picture>
                <div
                  class="os-partner-logo-fallback"
                  style="display:none;"
                  aria-hidden="true"
                >
                  <i class="fas fa-handshake" />
                </div>
              </div>
              <span class="os-partner-name">{partner.name}</span>
            </a>
          ))
        }
      </div>
      <div class="os-partners-footer">
        <a href="/partners" class="os-text-link">
          View all our partners <i class="fas fa-arrow-right" aria-hidden="true"
          ></i>
        </a>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="os-final-cta" aria-labelledby="os-cta-title">
    <div class="os-container">
      <div class="os-cta-card">
        <div class="os-cta-card-glow" aria-hidden="true"></div>
        <div class="os-cta-card-content">
          <span class="os-eyebrow os-eyebrow--light">Get Involved</span>
          <h2 id="os-cta-title" class="os-cta-title">
            Become Part of Our Story
          </h2>
          <p class="os-cta-sub">
            Whether you are a person with a disability seeking care, a family
            member, a donor, or a volunteer, Nyabondo welcomes you.
          </p>
          <div class="os-cta-btns">
            <a href="/contact" class="btn os-btn-white">Contact Us</a>
            <a href="/get-involved/donate" class="btn os-btn-green">
              <i class="fas fa-heart" aria-hidden="true"></i> Donate Now
            </a>
          </div>
          <p class="os-cta-contact">
            <a href="tel:+254733384352"
              ><i class="fas fa-phone" aria-hidden="true"></i> 0733 384 352</a
            >
            <a href="mailto:nyabdisabled2003@gmail.com"
              ><i class="fas fa-envelope" aria-hidden="true"></i> nyabdisabled2003@gmail.com</a
            >
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ═══════════════════════════════════════
     LOCAL TOKENS (mirrors Layout palette)
  ═══════════════════════════════════════ */
  :root {
    --os-primary: #0096c7;
    --os-primary-dark: #006d94;
    --os-primary-light: #48b8d8;
    --os-green: #2e8b57;
    --os-green-dark: #1f6b40;
    --os-green-light: #3dad6e;
    --os-text: #0d2b38;
    --os-text-light: #2e5a6b;
    --os-text-muted: #5a8a99;
    --os-bg: #f4fcff;
    --os-bg-alt: #edf8f0;
    --os-surface: #ffffff;
    --os-border: #c7e9f4;
    --os-border-light: #ddf1f9;
    --os-shadow-sm: 0 2px 8px rgba(0, 150, 199, 0.08);
    --os-shadow-md: 0 6px 24px rgba(0, 150, 199, 0.1);
    --os-shadow-lg: 0 16px 48px rgba(0, 150, 199, 0.13);
    --os-shadow-xl: 0 24px 72px rgba(0, 150, 199, 0.16);
    --os-radius-sm: 6px;
    --os-radius-md: 14px;
    --os-radius-lg: 22px;
    --os-ease: cubic-bezier(0.16, 1, 0.3, 1);
    --os-fast: 0.22s;
    --os-base: 0.3s;
    --os-slow: 0.55s;
  }

  /* ═══════════════════════════════════════
     RESET / BASE
  ═══════════════════════════════════════ */
  .os-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ═══════════════════════════════════════
     EYEBROW
  ═══════════════════════════════════════ */
  .os-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--os-primary);
    margin-bottom: 12px;
  }
  .os-eyebrow::before,
  .os-eyebrow::after {
    content: "";
    display: block;
    width: 24px;
    height: 1.5px;
    background: currentColor;
    opacity: 0.5;
  }
  .os-eyebrow--light {
    color: var(--os-primary-light);
  }

  /* ═══════════════════════════════════════
     SHARED BUTTONS
  ═══════════════════════════════════════ */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 26px;
    border-radius: var(--os-radius-sm);
    font-family: "Source Sans 3", sans-serif;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    border: 2px solid transparent;
    cursor: pointer;
    transition: all var(--os-fast) var(--os-ease);
    white-space: nowrap;
  }
  .btn:hover {
    transform: translateY(-2px);
  }
  .btn i {
    transition: transform var(--os-fast) var(--os-ease);
  }
  .btn:hover i.fa-arrow-right {
    transform: translateX(4px);
  }

  .os-btn-green {
    background: var(--os-green);
    color: #fff;
    border-color: var(--os-green);
    box-shadow: 0 4px 18px rgba(46, 139, 87, 0.28);
  }
  .os-btn-green:hover {
    background: var(--os-green-dark);
    border-color: var(--os-green-dark);
  }
  .os-btn-outline {
    background: transparent;
    color: var(--os-primary);
    border-color: var(--os-primary);
  }
  .os-btn-outline:hover {
    background: var(--os-primary);
    color: #fff;
  }
  .os-btn-white {
    background: #fff;
    color: var(--os-primary);
    border-color: #fff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
  }
  .os-btn-white:hover {
    background: #e0f5fc;
  }

  .os-text-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--os-primary);
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    transition: gap var(--os-fast) var(--os-ease);
  }
  .os-text-link:hover {
    gap: 12px;
  }
  .os-text-link i {
    font-size: 0.8rem;
  }

  .os-inline-link {
    color: var(--os-primary);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid rgba(0, 150, 199, 0.35);
    transition: border-color var(--os-fast);
  }
  .os-inline-link:hover {
    border-color: var(--os-primary);
  }

  /* ═══════════════════════════════════════
     BREADCRUMB
  ═══════════════════════════════════════ */
  .bc {
    background: var(--os-surface);
    border-bottom: 1px solid var(--os-border-light);
    padding: 14px 0;
    position: relative;
    z-index: 10;
  }
  .bc ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .bc li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
  }
  .bc a {
    color: var(--os-primary);
    text-decoration: none;
    transition: opacity var(--os-fast);
  }
  .bc a:hover {
    opacity: 0.75;
  }
  .bc i {
    font-size: 0.65rem;
    color: var(--os-text-muted);
  }
  .bc span {
    color: var(--os-text-light);
    font-weight: 500;
  }

  /* ═══════════════════════════════════════
     PAGE HERO
  ═══════════════════════════════════════ */
  .os-hero {
    position: relative;
    overflow: hidden;
    min-height: 580px;
    display: flex;
    align-items: flex-end;
  }
  .os-hero-img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  .os-hero-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    display: block;
  }
  .os-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      rgba(0, 35, 60, 0.88) 0%,
      rgba(0, 35, 60, 0.5) 45%,
      rgba(0, 35, 60, 0.18) 75%,
      transparent 100%
    );
  }
  .os-hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      100deg,
      rgba(0, 109, 148, 0.45) 0%,
      transparent 60%
    );
  }
  .os-hero-inner {
    position: relative;
    z-index: 2;
    padding-bottom: 96px;
    padding-top: 80px;
  }
  .os-hero-content {
    max-width: 760px;
  }
  .os-hero-title {
    font-family: "Playfair Display", serif;
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 900;
    color: #fff;
    line-height: 1.1;
    margin-bottom: 20px;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
  }
  .os-hero-accent {
    color: var(--os-primary-light);
    font-style: italic;
    display: block;
  }
  .os-hero-sub {
    font-size: clamp(1rem, 1.6vw, 1.1rem);
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.75;
    margin-bottom: 32px;
    max-width: 580px;
  }
  .os-hero-chips {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .os-chip {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 12px 22px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--os-radius-md);
    backdrop-filter: blur(10px);
    text-align: center;
  }
  .os-chip-num {
    font-family: "Playfair Display", serif;
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--os-primary-light);
    line-height: 1;
  }
  .os-chip-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 4px;
  }

  .os-hero-wave {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    z-index: 3;
    pointer-events: none;
    line-height: 0;
  }
  .os-hero-wave svg {
    width: 100%;
    height: 56px;
    display: block;
  }

  /* ═══════════════════════════════════════
     CHAPTERS (common)
  ═══════════════════════════════════════ */
  .os-chapter {
    padding: 96px 0;
    background: var(--os-bg);
  }
  .os-chapter--alt {
    background: var(--os-surface);
  }
  .os-chapter--bleed {
    background: var(--os-bg);
    padding: 80px 0;
  }
  .os-chapter--challenge {
    background: var(--os-bg-alt);
  }

  .os-chapter-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: center;
  }

  /* Ghost chapter number */
  .os-ch-num {
    font-family: "Playfair Display", serif;
    font-size: clamp(4rem, 8vw, 7rem);
    font-weight: 900;
    line-height: 0.85;
    color: var(--os-primary);
    opacity: 0.07;
    letter-spacing: -0.04em;
    margin-bottom: -8px;
    user-select: none;
    pointer-events: none;
  }
  .os-chapter--alt .os-ch-num {
    color: var(--os-green);
  }
  .os-chapter--challenge .os-ch-num {
    color: var(--os-primary);
  }

  .os-ch-title {
    font-family: "Playfair Display", serif;
    font-size: clamp(1.7rem, 2.8vw, 2.3rem);
    font-weight: 700;
    color: var(--os-text);
    line-height: 1.2;
    margin-bottom: 22px;
    margin-top: 6px;
  }
  .os-ch-lead {
    font-size: 1.06rem;
    font-weight: 500;
    color: var(--os-text);
    line-height: 1.78;
    margin-bottom: 18px;
  }
  .os-chapter-text p:not(.os-ch-lead) {
    font-size: 0.975rem;
    color: var(--os-text-light);
    line-height: 1.82;
    margin-bottom: 18px;
  }
  .os-chapter-text p:last-of-type {
    margin-bottom: 0;
  }

  /* Pull-quote */
  .os-pullquote {
    position: relative;
    margin: 32px 0;
    padding: 28px 28px 28px 52px;
    background: var(--os-surface);
    border-radius: var(--os-radius-md);
    box-shadow: var(--os-shadow-sm);
    border-left: 3px solid var(--os-primary);
  }
  .os-pq-mark {
    position: absolute;
    top: -4px;
    left: 16px;
    font-family: "Playfair Display", serif;
    font-size: 5rem;
    font-weight: 900;
    color: var(--os-primary);
    opacity: 0.18;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }
  .os-pullquote p {
    font-size: 1.06rem;
    font-style: italic;
    color: var(--os-text);
    line-height: 1.72;
    margin: 0 0 14px;
  }
  .os-pullquote cite {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--os-primary);
    font-style: normal;
    letter-spacing: 0.03em;
  }

  /* Stat pair */
  .os-stat-pair {
    display: flex;
    align-items: stretch;
    gap: 0;
    background: var(--os-bg);
    border: 1px solid var(--os-border);
    border-radius: var(--os-radius-md);
    overflow: hidden;
    margin: 28px 0;
  }
  .os-stat-pair-item {
    flex: 1;
    padding: 18px 22px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .os-stat-pair-num {
    font-family: "Playfair Display", serif;
    font-size: 1.55rem;
    font-weight: 800;
    color: var(--os-primary);
  }
  .os-stat-pair-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--os-text-light);
    letter-spacing: 0.02em;
  }
  .os-stat-pair-divider {
    width: 1px;
    background: var(--os-border);
    align-self: stretch;
    flex-shrink: 0;
  }

  /* ═══════════════════════════════════════
     MEDIA FRAMES
  ═══════════════════════════════════════ */
  .os-img-frame {
    border-radius: var(--os-radius-lg);
    overflow: hidden;
    box-shadow: var(--os-shadow-xl);
    position: relative;
    transition: transform var(--os-slow) var(--os-ease);
  }
  .os-img-frame:hover {
    transform: translateY(-6px);
  }
  .os-img-frame picture {
    display: block;
    width: 100%;
  }
  .os-img-frame img {
    width: 100%;
    height: 400px;
    object-fit: cover;
    display: block;
  }
  .os-img-frame--portrait img {
    height: 520px;
  }

  .os-img-label {
    padding: 12px 16px;
    background: var(--os-surface);
    font-size: 0.76rem;
    color: var(--os-text-muted);
    text-align: center;
    letter-spacing: 0.02em;
  }

  /* ═══════════════════════════════════════
     CHAPTER 3 BLEED CARD
  ═══════════════════════════════════════ */
  .os-bleed-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-radius: var(--os-radius-lg);
    overflow: hidden;
    box-shadow: var(--os-shadow-xl);
  }
  .os-bleed-text {
    padding: 56px 48px;
    background: var(--os-surface);
  }
  .os-bleed-text .os-ch-title {
    margin-bottom: 18px;
  }
  .os-bleed-text p {
    font-size: 0.975rem;
    color: var(--os-text-light);
    line-height: 1.82;
    margin-bottom: 18px;
  }
  .os-bleed-text p:first-of-type {
    font-size: 1.06rem;
    font-weight: 500;
    color: var(--os-text);
  }

  .os-milestone-list {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .os-milestone-list li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.92rem;
    color: var(--os-text-light);
  }
  .os-milestone-icon {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(46, 139, 87, 0.1);
    border: 1px solid rgba(46, 139, 87, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    color: var(--os-green);
  }

  .os-bleed-media {
    position: relative;
    overflow: hidden;
    min-height: 440px;
  }
  .os-bleed-media picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .os-bleed-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--os-slow) var(--os-ease);
  }
  .os-bleed-card:hover .os-bleed-media img {
    transform: scale(1.04);
  }
  .os-bleed-media-tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(0, 109, 148, 0.18) 0%,
      transparent 50%
    );
  }

  /* ═══════════════════════════════════════
     MISSION / VISION / MOTTO
  ═══════════════════════════════════════ */
  .os-mvv {
    position: relative;
    padding: 96px 0;
    overflow: hidden;
  }
  .os-mvv-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(
      135deg,
      var(--os-primary-dark) 0%,
      var(--os-primary) 55%,
      var(--os-primary-light) 100%
    );
  }
  .os-mvv-pattern {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .os-mvv-pattern svg {
    width: 100%;
    height: 100%;
  }
  .os-mvv-inner {
    position: relative;
    z-index: 1;
    text-align: center;
  }
  .os-mvv-heading {
    font-family: "Playfair Display", serif;
    font-size: clamp(1.9rem, 3vw, 2.6rem);
    font-weight: 700;
    color: #fff;
    margin-bottom: 48px;
  }
  .os-mvv-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .os-mvv-card {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--os-radius-lg);
    padding: 40px 32px;
    text-align: left;
    transition: all var(--os-base) var(--os-ease);
  }
  .os-mvv-card:hover {
    background: rgba(255, 255, 255, 0.13);
    border-color: rgba(255, 255, 255, 0.24);
    transform: translateY(-6px);
  }
  .os-mvv-card--accent {
    background: rgba(46, 139, 87, 0.14);
    border-color: rgba(61, 173, 110, 0.3);
  }
  .os-mvv-card--accent:hover {
    background: rgba(46, 139, 87, 0.22);
    border-color: rgba(61, 173, 110, 0.5);
  }
  .os-mvv-card--motto {
    background: rgba(72, 184, 216, 0.1);
    border-color: rgba(72, 184, 216, 0.28);
  }
  .os-mvv-card--motto:hover {
    background: rgba(72, 184, 216, 0.18);
  }

  .os-mvv-card-icon {
    width: 54px;
    height: 54px;
    border-radius: var(--os-radius-md);
    margin-bottom: 18px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    color: var(--os-primary-light);
    transition: all var(--os-base) var(--os-ease);
  }
  .os-mvv-card:hover .os-mvv-card-icon {
    transform: scale(1.1) rotate(-5deg);
  }
  .os-mvv-card h3 {
    font-family: "Playfair Display", serif;
    font-size: 1.2rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 12px;
  }
  .os-mvv-card p {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.78;
  }
  .os-mvv-motto-text {
    font-family: "Playfair Display", serif;
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--os-primary-light);
    font-style: italic;
  }

  /* ═══════════════════════════════════════
     CHAPTER 4 CHALLENGE BOX
  ═══════════════════════════════════════ */
  .os-challenge-box {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    background: rgba(0, 150, 199, 0.07);
    border: 1px solid var(--os-border);
    border-left: 4px solid var(--os-primary);
    border-radius: var(--os-radius-md);
    padding: 20px 22px;
    margin: 24px 0;
  }
  .os-challenge-box i {
    font-size: 1.2rem;
    color: var(--os-primary);
    flex-shrink: 0;
    margin-top: 2px;
  }
  .os-challenge-box div {
    flex: 1;
  }
  .os-challenge-box strong {
    display: block;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--os-text);
    margin-bottom: 8px;
  }
  .os-challenge-box ul {
    margin: 0;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .os-challenge-box li {
    font-size: 0.87rem;
    color: var(--os-text-light);
  }

  .os-cta-pair {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 32px;
  }

  /* Challenge media */
  .os-challenge-img-wrap {
    border-radius: var(--os-radius-lg);
    overflow: hidden;
    box-shadow: var(--os-shadow-xl);
    position: relative;
  }
  .os-challenge-img-wrap picture {
    display: block;
    width: 100%;
  }
  .os-challenge-img-wrap img {
    width: 100%;
    height: 440px;
    object-fit: cover;
    display: block;
    transition: transform var(--os-slow) var(--os-ease);
  }
  .os-challenge-img-wrap:hover img {
    transform: scale(1.03);
  }
  .os-challenge-img-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(
      to top,
      rgba(0, 35, 60, 0.8) 0%,
      transparent 100%
    );
    padding: 32px 20px 18px;
    display: flex;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.82rem;
    font-weight: 600;
  }
  .os-challenge-img-caption i {
    color: var(--os-primary-light);
  }

  /* ═══════════════════════════════════════
     PARTNERS SECTION (logo grid)
  ═══════════════════════════════════════ */
  .os-partners {
    padding: 80px 0;
    background: var(--os-surface);
    border-top: 1px solid var(--os-border-light);
    text-align: center;
  }
  .os-partners-header {
    margin-bottom: 36px;
  }
  .os-partners-heading {
    font-family: "Playfair Display", serif;
    font-size: clamp(1.7rem, 2.5vw, 2.1rem);
    font-weight: 700;
    color: var(--os-text);
    margin-bottom: 10px;
  }
  .os-partners-header p {
    font-size: 1rem;
    color: var(--os-text-light);
  }

  .os-partners-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 32px;
  }
  .os-partner-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 24px 16px;
    background: var(--os-bg);
    border: 1px solid var(--os-border-light);
    border-radius: var(--os-radius-md);
    text-decoration: none;
    min-height: 140px;
    transition: all var(--os-fast) var(--os-ease);
  }
  .os-partner-card:hover {
    box-shadow: var(--os-shadow-md);
    transform: translateY(-4px);
    border-color: var(--os-primary);
  }
  .os-partner-logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 70px;
  }
  .os-partner-logo-wrap picture {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }
  .os-partner-logo-wrap img {
    max-width: 100%;
    max-height: 60px;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: grayscale(0.35) opacity(0.85);
    transition: all var(--os-base);
  }
  .os-partner-card:hover .os-partner-logo-wrap img {
    filter: grayscale(0) opacity(1);
    transform: scale(1.05);
  }
  .os-partner-logo-fallback {
    width: 50px;
    height: 50px;
    background: rgba(0, 150, 199, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    color: var(--os-primary);
  }
  .os-partner-name {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--os-text-light);
    text-align: center;
    line-height: 1.3;
    transition: color var(--os-fast);
  }
  .os-partner-card:hover .os-partner-name {
    color: var(--os-primary);
  }

  .os-partners-footer {
    margin-top: 12px;
  }

  /* ═══════════════════════════════════════
     FINAL CTA
  ═══════════════════════════════════════ */
  .os-final-cta {
    padding: 64px 0 80px;
    background: var(--os-bg);
  }

  .os-cta-card {
    position: relative;
    overflow: hidden;
    border-radius: var(--os-radius-lg);
    background: linear-gradient(
      120deg,
      var(--os-primary-dark) 0%,
      var(--os-primary) 60%,
      var(--os-primary-light) 100%
    );
    padding: 72px 48px;
    text-align: center;
