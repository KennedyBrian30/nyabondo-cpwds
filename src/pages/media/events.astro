---
// src/pages/media/events.astro
import Layout from "../../layouts/Layout.astro";
import { getCollection } from 'astro:content';

// Fetch all news/events from the 'events' collection
const allEvents = await getCollection('events');

// Sort events by date (newest first)
const events = allEvents.sort((a, b) => {
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

// Get featured events (those marked as featured or the 2 most recent)
const featuredEvents = events.filter(event => event.data.featured === true).slice(0, 2);
// If no featured events, use the 2 most recent
const featuredToShow = featuredEvents.length > 0 ? featuredEvents : events.slice(0, 2);

// Get all events for the main grid
const allEventsList = events;

// Get unique categories for filter buttons
const categories = ["All", ...new Set(events.map(event => event.data.category).filter(Boolean))];

// Helper function to format date
const formatDate = (date) => {
  if (!date) return '';
  const d = new Date(date);
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
};

// Helper function to get relative time
const getRelativeTime = (date) => {
  if (!date) return '';
  const now = new Date();
  const diff = now.getTime() - new Date(date).getTime();
  const days = Math.floor(diff / (1000 * 60 * 60 * 24));
  
  if (days === 0) return 'Today';
  if (days === 1) return 'Yesterday';
  if (days < 7) return `${days} days ago`;
  if (days < 30) return `${Math.floor(days / 7)} weeks ago`;
  if (days < 365) return `${Math.floor(days / 30)} months ago`;
  return `${Math.floor(days / 365)} years ago`;
};

// Breadcrumbs
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Media", href: "/media" },
  { label: "Events & Updates", href: "/media/events" },
];
---

<Layout
  title="Events & Updates | Nyabondo Centre for Persons with Disabilities"
  description="Stay updated with the latest news, events, and announcements from Nyabondo Centre. Read about our community outreaches, project launches, and impact stories."
>

  <!-- BREADCRUMB -->
  <nav class="events-bc" aria-label="Breadcrumb">
    <div class="events-container">
      <ol>
        {
          breadcrumbs.map((c, i) => (
            <li>
              {i < breadcrumbs.length - 1 ? (
                <a href={c.href}>{c.label}</a>
              ) : (
                <span aria-current="page">{c.label}</span>
              )}
              {i < breadcrumbs.length - 1 && (
                <i class="fas fa-chevron-right" aria-hidden="true" />
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </nav>

  <!-- ══════════════════════════════════════════ HERO SECTION ══════════════════════════════════════════ -->
  <section class="events-hero">
    <div class="events-hero-overlay"></div>
    <div class="events-hero-content">
      <span class="hero-eyebrow">
        <i class="fas fa-newspaper"></i> Stay Informed
      </span>
      <h1>Events &amp; <span class="hero-accent">Updates</span></h1>
      <p>Latest news, announcements, and stories from Nyabondo Centre's programs, community outreaches, and rehabilitation initiatives across Kenya.</p>
    </div>
  </section>

  <!-- ══════════════════════════════════════════ FEATURED EVENTS ══════════════════════════════════════════ -->
  {featuredToShow.length > 0 && (
    <section class="featured-section">
      <div class="section-inner">
        <div class="section-header">
          <div class="section-eyebrow"><i class="fas fa-star"></i> Featured Updates</div>
          <h2>What's <span class="accent-primary">New</span></h2>
          <div class="section-divider"></div>
          <p class="section-subtitle">Recent news and updates from our programs and initiatives</p>
        </div>

        <div class="featured-grid">
          {featuredToShow.map((event) => (
            <a href={`/media/events/${event.id}`} class="featured-card" key={event.id}>
              <div class="featured-image">
                <img src={event.data.image || '/images/events/placeholder.webp'} alt={event.data.title} loading="lazy" />
                <div class="featured-category">
                  <i class="fas fa-tag"></i> {event.data.category || 'Update'}
                </div>
                {event.data.featured && (
                  <div class="featured-badge">
                    <i class="fas fa-star"></i> Featured
                  </div>
                )}
              </div>
              <div class="featured-content">
                <div class="post-meta">
                  <span><i class="fas fa-calendar-alt"></i> {formatDate(event.data.date)}</span>
                  <span><i class="fas fa-clock"></i> {getRelativeTime(event.data.date)}</span>
                </div>
                <h3 class="featured-title">{event.data.title}</h3>
                <p class="featured-excerpt">{event.data.excerpt || event.data.description}</p>
                <div class="featured-author">
                  {event.data.authorImage && (
                    <img src={event.data.authorImage} alt={event.data.author} class="author-avatar" />
                  )}
                  <span class="author-name">{event.data.author || 'Nyabondo Editorial'}</span>
                </div>
                <span class="read-more">Read More <i class="fas fa-arrow-right"></i></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ══════════════════════════════════════════ ALL EVENTS ══════════════════════════════════════════ -->
  <section class="all-events-section">
    <div class="section-inner">
      <div class="section-header">
        <div class="section-eyebrow"><i class="fas fa-list-ul"></i> All Updates</div>
        <h2>Latest <span class="accent-primary">News &amp; Stories</span></h2>
        <div class="section-divider"></div>
        <p class="section-subtitle">Explore all our news, announcements, and impact stories</p>
      </div>

      <!-- Category Filters -->
      {categories.length > 1 && (
        <div class="filter-buttons" id="filterButtons">
          {categories.map(category => (
            <button class="filter-btn" data-category={category} key={category}>
              {category}
            </button>
          ))}
        </div>
      )}

      <!-- Events Grid -->
      <div class="events-grid" id="eventsGrid">
        {allEventsList.map((event, idx) => (
          <div class="event-card" data-category={event.data.category || 'Uncategorized'} key={event.id}>
            <div class="event-image">
              <img src={event.data.image || '/images/events/placeholder.webp'} alt={event.data.title} loading="lazy" />
              <div class="event-category-badge">
                <i class="fas fa-tag"></i> {event.data.category || 'Update'}
              </div>
            </div>
            <div class="event-content">
              <div class="post-meta">
                <span><i class="fas fa-calendar-alt"></i> {formatDate(event.data.date)}</span>
                <span><i class="fas fa-clock"></i> {getRelativeTime(event.data.date)}</span>
              </div>
              <h3 class="event-title">{event.data.title}</h3>
              <p class="event-excerpt">{event.data.excerpt || event.data.description}</p>
              <div class="event-footer">
                <div class="event-author">
                  {event.data.authorImage && (
                    <img src={event.data.authorImage} alt={event.data.author} class="author-avatar-small" />
                  )}
                  <span>{event.data.author || 'Nyabondo Editorial'}</span>
                </div>
                <a href={`/media/events/${event.id}`} class="read-link">Read <i class="fas fa-arrow-right"></i></a>
              </div>
            </div>
          </div>
        ))}
      </div>

      {allEventsList.length === 0 && (
        <div class="no-events">
          <i class="fas fa-newspaper"></i>
          <h3>No updates yet</h3>
          <p>Check back soon for the latest news and updates from Nyabondo Centre.</p>
        </div>
      )}
    </div>
  </section>

  <!-- ══════════════════════════════════════════ CTA SECTION ══════════════════════════════════════════ -->
  <section class="events-cta-section">
    <div class="cta-container">
      <div class="cta-content">
        <div class="cta-eyebrow">Stay Connected</div>
        <h2>Get the Latest <span class="cta-highlight">Updates</span> First</h2>
        <p>Subscribe to our newsletter to receive news, success stories, and updates straight to your inbox.</p>
        <div class="cta-buttons">
          <a href="/contact" class="btn-cta-primary">
            <i class="fas fa-envelope"></i> Subscribe Now
          </a>
          <a href="/get-involved/donate" class="btn-cta-secondary">
            <i class="fas fa-heart"></i> Support Our Work
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* =============================================
     EVENTS PAGE STYLES
  ============================================= */
  :root {
    --events-primary: #0096c7;
    --events-primary-dark: #006d94;
    --events-primary-light: #48b8d8;
    --events-secondary: #2e8b57;
    --events-text: #0d2b38;
    --events-text-light: #2e5a6b;
    --events-bg: #f4fcff;
    --events-surface: #ffffff;
    --events-border: #c7e9f4;
    --events-shadow: 0 6px 24px rgba(0, 150, 199, 0.1);
    --events-radius: 14px;
    --events-ease: cubic-bezier(0.16, 1, 0.3, 1);
  }

  .events-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Breadcrumb */
  .events-bc {
    background: var(--events-surface);
    border-bottom: 1px solid var(--events-border);
    padding: 12px 0;
  }
  .events-bc ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .events-bc li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
  }
  .events-bc a {
    color: var(--events-primary);
    text-decoration: none;
  }
  .events-bc a:hover {
    text-decoration: underline;
  }
  .events-bc span {
    color: var(--events-text-light);
  }
  .events-bc i {
    font-size: 0.65rem;
    color: var(--events-text-light);
  }

  /* ══════════════════════════════════════════ HERO SECTION ══════════════════════════════════════════ */
  .events-hero {
    position: relative;
    min-height: 50vh;
    display: flex;
    align-items: center;
    background: linear-gradient(135deg, var(--events-primary-dark) 0%, var(--events-primary) 100%);
    overflow: hidden;
  }
  
  .events-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url('/images/hero/hero-community-outreach.webp');
    background-size: cover;
    background-position: center;
    opacity: 0.12;
    filter: blur(2px);
  }
  
  .events-hero-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 30% 40%, rgba(0, 109, 148, 0.6) 0%, var(--events-primary-dark) 100%);
  }
  
  .events-hero-content {
    position: relative;
    z-index: 2;
    max-width: 800px;
    padding: 4rem 5%;
    margin-left: 5%;
  }
  
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(72, 184, 216, 0.2);
    backdrop-filter: blur(8px);
    color: var(--events-primary-light);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.4rem 1rem;
    border-radius: 40px;
    margin-bottom: 1.25rem;
    border: 1px solid rgba(72, 184, 216, 0.3);
  }
  
  .events-hero-content h1 {
    font-family: "Playfair Display", serif;
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.1;
    color: white;
    margin-bottom: 1.25rem;
  }
  
  .hero-accent {
    color: var(--events-primary-light);
    font-style: italic;
  }
  
  .events-hero-content p {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.7;
    max-width: 580px;
  }

  /* ══════════════════════════════════════════ FEATURED SECTION ══════════════════════════════════════════ */
  .featured-section {
    padding: 5rem 0;
    background: linear-gradient(135deg, #fff 0%, var(--events-bg) 100%);
  }
  
  .section-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  
  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }
  
  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(0, 150, 199, 0.08);
    color: var(--events-primary);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.35rem 1rem;
    border-radius: 40px;
    margin-bottom: 0.85rem;
  }
  
  .section-header h2 {
    font-family: "Playfair Display", serif;
    font-size: 2.2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--events-text);
  }
  
  .accent-primary {
    color: var(--events-primary);
  }
  
  .section-divider {
    width: 60px;
    height: 3px;
    background: linear-gradient(90deg, var(--events-primary), var(--events-secondary));
    margin: 0.75rem auto 1.25rem;
    border-radius: 3px;
  }
  
  .section-subtitle {
    font-size: 0.95rem;
    color: var(--events-text-light);
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.6;
  }
  
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
  
  .featured-card {
    background: var(--events-surface);
    border-radius: 28px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: all 0.4s var(--events-ease);
    border: 1px solid var(--events-border);
    display: flex;
    flex-direction: column;
  }
  
  .featured-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 50px rgba(0, 150, 199, 0.15);
    border-color: var(--events-primary);
  }
  
  .featured-image {
    position: relative;
    height: 280px;
    overflow: hidden;
  }
  
  .featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--events-ease);
  }
  
  .featured-card:hover .featured-image img {
    transform: scale(1.08);
  }
  
  .featured-category {
    position: absolute;
    top: 16px;
    left: 16px;
    background: var(--events-primary);
    color: white;
    padding: 0.3rem 0.9rem;
    border-radius: 30px;
    font-size: 0.7rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 6px;
    z-index: 1;
  }
  
  .featured-badge {
    position: absolute;
    top: 16px;
    right: 16px;
    background: var(--events-secondary);
    color: white;
    padding: 0.3rem 0.9rem;
    border-radius: 30px;
    font-size: 0.65rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 4px;
    z-index: 1;
  }
  
  .featured-content {
    padding: 1.75rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  .post-meta {
    display: flex;
    gap: 1rem;
    font-size: 0.7rem;
    color: var(--events-text-light);
    margin-bottom: 0.75rem;
  }
  
  .post-meta i {
    margin-right: 4px;
  }
  
  .featured-title {
    font-family: "Playfair Display", serif;
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.75rem;
    color: var(--events-text);
  }
  
  .featured-excerpt {
    font-size: 0.85rem;
    color: var(--events-text-light);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    flex: 1;
  }
  
  .featured-author {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 1rem;
  }
  
  .author-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
  }
  
  .author-name {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--events-text);
  }
  
  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--events-primary);
    font-weight: 700;
    font-size: 0.85rem;
    transition: gap 0.2s ease;
  }
  
  .featured-card:hover .read-more {
    gap: 12px;
  }

  /* ══════════════════════════════════════════ ALL EVENTS ══════════════════════════════════════════ */
  .all-events-section {
    padding: 5rem 0;
    background: var(--events-surface);
  }
  
  /* Filter Buttons */
  .filter-buttons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }
  
  .filter-btn {
    padding: 0.5rem 1.25rem;
    border: 2px solid var(--events-border);
    background: var(--events-surface);
    border-radius: 40px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--events-text);
    cursor: pointer;
    transition: all 0.3s ease;
  }
  
  .filter-btn:hover {
    border-color: var(--events-primary);
    color: var(--events-primary);
    transform: translateY(-2px);
  }
  
  .filter-btn.active {
    background: var(--events-primary);
    border-color: var(--events-primary);
    color: white;
  }
  
  /* Events Grid */
  .events-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  
  .event-card {
    background: var(--events-surface);
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid var(--events-border);
    transition: all 0.4s var(--events-ease);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    opacity: 0;
    transform: translateY(30px);
    animation: fadeUp 0.6s ease forwards;
  }
  
  @keyframes fadeUp {
    to { opacity: 1; transform: translateY(0); }
  }
  
  .event-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 48px rgba(0, 150, 199, 0.12);
    border-color: var(--events-primary);
  }
  
  .event-image {
    position: relative;
    height: 200px;
    overflow: hidden;
  }
  
  .event-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--events-ease);
  }
  
  .event-card:hover .event-image img {
    transform: scale(1.08);
  }
  
  .event-category-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--events-secondary);
    color: white;
    padding: 0.25rem 0.7rem;
    border-radius: 20px;
    font-size: 0.65rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  
  .event-content {
    padding: 1.25rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  .event-title {
    font-family: "Playfair Display", serif;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 0.5rem;
    color: var(--events-text);
  }
  
  .event-excerpt {
    font-size: 0.8rem;
    color: var(--events-text-light);
    line-height: 1.6;
    margin-bottom: 1rem;
    flex: 1;
  }
  
  .event-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--events-border);
  }
  
  .event-author {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.7rem;
    color: var(--events-text-light);
  }
  
  .author-avatar-small {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
  }
  
  .read-link {
    color: var(--events-primary);
    font-weight: 700;
    font-size: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: gap 0.2s;
    text-decoration: none;
  }
  
  .read-link:hover {
    gap: 8px;
  }
  
  .no-events {
    text-align: center;
    padding: 4rem;
    background: var(--events-bg);
    border-radius: 24px;
  }
  
  .no-events i {
    font-size: 3rem;
    color: var(--events-text-light);
    margin-bottom: 1rem;
  }
  
  .no-events h3 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
    color: var(--events-text);
  }
  
  .no-events p {
    color: var(--events-text-light);
  }

  /* ══════════════════════════════════════════ CTA SECTION ══════════════════════════════════════════ */
  .events-cta-section {
    background: linear-gradient(135deg, var(--events-primary) 0%, var(--events-primary-dark) 100%);
    padding: 4rem 2rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  
  .events-cta-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 70% 30%, rgba(255,255,255,0.1), transparent);
    pointer-events: none;
  }
  
  .cta-container {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  
  .cta-eyebrow {
    display: inline-block;
    background: rgba(255, 255, 255, 0.2);
    color: white;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.35rem 1.2rem;
    border-radius: 40px;
    margin-bottom: 1.5rem;
  }
  
  .cta-container h2 {
    font-family: "Playfair Display", serif;
    font-size: 2rem;
    font-weight: 700;
    color: white;
    margin-bottom: 1rem;
  }
  
  .cta-highlight {
    color: var(--events-primary-light);
  }
  
  .cta-container p {
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 2rem;
    font-size: 1rem;
  }
  
  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  
  .btn-cta-primary {
    background: white;
    color: var(--events-primary);
    padding: 0.85rem 2rem;
    border-radius: 50px;
