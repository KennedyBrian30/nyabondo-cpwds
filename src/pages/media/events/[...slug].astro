---
// src/pages/media/events/[...slug].astro
import Layout from "../../../layouts/Layout.astro";
import { getCollection, render } from 'astro:content';

// Get all events to generate paths
export async function getStaticPaths() {
  const allEvents = await getCollection('events');
  return allEvents.map((event) => ({
    params: { slug: event.id },
    props: { event },
  }));
}

// Get the current event from props
const { event } = Astro.props;

// Render the content
const { Content } = await render(event);

// Format date helper
const formatDate = (date) => {
  if (!date) return '';
  const d = new Date(date);
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
};

// Get relative time helper
const getRelativeTime = (date) => {
  if (!date) return '';
  const now = new Date();
  const diff = now.getTime() - new Date(date).getTime();
  const days = Math.floor(diff / (1000 * 60 * 60 * 24));
  
  if (days === 0) return 'Today';
  if (days === 1) return 'Yesterday';
  if (days < 7) return `${days} days ago`;
  if (days < 30) return `${Math.floor(days / 7)} weeks ago`;
  if (days < 365) return `${Math.floor(days / 30)} months ago`;
  return `${Math.floor(days / 365)} years ago`;
};

// Breadcrumbs
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Media", href: "/media" },
  { label: "Events & Updates", href: "/media/events" },
  { label: event.data.title, href: `/media/events/${event.id}` },
];
---

<Layout title={`${event.data.title} | Nyabondo Centre for Persons with Disabilities`}>
  <!-- Breadcrumb -->
  <nav class="event-bc" aria-label="Breadcrumb">
    <div class="event-container">
      <ol>
        {
          breadcrumbs.map((c, i) => (
            <li>
              {i < breadcrumbs.length - 1 ? (
                <a href={c.href}>{c.label}</a>
              ) : (
                <span aria-current="page">{c.label}</span>
              )}
              {i < breadcrumbs.length - 1 && (
                <i class="fas fa-chevron-right" aria-hidden="true" />
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </nav>

  <!-- Article -->
  <article class="event-article">
    <div class="event-container">
      <div class="event-header">
        <div class="event-category">
          <i class={event.data.categoryIcon || 'fas fa-newspaper'}></i>
          {event.data.category || 'Update'}
        </div>
        <h1 class="event-title">{event.data.title}</h1>
        <div class="event-meta">
          <span><i class="fas fa-calendar-alt"></i> {formatDate(event.data.date)}</span>
          <span><i class="fas fa-clock"></i> {getRelativeTime(event.data.date)}</span>
          {event.data.author && (
            <span><i class="fas fa-user"></i> {event.data.author}</span>
          )}
          {event.data.location && (
            <span><i class="fas fa-location-dot"></i> {event.data.location}</span>
          )}
        </div>
        {event.data.image && (
          <div class="event-hero-image">
            <img src={event.data.image} alt={event.data.title} />
          </div>
        )}
        <p class="event-description">{event.data.description || event.data.excerpt}</p>
      </div>
      <div class="event-content">
        <!-- This renders the full Markdown content -->
        <Content />
      </div>
    </div>
  </article>

  <!-- Back to Events -->
  <section class="event-back">
    <div class="event-container">
      <a href="/media/events" class="btn-back">
        <i class="fas fa-arrow-left"></i> Back to Events & Updates
      </a>
    </div>
  </section>
</Layout>

<style>
  .event-container {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .event-bc {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 12px 0;
  }
  .event-bc ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .event-bc li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
  }
  .event-bc a {
    color: var(--primary);
    text-decoration: none;
  }
  .event-bc a:hover {
    text-decoration: underline;
  }
  .event-bc span {
    color: var(--text-light);
  }
  .event-bc i {
    font-size: 0.65rem;
    color: var(--text-light);
  }

  .event-article {
    padding: 60px 0 40px;
    background: var(--surface);
  }

  .event-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .event-category {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(0, 150, 199, 0.1);
    color: var(--primary);
    padding: 4px 16px;
    border-radius: 40px;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 20px;
  }

  .event-title {
    font-family: "Playfair Display", serif;
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 800;
    color: var(--text);
    line-height: 1.2;
    margin-bottom: 16px;
  }

  .event-meta {
    display: flex;
    justify-content: center;
    gap: 24px;
    font-size: 0.85rem;
    color: var(--text-light);
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .event-meta i {
    margin-right: 4px;
  }

  .event-hero-image {
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 24px;
  }

  .event-hero-image img {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
  }

  .event-description {
    font-size: 1.1rem;
    color: var(--text-light);
    line-height: 1.7;
    max-width: 680px;
    margin: 0 auto;
  }

  .event-content {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--text);
  }

  .event-content h2 {
    font-family: "Playfair Display", serif;
    font-size: 1.6rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .event-content h3 {
    font-family: "Playfair Display", serif;
    font-size: 1.3rem;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .event-content h4 {
    font-family: "Playfair Display", serif;
    font-size: 1.1rem;
    margin-top: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .event-content p {
    margin-bottom: 1.25rem;
  }

  .event-content img {
    max-width: 100%;
    border-radius: 12px;
    margin: 1.5rem 0;
  }

  .event-content blockquote {
    border-left: 4px solid var(--primary);
    padding-left: 1.5rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--text-light);
  }

  .event-content ul, .event-content ol {
    margin: 1rem 0 1.5rem 1.5rem;
  }

  .event-content li {
    margin-bottom: 0.5rem;
  }

  .event-back {
    padding: 40px 0 80px;
    background: var(--background);
  }

  .btn-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--primary);
    font-weight: 600;
    text-decoration: none;
    transition: gap 0.2s;
  }

  .btn-back:hover {
    gap: 12px;
  }

  /* Event inline styles (from markdown) */
  .event-content .event-intro {
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--text);
    padding: 1.5rem 0;
    border-bottom: 2px solid var(--border-light);
    margin-bottom: 2rem;
  }

  .event-content .event-intro p {
    margin: 0;
  }

  .event-content .event-image {
    margin: 2.5rem 0;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
  }

  .event-content .event-image img {
    width: 100%;
    max-height: 450px;
    object-fit: cover;
    display: block;
  }

  .event-content .event-image .image-caption {
    padding: 0.75rem 1.5rem;
    background: var(--background);
    font-size: 0.85rem;
    color: var(--text-light);
    text-align: center;
    margin: 0;
    font-style: italic;
  }

  .event-content .event-highlight {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    background: linear-gradient(135deg, rgba(0, 150, 199, 0.06) 0%, rgba(46, 139, 87, 0.04) 100%);
    border-left: 4px solid var(--primary);
    padding: 1.25rem 1.75rem;
    border-radius: 8px;
    margin: 1.75rem 0;
  }

  .event-content .event-highlight i {
    font-size: 1.5rem;
    color: var(--primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .event-content .event-highlight div {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-light);
  }

  .event-content .event-highlight strong {
    color: var(--text);
  }

  .event-content .event-quote {
    background: var(--background);
    border-radius: 12px;
    padding: 2rem 2rem 1.5rem;
    margin: 2rem 0;
    position: relative;
    border: 1px solid var(--border-light);
  }

  .event-content .event-quote i.fa-quote-left {
    font-size: 2.5rem;
    color: var(--primary-light);
    opacity: 0.3;
    margin-bottom: 0.5rem;
    display: block;
  }

  .event-content .event-quote blockquote {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text);
    font-style: italic;
    margin: 0 0 0.75rem 0;
    padding: 0;
    border: none;
  }

  .event-content .event-quote cite {
    font-size: 0.9rem;
    color: var(--text-light);
    font-style: normal;
    font-weight: 600;
    display: block;
  }

  .event-content .event-testimonial {
    background: linear-gradient(135deg, rgba(0, 150, 199, 0.06) 0%, rgba(46, 139, 87, 0.04) 100%);
    border-radius: 12px;
    padding: 2rem 2.5rem;
    margin: 2rem 0;
    text-align: center;
    border: 1px solid var(--border-light);
  }

  .event-content .event-testimonial i.fa-quote-right {
    font-size: 2.5rem;
    color: var(--primary-light);
    opacity: 0.3;
    margin-bottom: 0.5rem;
    display: block;
  }

  .event-content .event-testimonial blockquote {
    font-size: 1.2rem;
    line-height: 1.7;
    color: var(--text);
    font-style: italic;
    margin: 0 0 0.75rem 0;
    padding: 0;
    border: none;
  }

  .event-content .event-testimonial cite {
    font-size: 0.9rem;
    color: var(--text-light);
    font-style: normal;
    font-weight: 600;
  }

  .event-content .highlight-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .event-content .highlight-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 0.75rem 1rem;
    background: rgba(46, 139, 87, 0.04);
    border-radius: 8px;
    border: 1px solid rgba(46, 139, 87, 0.1);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-light);
  }

  .event-content .highlight-list li i {
    color: var(--secondary);
    flex-shrink: 0;
    margin-top: 2px;
    font-size: 0.9rem;
  }

  .event-content .highlight-list li strong {
    color: var(--text);
  }

  .event-content .event-conclusion {
    background: linear-gradient(135deg, var(--secondary) 0%, var(--secondary-dark) 100%);
    border-radius: 12px;
    padding: 2rem 2.5rem;
    margin: 2rem 0 1.5rem;
    text-align: center;
    color: white;
  }

  .event-content .event-conclusion p {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.7;
    font-family: "Playfair Display", serif;
    font-weight: 700;
  }

  .event-content .event-cta {
    background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary) 100%);
    border-radius: 12px;
    padding: 2rem 2.5rem;
    margin: 2.5rem 0 1rem;
    text-align: center;
    color: white;
  }

  .event-content .event-cta p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.9);
  }

  .event-content .event-cta a {
    color: var(--primary-light);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .event-content .event-cta a:hover {
    color: white;
  }

  /* Date badge for events */
  .event-content .event-date-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(0, 150, 199, 0.08);
    border: 1px solid var(--border);
    padding: 0.5rem 1.25rem;
    border-radius: 40px;
    font-size: 0.85rem;
    color: var(--text-light);
    margin: 1rem 0 1.5rem;
  }

  .event-content .event-date-badge i {
    color: var(--primary);
  }

  @media (max-width: 768px) {
    .event-content .highlight-list {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .event-content .event-intro {
      font-size: 1rem;
    }

    .event-content .event-highlight {
      flex-direction: column;
      align-items: flex-start;
      padding: 1rem 1.25rem;
    }

    .event-content .event-quote {
      padding: 1.5rem;
    }

    .event-content .event-quote blockquote {
      font-size: 1rem;
    }

    .event-content .event-testimonial {
      padding: 1.5rem;
    }

    .event-content .event-testimonial blockquote {
      font-size: 1rem;
    }

    .event-content .event-conclusion {
      padding: 1.5rem;
    }

    .event-content .event-conclusion p {
      font-size: 1rem;
    }

    .event-content .event-cta {
      padding: 1.5rem 1.25rem;
    }

    .event-content .event-image img {
      max-height: 280px;
    }

    .event-content .event-image .image-caption {
      font-size: 0.75rem;
      padding: 0.5rem 1rem;
    }

    .event-meta {
      flex-direction: column;
      align-items: center;
      gap: 8px;
    }

    .event-title {
      font-size: 1.8rem;
    }

    .event-content {
      font-size: 0.95rem;
    }
  }

  @media (max-width: 480px) {
    .event-content .event-image img {
      max-height: 220px;
    }

    .event-content .event-highlight div {
      font-size: 0.9rem;
    }

    .event-content .highlight-list li {
      font-size: 0.85rem;
      padding: 0.6rem 0.8rem;
    }
  }
</style>