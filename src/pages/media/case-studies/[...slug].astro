---
// src/pages/media/case-studies/[...slug].astro
import Layout from "../../../layouts/Layout.astro";
import { getCollection, render } from 'astro:content';

// Get all case studies to generate paths
export async function getStaticPaths() {
  const allStudies = await getCollection('case-studies');
  return allStudies.map((study) => ({
    params: { slug: study.id },
    props: { study },
  }));
}

// Get the current study from props
const { study } = Astro.props;

// Render the content
const { Content } = await render(study);

// Format date helper
const formatDate = (date) => {
  if (!date) return '';
  const d = new Date(date);
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
};

// Breadcrumbs
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Media", href: "/media" },
  { label: "Case Studies", href: "/media/case-studies" },
  { label: study.data.title, href: `/media/case-studies/${study.id}` },
];
---

<Layout title={`${study.data.title} | Nyabondo Centre for Persons with Disabilities`}>
  <!-- Breadcrumb -->
  <nav class="study-bc" aria-label="Breadcrumb">
    <div class="study-container">
      <ol>
        {
          breadcrumbs.map((c, i) => (
            <li>
              {i < breadcrumbs.length - 1 ? (
                <a href={c.href}>{c.label}</a>
              ) : (
                <span aria-current="page">{c.label}</span>
              )}
              {i < breadcrumbs.length - 1 && (
                <i class="fas fa-chevron-right" aria-hidden="true" />
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </nav>

  <!-- Article -->
  <article class="study-article">
    <div class="study-container">
      <div class="study-header">
        <div class="study-category">
          <i class={study.data.categoryIcon || 'fas fa-tag'}></i>
          {study.data.category || 'Case Study'}
        </div>
        <h1 class="study-title">{study.data.title}</h1>
        <div class="study-meta">
          <span><i class="fas fa-calendar-alt"></i> {formatDate(study.data.pubDate)}</span>
          <span><i class="fas fa-clock"></i> {study.data.readTime || '5 min read'}</span>
          {study.data.author && (
            <span><i class="fas fa-user"></i> {study.data.author}</span>
          )}
        </div>
        {study.data.image && (
          <div class="study-hero-image">
            <img src={study.data.image} alt={study.data.title} />
          </div>
        )}
        <p class="study-description">{study.data.description || study.data.excerpt}</p>
      </div>
      <div class="study-content">
        <!-- This renders the full Markdown content -->
        <Content />
      </div>
    </div>
  </article>

  <!-- Back to Case Studies -->
  <section class="study-back">
    <div class="study-container">
      <a href="/media/case-studies" class="btn-back">
        <i class="fas fa-arrow-left"></i> Back to Case Studies
      </a>
    </div>
  </section>
</Layout>

<style>
  .study-container {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .study-bc {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 12px 0;
  }
  .study-bc ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .study-bc li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
  }
  .study-bc a {
    color: var(--primary);
    text-decoration: none;
  }
  .study-bc a:hover {
    text-decoration: underline;
  }
  .study-bc span {
    color: var(--text-light);
  }
  .study-bc i {
    font-size: 0.65rem;
    color: var(--text-light);
  }

  .study-article {
    padding: 60px 0 40px;
    background: var(--surface);
  }

  .study-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .study-category {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(0, 150, 199, 0.1);
    color: var(--primary);
    padding: 4px 16px;
    border-radius: 40px;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 20px;
  }

  .study-title {
    font-family: "Playfair Display", serif;
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 800;
    color: var(--text);
    line-height: 1.2;
    margin-bottom: 16px;
  }

  .study-meta {
    display: flex;
    justify-content: center;
    gap: 24px;
    font-size: 0.85rem;
    color: var(--text-light);
    margin-bottom: 24px;
  }

  .study-meta i {
    margin-right: 4px;
  }

  .study-hero-image {
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 24px;
  }

  .study-hero-image img {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
  }

  .study-description {
    font-size: 1.1rem;
    color: var(--text-light);
    line-height: 1.7;
    max-width: 680px;
    margin: 0 auto;
  }

  .study-content {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--text);
  }

  .study-content h2 {
    font-family: "Playfair Display", serif;
    font-size: 1.6rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .study-content h3 {
    font-family: "Playfair Display", serif;
    font-size: 1.3rem;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .study-content h4 {
    font-family: "Playfair Display", serif;
    font-size: 1.1rem;
    margin-top: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .study-content p {
    margin-bottom: 1.25rem;
  }

  .study-content img {
    max-width: 100%;
    border-radius: 12px;
    margin: 1.5rem 0;
  }

  .study-content blockquote {
    border-left: 4px solid var(--primary);
    padding-left: 1.5rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--text-light);
  }

  .study-content ul, .study-content ol {
    margin: 1rem 0 1.5rem 1.5rem;
  }

  .study-content li {
    margin-bottom: 0.5rem;
  }

  .study-back {
    padding: 40px 0 80px;
    background: var(--background);
  }

  .btn-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--primary);
    font-weight: 600;
    text-decoration: none;
    transition: gap 0.2s;
  }

  .btn-back:hover {
    gap: 12px;
  }

  /* Case study inline styles (from markdown) */
  .study-content .case-study-intro {
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--text);
    padding: 1.5rem 0;
    border-bottom: 2px solid var(--border-light);
    margin-bottom: 2rem;
  }

  .study-content .case-study-intro p {
    margin: 0;
  }

  .study-content .case-study-image {
    margin: 2.5rem 0;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
  }

  .study-content .case-study-image img {
    width: 100%;
    max-height: 450px;
    object-fit: cover;
    display: block;
  }

  .study-content .case-study-image .image-caption {
    padding: 0.75rem 1.5rem;
    background: var(--background);
    font-size: 0.85rem;
    color: var(--text-light);
    text-align: center;
    margin: 0;
    font-style: italic;
  }

  .study-content .case-study-highlight {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    background: linear-gradient(135deg, rgba(0, 150, 199, 0.06) 0%, rgba(46, 139, 87, 0.04) 100%);
    border-left: 4px solid var(--primary);
    padding: 1.25rem 1.75rem;
    border-radius: 8px;
    margin: 1.75rem 0;
  }

  .study-content .case-study-highlight i {
    font-size: 1.5rem;
    color: var(--primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .study-content .case-study-highlight div {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-light);
  }

  .study-content .case-study-highlight strong {
    color: var(--text);
  }

  .study-content .case-study-quote {
    background: var(--background);
    border-radius: 12px;
    padding: 2rem 2rem 1.5rem;
    margin: 2rem 0;
    position: relative;
    border: 1px solid var(--border-light);
  }

  .study-content .case-study-quote i.fa-quote-left {
    font-size: 2.5rem;
    color: var(--primary-light);
    opacity: 0.3;
    margin-bottom: 0.5rem;
    display: block;
  }

  .study-content .case-study-quote blockquote {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text);
    font-style: italic;
    margin: 0 0 0.75rem 0;
    padding: 0;
    border: none;
  }

  .study-content .case-study-quote cite {
    font-size: 0.9rem;
    color: var(--text-light);
    font-style: normal;
    font-weight: 600;
    display: block;
  }

  .study-content .case-study-testimonial {
    background: linear-gradient(135deg, rgba(0, 150, 199, 0.06) 0%, rgba(46, 139, 87, 0.04) 100%);
    border-radius: 12px;
    padding: 2rem 2.5rem;
    margin: 2rem 0;
    text-align: center;
    border: 1px solid var(--border-light);
  }

  .study-content .case-study-testimonial i.fa-quote-right {
    font-size: 2.5rem;
    color: var(--primary-light);
    opacity: 0.3;
    margin-bottom: 0.5rem;
    display: block;
  }

  .study-content .case-study-testimonial blockquote {
    font-size: 1.2rem;
    line-height: 1.7;
    color: var(--text);
    font-style: italic;
    margin: 0 0 0.75rem 0;
    padding: 0;
    border: none;
  }

  .study-content .case-study-testimonial cite {
    font-size: 0.9rem;
    color: var(--text-light);
    font-style: normal;
    font-weight: 600;
  }

  .study-content .achievement-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .study-content .achievement-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 0.75rem 1rem;
    background: rgba(46, 139, 87, 0.04);
    border-radius: 8px;
    border: 1px solid rgba(46, 139, 87, 0.1);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-light);
  }

  .study-content .achievement-list li i {
    color: var(--secondary);
    flex-shrink: 0;
    margin-top: 2px;
    font-size: 0.9rem;
  }

  .study-content .achievement-list li strong {
    color: var(--text);
  }

  .study-content .case-study-conclusion {
    background: linear-gradient(135deg, var(--secondary) 0%, var(--secondary-dark) 100%);
    border-radius: 12px;
    padding: 2rem 2.5rem;
    margin: 2rem 0 1.5rem;
    text-align: center;
    color: white;
  }

  .study-content .case-study-conclusion p {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.7;
    font-family: "Playfair Display", serif;
    font-weight: 700;
  }

  .study-content .case-study-cta {
    background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary) 100%);
    border-radius: 12px;
    padding: 2rem 2.5rem;
    margin: 2.5rem 0 1rem;
    text-align: center;
    color: white;
  }

  .study-content .case-study-cta p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.9);
  }

  .study-content .case-study-cta a {
    color: var(--primary-light);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .study-content .case-study-cta a:hover {
    color: white;
  }

  @media (max-width: 768px) {
    .study-content .achievement-list {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .study-content .case-study-intro {
      font-size: 1rem;
    }

    .study-content .case-study-highlight {
      flex-direction: column;
      align-items: flex-start;
      padding: 1rem 1.25rem;
    }

    .study-content .case-study-quote {
      padding: 1.5rem;
    }

    .study-content .case-study-quote blockquote {
      font-size: 1rem;
    }

    .study-content .case-study-testimonial {
      padding: 1.5rem;
    }

    .study-content .case-study-testimonial blockquote {
      font-size: 1rem;
    }

    .study-content .case-study-conclusion {
      padding: 1.5rem;
    }

    .study-content .case-study-conclusion p {
      font-size: 1rem;
    }

    .study-content .case-study-cta {
      padding: 1.5rem 1.25rem;
    }

    .study-content .case-study-image img {
      max-height: 280px;
    }

    .study-content .case-study-image .image-caption {
      font-size: 0.75rem;
      padding: 0.5rem 1rem;
    }

    .study-meta {
      flex-direction: column;
      align-items: center;
      gap: 8px;
    }

    .study-title {
      font-size: 1.8rem;
    }

    .study-content {
      font-size: 0.95rem;
    }
  }

  @media (max-width: 480px) {
    .study-content .case-study-image img {
      max-height: 220px;
    }

    .study-content .case-study-highlight div {
      font-size: 0.9rem;
    }

    .study-content .achievement-list li {
      font-size: 0.85rem;
      padding: 0.6rem 0.8rem;
    }
  }
</style>