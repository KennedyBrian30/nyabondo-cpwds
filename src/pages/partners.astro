---
// src/pages/partners.astro
import Layout from "../layouts/Layout.astro";

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Partners", href: "/partners" },
];

// Full partners list (from home page)
const partners = [
  {
    name: "Christian Blind Mission",
    logo: "/images/partners/cbm-global.webp",
    url: "https://www.cbm.org",
    description:
      "Global disability and development organization supporting inclusive community-based rehabilitation programmes.",
  },
  {
    name: "Cheshire Disability Services Kenya",
    logo: "/images/partners/cheshire-disability-services-kenya.webp",
    url: "https://www.cheshiredisabilityservices.org",
    description:
      "Leading Kenyan NGO empowering persons with disabilities through rehabilitation and advocacy.",
  },
  {
    name: "Ministry of Health",
    logo: "/images/partners/ministry-of-health-kenya.webp",
    url: "https://www.health.or.ke",
    description:
      "Government partner ensuring healthcare policies and SHA accreditation for our services.",
  },
  {
    name: "National Fund for the Disabled Kenya",
    logo: "/images/partners/national-fund-disabled-kenya.webp",
    url: "https://www.nfdk.go.ke",
    description:
      "Provides financial support and grants for disability programmes across Kenya.",
  },
  {
    name: "National Council for Persons with Disabilities",
    logo: "/images/partners/national-council-persons-disabilities.webp",
    url: "https://www.ncpwd.go.ke",
    description:
      "Regulatory body overseeing disability rights, registration, and accessibility standards.",
  },
  {
    name: "Kenya Conference of Catholic Bishops",
    logo: "/images/partners/kenya-conference-catholic-bishops.webp",
    url: "https://kccb.or.ke",
    description:
      "Coordinates Catholic Church efforts in health, education, and social services nationally.",
  },
  {
    name: "Archdiocese of Kisumu",
    logo: "/images/partners/archdiocese-of-kisumu.webp",
    url: "https://www.cirde.catholicchurch.or.ke/catholic-archdiocese-of-kisumu/",
    description:
      "Our ecclesiastical authority, providing pastoral and administrative oversight.",
  },
  {
    name: "Association of Sisterhoods of Kenya",
    logo: "/images/partners/association-of-sisterhoods-kenya.webp",
    url: "https://www.acweca.org/kenya-aosk/",
    description:
      "Umbrella body for Catholic religious sisters, supporting Nyabondo's mission.",
  },
  {
    name: "Motivation Charitable Trust",
    logo: "/images/partners/motivation-charitable-trust.webp",
    url: "https://www.motivation.org.uk",
    description:
      "UK-based organization providing expertise in wheelchair provision and training.",
  },
  {
    name: "Stichting Bondo Kids",
    logo: "/images/partners/stichting-bondo-kids.webp",
    url: "#",
    description:
      "Dutch foundation supporting education and healthcare for children with disabilities.",
  },
];

// Categories for grouping (optional)
const partnerCategories = [
  {
    name: "International Development Partners",
    partners: partners.slice(0, 2).concat(partners.slice(8, 10)),
  },
  { name: "Government & Regulatory Bodies", partners: partners.slice(2, 5) },
  { name: "Faith-Based & Ecclesiastical", partners: partners.slice(5, 8) },
];
---

<Layout title="Partners | Nyabondo Centre for Persons with Disabilities">
  <!-- BREADCRUMB -->
  <nav class="partners-bc" aria-label="Breadcrumb">
    <div class="partners-container">
      <ol>
        {
          breadcrumbs.map((c, i) => (
            <li>
              {i < breadcrumbs.length - 1 ? (
                <a href={c.href}>{c.label}</a>
              ) : (
                <span aria-current="page">{c.label}</span>
              )}
              {i < breadcrumbs.length - 1 && (
                <i class="fas fa-chevron-right" aria-hidden="true" />
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </nav>

  <!-- HERO -->
  <section class="partners-hero">
    <div class="partners-container">
      <div class="partners-hero-content">
        <span class="partners-eyebrow">Our Supporters</span>
        <h1>Trusted Partners</h1>
        <p>
          Nyabondo Centre is grateful to work alongside dedicated organizations,
          government bodies, and faith institutions who share our vision of a
          world where every person with a disability thrives.
        </p>
      </div>
    </div>
    <div class="partners-hero-wave" aria-hidden="true">
      <svg viewBox="0 0 1440 40" preserveAspectRatio="none">
        <path
          d="M0,40 C240,20 480,0 720,20 C960,40 1200,20 1440,40 L1440,40 L0,40 Z"
          fill="#f4fcff"></path>
      </svg>
    </div>
  </section>

  <!-- PARTNERS GRID (all, with descriptions) -->
  <section class="partners-grid-section">
    <div class="partners-container">
      <div class="partners-intro">
        <h2>Walking Together for Lasting Change</h2>
        <p>
          Our partners provide funding, technical expertise, advocacy, and moral
          support. Together we reach more persons with disabilities across
          Kenya.
        </p>
      </div>
      <div class="partners-grid">
        {
          partners.map((partner, i) => (
            <a
              href={partner.url}
              target="_blank"
              rel="noopener noreferrer"
              class="partner-card-full"
              style={`--delay: ${i * 50}ms`}
              aria-label={`Visit ${partner.name} (opens in new tab)`}
            >
              <div class="partner-card-full-logo">
                <picture>
                  <source srcset={partner.logo} type="image/webp" />
                  <img
                    src={partner.logo}
                    alt={`${partner.name} logo`}
                    loading="lazy"
                    width="160"
                    height="80"
                    onerror="this.closest('picture').style.display='none';this.closest('.partner-card-full-logo').querySelector('.partner-logo-fallback').style.display='flex';"
                  />
                </picture>
                <div class="partner-logo-fallback" style="display:none;">
                  <i class="fas fa-handshake" />
                </div>
              </div>
              <div class="partner-card-full-info">
                <h3>{partner.name}</h3>
                <p>{partner.description}</p>
                <span class="partner-link">
                  Visit website <i class="fas fa-external-link-alt" />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- WHY PARTNERS MATTER (optional) -->
  <section class="partners-impact">
    <div class="partners-container">
      <div class="partners-impact-grid">
        <div class="partners-impact-text">
          <span class="partners-eyebrow">Why Partners Matter</span>
          <h2>Every Partnership Multiplies Hope</h2>
          <p>
            Without our partners, thousands of surgeries, therapy sessions, and
            assistive devices would not have been possible. Partners enable us
            to:
          </p>
          <ul>
            <li>
              <i class="fas fa-check-circle"></i> Subsidise surgery costs for vulnerable
              families
            </li>
            <li>
              <i class="fas fa-check-circle"></i> Train healthcare workers in disability
              inclusion
            </li>
            <li>
              <i class="fas fa-check-circle"></i> Run community outreaches in remote
              areas
            </li>
            <li>
              <i class="fas fa-check-circle"></i> Maintain our orthopaedic workshop
              and equipment
            </li>
          </ul>
          <a
            href="/get-involved/partner"
            class="partners-btn partners-btn-primary"
          >
            Become a Partner <i class="fas fa-arrow-right"></i>
          </a>
        </div>
        <div class="partners-impact-image">
          <picture>
            <source
              srcset="/images/about/about-nyabondo-centre.webp"
              type="image/webp"
            />
            <img
              src="/images/about/about-nyabondo-centre.webp"
              alt="Nyabondo team with partners"
              loading="lazy"
            />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA BANNER -->
  <section class="partners-cta">
    <div class="partners-container">
      <div class="partners-cta-card">
        <h2>Ready to Join Hands?</h2>
        <p>
          Your organisation can make a lasting impact. Whether through funding,
          technical support, or advocacy, we welcome new partners who share our
          commitment to disability inclusion.
        </p>
        <div class="partners-cta-buttons">
          <a
            href="/get-involved/partner"
            class="partners-btn partners-btn-white"
          >
            Learn About Partnership <i class="fas fa-arrow-right"></i>
          </a>
          <a href="/contact" class="partners-btn partners-btn-outline">
            Contact Us
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* =============================================
     PARTNERS PAGE STYLES
  ============================================= */
  :root {
    --partners-primary: #0096c7;
    --partners-primary-dark: #006d94;
    --partners-primary-light: #48b8d8;
    --partners-green: #2e8b57;
    --partners-text: #0d2b38;
    --partners-text-light: #2e5a6b;
    --partners-bg: #f4fcff;
    --partners-surface: #ffffff;
    --partners-border: #c7e9f4;
    --partners-shadow: 0 6px 24px rgba(0, 150, 199, 0.1);
    --partners-radius: 14px;
    --partners-ease: cubic-bezier(0.16, 1, 0.3, 1);
  }

  .partners-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Breadcrumb */
  .partners-bc {
    background: var(--partners-surface);
    border-bottom: 1px solid var(--partners-border);
    padding: 12px 0;
  }
  .partners-bc ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .partners-bc li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
  }
  .partners-bc a {
    color: var(--partners-primary);
    text-decoration: none;
  }
  .partners-bc a:hover {
    text-decoration: underline;
  }
  .partners-bc span {
    color: var(--partners-text-light);
  }
  .partners-bc i {
    font-size: 0.65rem;
    color: var(--partners-text-light);
  }

  /* Hero */
  .partners-hero {
    background: linear-gradient(
      135deg,
      var(--partners-primary-dark) 0%,
      var(--partners-primary) 100%
    );
    padding: 80px 0 96px;
    position: relative;
    color: white;
  }
  .partners-hero-content {
    max-width: 720px;
    text-align: center;
    margin: 0 auto;
  }
  .partners-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--partners-primary-light);
    margin-bottom: 12px;
  }
  .partners-eyebrow::before,
  .partners-eyebrow::after {
    content: "";
    display: block;
    width: 24px;
    height: 1.5px;
    background: currentColor;
    opacity: 0.6;
  }
  .partners-hero h1 {
    font-family: "Playfair Display", serif;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 16px;
  }
  .partners-hero p {
    font-size: 1.05rem;
    opacity: 0.9;
    line-height: 1.6;
  }
  .partners-hero-wave {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    line-height: 0;
  }
  .partners-hero-wave svg {
    width: 100%;
    height: 40px;
    display: block;
  }

  /* Partners Grid */
  .partners-grid-section {
    padding: 96px 0;
    background: var(--partners-bg);
  }
  .partners-intro {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 56px;
  }
  .partners-intro h2 {
    font-family: "Playfair Display", serif;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 700;
    color: var(--partners-text);
    margin-bottom: 12px;
  }
  .partners-intro p {
    font-size: 1rem;
    color: var(--partners-text-light);
  }
  .partners-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }
  .partner-card-full {
    display: flex;
    background: var(--partners-surface);
    border-radius: var(--partners-radius);
    padding: 24px;
    text-decoration: none;
    transition:
      transform 0.3s var(--partners-ease),
      box-shadow 0.3s;
    border: 1px solid var(--partners-border);
    gap: 20px;
  }
  .partner-card-full:hover {
    transform: translateY(-6px);
    box-shadow: var(--partners-shadow);
    border-color: var(--partners-primary-light);
  }
  .partner-card-full-logo {
    flex-shrink: 0;
    width: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .partner-card-full-logo img {
    max-width: 100%;
    max-height: 80px;
    object-fit: contain;
    filter: grayscale(0.1) opacity(0.9);
    transition: all 0.3s;
  }
  .partner-card-full:hover .partner-card-full-logo img {
    filter: grayscale(0) opacity(1);
  }
  .partner-logo-fallback {
    width: 80px;
    height: 80px;
    background: rgba(0, 150, 199, 0.1);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    color: var(--partners-primary);
  }
  .partner-card-full-info {
    flex: 1;
  }
  .partner-card-full-info h3 {
    font-family: "Playfair Display", serif;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--partners-text);
    margin-bottom: 8px;
  }
  .partner-card-full-info p {
    font-size: 0.88rem;
    color: var(--partners-text-light);
    line-height: 1.6;
    margin-bottom: 10px;
  }
  .partner-link {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--partners-primary);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .partner-card-full:hover .partner-link {
    gap: 10px;
  }

  /* Impact Section */
  .partners-impact {
    padding: 96px 0;
    background: var(--partners-surface);
  }
  .partners-impact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .partners-impact-text .partners-eyebrow {
    margin-bottom: 12px;
  }
  .partners-impact-text h2 {
    font-family: "Playfair Display", serif;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 700;
    color: var(--partners-text);
    margin-bottom: 16px;
  }
  .partners-impact-text p {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--partners-text-light);
    margin-bottom: 24px;
  }
  .partners-impact-text ul {
    list-style: none;
    margin: 0 0 32px;
    padding: 0;
  }
  .partners-impact-text li {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
    font-size: 0.94rem;
    color: var(--partners-text-light);
  }
  .partners-impact-text li i {
    color: var(--partners-green);
    font-size: 1rem;
  }
  .partners-impact-image img {
    width: 100%;
    border-radius: var(--partners-radius);
    box-shadow: var(--partners-shadow);
  }

  /* Buttons */
  .partners-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.2s,
      background 0.2s;
    border: 2px solid transparent;
  }
  .partners-btn-primary {
    background: var(--partners-primary);
    color: white;
  }
  .partners-btn-primary:hover {
    background: var(--partners-primary-dark);
    transform: translateY(-2px);
  }
  .partners-btn-white {
    background: white;
    color: var(--partners-primary);
    border-color: white;
  }
  .partners-btn-white:hover {
    background: #e0f5fc;
    transform: translateY(-2px);
  }
  .partners-btn-outline {
    background: transparent;
    color: white;
    border-color: white;
  }
  .partners-btn-outline:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: translateY(-2px);
  }

  /* CTA Card */
  .partners-cta {
    padding: 80px 0;
    background: var(--partners-bg);
  }
  .partners-cta-card {
    background: linear-gradient(
      135deg,
      var(--partners-primary-dark) 0%,
      var(--partners-primary) 100%
    );
    border-radius: var(--partners-radius);
    padding: 56px 48px;
    text-align: center;
    color: white;
  }
  .partners-cta-card h2 {
    font-family: "Playfair Display", serif;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    margin-bottom: 16px;
  }
  .partners-cta-card p {
    font-size: 1rem;
    opacity: 0.9;
    max-width: 560px;
    margin: 0 auto 32px;
  }
  .partners-cta-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .partners-grid {
      gap: 24px;
    }
    .partner-card-full {
      flex-direction: column;
      text-align: center;
      align-items: center;
      padding: 24px 20px;
    }
    .partner-card-full-logo {
      width: 100%;
      justify-content: center;
      margin-bottom: 12px;
    }
    .partners-impact-grid {
      gap: 48px;
    }
  }

  @media (max-width: 768px) {
    .partners-grid {
      grid-template-columns: 1fr;
    }
    .partners-impact-grid {
      grid-template-columns: 1fr;
    }
    .partners-impact-image {
      order: -1;
    }
    .partners-cta-card {
      padding: 40px 24px;
    }
  }

  @media (max-width: 480px) {
    .partner-card-full {
      padding: 20px 16px;
    }
    .partner-card-full-info h3 {
      font-size: 1rem;
    }
    .partner-card-full-info p {
      font-size: 0.8rem;
    }
  }
</style>
