---
// src/pages/services.astro
import Layout from "../layouts/Layout.astro";

const servicesList = [
  {
    icon: "fas fa-hospital",
    title: "In-patient and Out-patient Services",
    description:
      "We provide both in-patient and out-patient services to persons with disabilities. Our SHA-accredited facility also offers general medical services to all community members, with or without disability.",
    href: "/services/outpatient-inpatient",
    img: "/images/services/service-inpatient-care.webp",
    badge: "SHA Accredited",
    features: [
      "Clinical consultations and reviews",
      "Post-operative care and follow-up",
      "Residential care for rehabilitation",
      "General medical services open to all",
      "SHA accredited facility",
    ],
  },
  {
    icon: "fas fa-stethoscope",
    title: "Corrective Surgeries",
    description:
      "We conduct corrective surgeries for both orthopedic and reconstructive cases such as club feet, cleft lip/palate, post burn contractures, congenital impairments, and fractures.",
    href: "/services/surgeries",
    img: "/images/services/services-corrective-surgery-1.webp",
    features: [
      "Orthopedic and reconstructive procedures",
      "Club foot correction",
      "Cleft lip and palate repair",
      "Post-burn contracture release",
      "Congenital impairments and fractures",
    ],
  },
  {
    icon: "fas fa-hand-holding-heart",
    title: "Therapy Services",
    description:
      "We provide both physiotherapy and occupational therapy services to both children and adults, focusing on restoring movement, strength, and functional independence.",
    href: "/services/therapy",
    img: "/images/services/service-therapy.webp",
    features: [
      "Physiotherapy for mobility restoration",
      "Occupational therapy for daily living skills",
      "Speech therapy where available",
      "Individualized treatment plans",
    ],
  },
  {
    icon: "fas fa-wheelchair",
    title: "Assistive Devices",
    description:
      "Through our Orthopedic services department, we fabricate assistive devices including prosthetics and orthotics, walking aids, and mobility aids tailored to individual needs.",
    href: "/services/assistive-devices",
    img: "/images/services/service-assistive-devices-1.webp",
    features: [
      "Custom-made prosthetics and orthotics",
      "Walking and mobility aids",
      "Appropriate technology solutions",
      "Affordable and durable devices",
    ],
  },
  {
    icon: "fas fa-graduation-cap",
    title: "Vocational Training",
    description:
      "We provide livelihood training skills to youths with disabilities to equip them with skills to enable them become independent and self-sufficient.",
    href: "/services/vocational-training",
    img: "/images/services/vocational-training.webp",
    features: [
      "Dress making and tailoring",
      "Weaving and basket making",
      "Hair dressing and beauty",
      "Shoe making and repair",
      "Computer and digital skills",
    ],
  },
  
];

const stats = [
  { num: "60+", label: "Years of Service" },
  { num: "50,000+", label: "Patients Served" },
  { num: "12,000+", label: "Surgeries Performed" },
  { num: "8,500+", label: "Assistive Devices" },
  { num: "5,000+", label: "Vocational Graduates" },
  { num: "300+", label: "Community Outreaches" },
];
---

<Layout title="Our Services | Nyabondo Centre for Persons with Disabilities">
  <!-- Hero Section -->
  <section class="services-hero">
    <div class="container">
      <div class="services-hero-content">
        <span class="section-eyebrow section-eyebrow--light">What We Offer</span
        >
        <h1 class="services-hero-title">
          Comprehensive <span class="hero-accent"
            >Medical and Rehabilitation</span
          > Services
        </h1>
        <p class="services-hero-subtitle">
          A holistic continuum of care for persons with disabilities and for all
          community members. Our SHA-accredited facility provides specialist
          rehabilitation alongside general medical services, open to everyone
          regardless of disability status.
        </p>
        <div class="hero-tags">
          <span class="hero-tag"
            ><i class="fas fa-shield-halved"></i> SHA Accredited</span
          >
          <span class="hero-tag"
            ><i class="fas fa-wheelchair"></i> Disability Rehabilitation</span
          >
          <span class="hero-tag"
            ><i class="fas fa-stethoscope"></i> General Medical Services</span
          >
          <span class="hero-tag"><i class="fas fa-users"></i> Open to All</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="services-stats">
    <div class="container">
      <div class="stats-grid">
        {
          stats.map((stat, i) => (
            <div class="stat-item reveal-up" style={`--delay: ${i * 50}ms`}>
              <div class="stat-icon" aria-hidden="true">
                <i class="fas fa-chart-simple" />
              </div>
              <div class="stat-num">{stat.num}</div>
              <div class="stat-label">{stat.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- All Services Section -->
  <section class="all-services" id="services-list">
    <div class="container">
      <div class="section-header reveal-up">
        <span class="section-eyebrow">Our Services</span>
        <h2 class="section-title">Every Service, Every Person, Every Need</h2>
        <p class="section-subtitle">
          From community outreach to corrective surgery, therapy to vocational
          training — we provide a complete spectrum of care designed to restore
          dignity and independence.
        </p>
      </div>

      <div class="services-full-grid">
        {
          servicesList.map((service, i) => (
            <div
              class="service-full-card reveal-up"
              style={`--delay: ${i * 80}ms`}
            >
              <div class="service-full-image">
                <picture>
                  <source srcset={service.img} type="image/webp" />
                  <img
                    src={service.img}
                    alt={service.title}
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
                {service.badge && (
                  <span class="service-full-badge">{service.badge}</span>
                )}
              </div>
              <div class="service-full-content">
                <div class="service-full-icon" aria-hidden="true">
                  <i class={service.icon} />
                </div>
                <h3 class="service-full-title">{service.title}</h3>
                <p class="service-full-desc">{service.description}</p>
                <ul class="service-full-features">
                  {service.features.map((feature) => (
                    <li>
                      <i class="fas fa-check-circle" /> {feature}
                    </li>
                  ))}
                </ul>
                <a href={service.href} class="service-full-link">
                  Learn More <i class="fas fa-arrow-right" aria-hidden="true" />
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- General Medical Services Note -->
  <section class="general-medical-note">
    <div class="container">
      <div class="medical-note-card">
        <div class="medical-note-icon">
          <i class="fas fa-house-medical"></i>
        </div>
        <div class="medical-note-content">
          <h3>General Medical Services Available to Everyone</h3>
          <p>
            While Nyabondo specialises in physical rehabilitation for persons
            with disabilities, our SHA-accredited outpatient and inpatient
            facility is open to all community members for general medical care.
            No disability required. No referral needed for routine
            consultations. We welcome everyone seeking quality, compassionate
            healthcare.
          </p>
        </div>
        <a href="/services/outpatient-inpatient" class="medical-note-cta">
          Book a Visit <i class="fas fa-arrow-right"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- Approach Section -->
  <section class="approach">
    <div class="approach-bg" aria-hidden="true"></div>
    <div class="container">
      <div class="approach-grid">
        <div class="approach-content reveal-left">
          <span class="section-eyebrow">Our Approach</span>
          <h2 class="section-title">A Holistic, Person-Centred Approach</h2>
          <p class="approach-lead">
            We believe that true rehabilitation addresses the whole person —
            body, mind, and spirit.
          </p>
          <p class="approach-body">
            At Nyabondo Centre, every service is delivered with compassion,
            dignity, and respect. Our multidisciplinary team works together to
            create individualized care plans that address not just the clinical
            needs of each person, but also their social, emotional, and economic
            circumstances.
          </p>
          <div class="approach-values">
            <div class="approach-value">
              <i class="fas fa-hand-sparkles"></i>
              <span>Person-Centred Care</span>
            </div>
            <div class="approach-value">
              <i class="fas fa-people-arrows"></i>
              <span>Multidisciplinary Team</span>
            </div>
            <div class="approach-value">
              <i class="fas fa-chart-line"></i>
              <span>Continuously Improving</span>
            </div>
            <div class="approach-value">
              <i class="fas fa-hand-holding-heart"></i>
              <span>Compassionate Service</span>
            </div>
          </div>
        </div>
        <div class="approach-image reveal-right">
          <div class="approach-img-wrap">
            <picture>
              <source
                srcset="/images/about/approach-image.webp"
                type="image/webp"
              />
              <img
                src="/images/about/approach-image.webp"
                alt="A therapist working closely with a patient at Nyabondo Centre"
                loading="lazy"
                decoding="async"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="cta-banner-services">
    <div class="container cta-inner-services">
      <div class="cta-text-services">
        <h2 class="cta-title-services">Need Our Services?</h2>
        <p class="cta-subtitle-services">
          Whether you're seeking rehabilitation for yourself or a loved one, or
          need general medical care, we are here to help.
        </p>
      </div>
      <div class="cta-actions-services">
        <a href="/contact" class="btn btn-green">
          <i class="fas fa-phone" aria-hidden="true"></i> Contact Us
        </a>
        <a href="/get-involved/donate" class="btn btn-white-outline">
          Support Our Work <i class="fas fa-heart" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ═══════════════════════════════════════
     SERVICES PAGE STYLES
  ═══════════════════════════════════════ */

  /* Hero Section */
  .services-hero {
    position: relative;
    background: linear-gradient(
      135deg,
      var(--primary-dark) 0%,
      var(--primary) 55%,
      var(--primary-light) 100%
    );
    padding: 80px 0 80px;
    overflow: hidden;
  }

  .services-hero::before {
    content: "";
    position: absolute;
    top: -100px;
    right: -100px;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(255, 255, 255, 0.08) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .services-hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .services-hero-title {
    font-family: "Playfair Display", serif;
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.15;
    margin: 16px 0 20px;
  }

  .services-hero-subtitle {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.75;
    margin-bottom: 28px;
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }

  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
  }

  .hero-tag i {
    font-size: 0.7rem;
    color: var(--primary-light);
  }

  /* Stats Section */
  .services-stats {
    padding: 60px 0;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 20px;
    text-align: center;
  }

  .stat-item {
    padding: 16px;
    background: var(--background);
    border-radius: var(--radius-md);
    transition: all var(--transition-base) var(--ease-out-expo);
  }

  .stat-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .stat-icon {
    font-size: 1.2rem;
    color: var(--primary);
    margin-bottom: 8px;
  }

  .stat-num {
    font-family: "Playfair Display", serif;
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text);
    line-height: 1.2;
  }

  .stat-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  /* All Services Section */
  .all-services {
    padding: 80px 0;
    background: var(--background);
  }

  .services-full-grid {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .service-full-card {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 32px;
    background: var(--surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-base) var(--ease-out-expo);
    border: 1px solid var(--border-light);
  }

  .service-full-card:nth-child(even) {
    direction: rtl;
  }

  .service-full-card:nth-child(even) .service-full-content {
    direction: ltr;
  }

  .service-full-card:hover {
    box-shadow: var(--shadow-xl);
    transform: translateY(-4px);
    border-color: var(--primary-light);
  }

  .service-full-image {
    position: relative;
    overflow: hidden;
  }

  .service-full-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow) var(--ease-out-expo);
  }

  .service-full-card:hover .service-full-image img {
    transform: scale(1.05);
  }

  .service-full-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    background: var(--secondary);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 100px;
  }

  .service-full-content {
    padding: 32px 32px 32px 0;
  }

  .service-full-card:nth-child(even) .service-full-content {
    padding: 32px 0 32px 32px;
  }

  .service-full-icon {
    width: 56px;
    height: 56px;
    background: rgba(0, 150, 199, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    color: var(--primary);
    margin-bottom: 20px;
  }

  .service-full-title {
    font-family: "Playfair Display", serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 16px;
  }

  .service-full-desc {
    font-size: 0.95rem;
    color: var(--text-light);
    line-height: 1.75;
    margin-bottom: 20px;
  }

  .service-full-features {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-bottom: 24px;
  }

  .service-full-features li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-light);
  }

  .service-full-features li i {
    color: var(--secondary);
    font-size: 0.75rem;
  }

  .service-full-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--primary);
    text-decoration: none;
    transition: gap var(--transition-fast) var(--ease-out-expo);
  }

  .service-full-link:hover {
    gap: 14px;
    color: var(--secondary);
  }

  /* General Medical Services Note */
  .general-medical-note {
    padding: 0 0 80px;
    background: var(--background);
  }

  .medical-note-card {
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 36px 40px;
    background: linear-gradient(120deg, #fff 0%, #f4fcff 100%);
    border: 1px solid var(--border);
    border-left: 6px solid var(--secondary);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .medical-note-icon {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    background: rgba(46, 139, 87, 0.12);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    color: var(--secondary);
  }

  .medical-note-content {
    flex: 1;
  }

  .medical-note-content h3 {
    font-family: "Playfair Display", serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 8px;
  }

  .medical-note-content p {
    font-size: 0.95rem;
    color: var(--text-light);
    line-height: 1.7;
    margin: 0;
  }

  .medical-note-cta {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    background: var(--secondary);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast) var(--ease-out-expo);
  }

  .medical-note-cta:hover {
    background: var(--secondary-dark);
    gap: 12px;
    transform: translateY(-2px);
  }

  /* Approach Section */
  .approach {
    position: relative;
    padding: 80px 0;
    background: var(--surface);
    overflow: hidden;
  }

  .approach-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 0% 50%,
      rgba(0, 150, 199, 0.03) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .approach-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .approach-lead {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--primary);
    line-height: 1.6;
    margin: 16px 0 20px;
  }

  .approach-body {
    font-size: 0.95rem;
    color: var(--text-light);
    line-height: 1.8;
    margin-bottom: 32px;
  }

  .approach-values {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .approach-value {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 20px;
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--primary);
    transition: all var(--transition-fast) var(--ease-out-expo);
  }

  .approach-value:hover {
    background: var(--primary);
    color: #fff;
    border-color: var(--primary);
    transform: translateY(-2px);
  }

  .approach-value i {
    font-size: 0.9rem;
  }

  .approach-img-wrap {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
  }

  .approach-img-wrap img {
    width: 100%;
    height: 380px;
    object-fit: cover;
    display: block;
  }

  /* CTA Banner */
  .cta-banner-services {
    padding: 60px 0;
    background: linear-gradient(
      110deg,
      var(--primary-dark) 0%,
      var(--primary-mid) 50%,
      var(--primary) 100%
    );
  }

  .cta-inner-services {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
    flex-wrap: wrap;
  }

  .cta-text-services {
    max-width: 560px;
  }

  .cta-title-services {
    font-family: "Playfair Display", serif;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 700;
    color: #fff;
    margin-bottom: 12px;
  }

  .cta-subtitle-services {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.7;
  }

  .cta-actions-services {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    align-items: center;
    flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .stats-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .service-full-card {
      grid-template-columns: 1fr;
    }
    .service-full-card:nth-child(even) {
      direction: ltr;
    }
    .service-full-content {
      padding: 0 28px 28px 28px !important;
    }
    .service-full-image {
      height: 260px;
    }
    .service-full-features {
      grid-template-columns: 1fr;
    }
    .medical-note-card {
      flex-direction: column;
      text-align: center;
    }
    .approach-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .services-hero {
      padding: 60px 0;
    }
    .service-full-title {
      font-size: 1.3rem;
    }
    .medical-note-card {
      padding: 28px 24px;
    }
    .cta-inner-services {
      flex-direction: column;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .service-full-title {
      font-size: 1.2rem;
    }
    .hero-tags {
      gap: 8px;
    }
    .hero-tag {
      font-size: 0.7rem;
      padding: 4px 12px;
    }
  }
</style>
